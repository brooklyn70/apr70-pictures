---
import '../../styles/global.css'
import '../../styles/dispatch.css'

import { fetchCurrentDispatchIssue, fetchSiteSettings, resolveMediaUrl } from '../../lib/payload'
import type { Media } from 'payload-types'

import FilmstripRail from '../../components/dispatch/FilmstripRail.astro'
import Nav from '../../components/dispatch/Nav.astro'
import Masthead from '../../components/dispatch/Masthead.astro'
import Cover from '../../components/dispatch/Cover.astro'
import SectionRail from '../../components/dispatch/SectionRail.astro'
import Contents from '../../components/dispatch/Contents.astro'
import Editorial from '../../components/dispatch/Editorial.astro'
import Feature from '../../components/dispatch/Feature.astro'
import Dispatches from '../../components/dispatch/Dispatches.astro'
import Trades from '../../components/dispatch/Trades.astro'
import Classifieds from '../../components/dispatch/Classifieds.astro'
import Archive from '../../components/dispatch/Archive.astro'
import Colophon from '../../components/dispatch/Colophon.astro'
import CornerAccent from '../../components/dispatch/CornerAccent.astro'
import DispatchReader from '../../components/islands/DispatchReader'

const [{ issue, error }, { settings }] = await Promise.all([
  fetchCurrentDispatchIssue(),
  fetchSiteSettings(),
])

const siteName = settings?.brandLabel ?? 'APR 70 Pictures'
const pageTitle = `DISPATCH — ${siteName}`
const description = settings?.tagline ?? ''

const faviconMedia = settings?.favicon
const faviconSrc =
  resolveMediaUrl(
    typeof faviconMedia === 'object' && faviconMedia ? (faviconMedia as Media) : undefined,
  ) ?? '/brand/dispatch-favicon.svg'

const accent = '#E85D04'
const reel = issue?.indicia?.reel ?? 'REEL 086'
const vol = issue?.indicia?.volume ?? 'VOL. 01'
const num = issue?.indicia?.number ?? 'NO. 01'
const keycode = `APR 70 PICTURES // DISPATCH ${vol} ${num} // ${reel}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={faviconSrc} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta name="theme-color" content="#000000" />
    <style is:global>
      :root {
        --accent: {accent};
        --feature-cols: 3;
        --ghost-opacity: 0.05;
      }
      body { cursor: auto; }
    </style>
  </head>
  <body class="theme-cinema">
    {error && !issue && (
      <div style="padding: 4rem 1.5rem; font-family: var(--font-mono); color: #c8c8c8; background: #000; min-height: 100vh;">
        <h1 style="font-family: var(--font-display); font-size: 2rem; text-transform: uppercase;">DISPATCH — Setup pending</h1>
        <p style="margin-top: 1rem; max-width: 60ch;">
          No current DISPATCH issue has been published yet. Seed the inaugural
          issue via the migration apply pipeline or publish one in
          <code>/admin/collections/dispatch-issues</code>.
        </p>
        <p style="margin-top: 1rem; opacity: 0.7;">Fetch error: {error}</p>
      </div>
    )}

    {issue && (
      <>
        <FilmstripRail accentColor={accent} keycode={keycode} />
        <Nav settings={settings} />
        <div class="page-shell">
          <Masthead indicia={issue.indicia} title="DIS·PATCH" />
          <Cover cover={issue.cover} indicia={issue.indicia} />

          <SectionRail
            num="§ 01"
            title="Contents"
            meta={`${issue.indicia.season} · ${issue.indicia.volume} · ${issue.indicia.number}`}
          />
          <Contents groups={issue.contents} indicia={issue.indicia} />

          <SectionRail num="§ 02" title="From the Editor" meta="P. 008 — LETTER" />
          <Editorial data={issue.editorial} />

          <SectionRail num="§ 03" title="Cover Story" meta="P. 012 — FEATURE" />
          <Feature data={issue.feature} />

          <SectionRail
            num="§ 04"
            title="Slate Dispatches"
            meta={`PP. 048 — 056 · ${(issue.dispatches ?? []).length} ITEMS`}
          />
          <Dispatches items={issue.dispatches} />

          <SectionRail
            num="§ 05"
            title="The Trades & The Calendar"
            meta="PP. 058 — 066 · INDUSTRY ROUNDUP"
          />
          <Trades trades={issue.trades} calendar={issue.calendar} />

          <SectionRail
            num="§ 06"
            title="Open Calls & Notices"
            meta="PP. 068 — 070 · BACK OF BOOK"
          />
          <Classifieds items={issue.classifieds} />

          <SectionRail num="§ 07" title="Archive — Past Folios" meta="ISSUES 0 — 1" />
          <Archive issues={issue.archive} />

          <Colophon data={issue.colophon} indicia={issue.indicia} />
        </div>
        <CornerAccent />
        <DispatchReader client:idle />
      </>
    )}
  </body>
</html>
