---
/**
 * /troupe — "The APR 70 Troupe Presents" page.
 *
 * SLUG CHOICE: /troupe. Short, brandable, matches how the series is spoken
 * ("the Troupe"). /radio was rejected (describes the medium, not the company;
 * the Troupe outlives any one format) and /presents reads as a verb fragment.
 * Program pages can later nest under it (/troupe/no-1) without a rename.
 *
 * Content comes from the `troupe` Payload global when it exists. Until the
 * 20260705_troupe_page migration + seed run at merge time, the global 404s
 * and this page renders the complete static fallback from lib/troupe.ts
 * through the same BlockRenderer, so both paths exercise identical blocks.
 */
import Layout from '../layouts/Layout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { fetchTroupeGlobal } from '../lib/payload';
import { TROUPE_FALLBACK_BLOCKS, type TroupeLayoutBlock } from '../lib/troupe';

const { troupe } = await fetchTroupeGlobal();
const cmsBlocks = (troupe?.layout ?? []) as TroupeLayoutBlock[];
const blocks: TroupeLayoutBlock[] = cmsBlocks.length > 0 ? cmsBlocks : TROUPE_FALLBACK_BLOCKS;
const usingFallback = cmsBlocks.length === 0;
---

<!-- DRAFT COPY (v01): all text on this page is draft for Marco's edit.
     Synopsis is spoiler-safe per the script's "does not reveal" list.
     Fallback copy lives in web/src/lib/troupe.ts and mirrors the CMS seed
     (cms/scripts/migrate-v2/seed-troupe.ts) — keep the two in sync. -->
<Layout title="Troupe Presents">
  <main data-troupe-source={usingFallback ? 'static-fallback' : 'payload'}>
    <BlockRenderer blocks={blocks} />
  </main>
</Layout>
