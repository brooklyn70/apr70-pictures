---
/**
 * /news — DISPATCH, the zine.
 *
 * v4: DISPATCH is the company's front-of-house voice (the front door at `/`
 * carries its masthead), so this page now renders through Layout.astro and
 * joins the global visitor-selected theme system: pre-paint `data-design`
 * stamp, ThemeControlIsland, global nav + footer. The page's former private
 * chrome (fixed FilmstripRail + Nav) is retired — Layout's rails and
 * MagneticNav replace it. Magazine sections below are unchanged and read the
 * shared token ramp, so all five skins rebind automatically.
 *
 * Indicia are numbered, never dated (Vol/No only) — see Masthead/Contents/
 * Cover/Archive/Colophon components and cms/scripts/apply-v4-content.ts.
 */
import '../../styles/dispatch.css'

import Layout from '../../layouts/Layout.astro'
import { fetchCurrentDispatchIssue } from '../../lib/payload'
import {
  DISPATCH_FALLBACK_ISSUE,
  DISPATCH_FALLBACK_COVER_CREDIT,
} from '../../content/dispatch-fallback'

import Masthead from '../../components/dispatch/Masthead.astro'
import Cover from '../../components/dispatch/Cover.astro'
import SectionRail from '../../components/dispatch/SectionRail.astro'
import Contents from '../../components/dispatch/Contents.astro'
import Editorial from '../../components/dispatch/Editorial.astro'
import Feature from '../../components/dispatch/Feature.astro'
import Dispatches from '../../components/dispatch/Dispatches.astro'
import Trades from '../../components/dispatch/Trades.astro'
import Classifieds from '../../components/dispatch/Classifieds.astro'
import Archive from '../../components/dispatch/Archive.astro'
import Colophon from '../../components/dispatch/Colophon.astro'
import CornerAccent from '../../components/dispatch/CornerAccent.astro'
import DispatchReader from '../../components/islands/DispatchReader'

// DB path stays primary; the static fallback renders the FULL magazine so
// /news is never an empty shell. Numbered, never dated (see dispatch-fallback).
const { issue: dbIssue } = await fetchCurrentDispatchIssue()
const issue = dbIssue ?? DISPATCH_FALLBACK_ISSUE
const coverCredit = dbIssue ? undefined : DISPATCH_FALLBACK_COVER_CREDIT
---

<Layout title="Dispatch">
  <main>
    <div class="page-shell page-shell--flush">
      <Masthead indicia={issue.indicia} title="DIS·PATCH" />
      <Cover cover={issue.cover} indicia={issue.indicia} credit={coverCredit} />

      <SectionRail
        num="§ 01"
        title="Contents"
        meta={`DISPATCH · ${issue.indicia.number}`}
      />
      <Contents groups={issue.contents} indicia={issue.indicia} />

      <SectionRail num="§ 02" title="From the Editor" meta="P. 008 · LETTER" />
      <Editorial data={issue.editorial} />

      <SectionRail num="§ 03" title="Cover Story" meta="P. 012 · FEATURE" />
      <Feature data={issue.feature} />

      <SectionRail
        num="§ 04"
        title="Slate Dispatches"
        meta={`PP. 022 — 030 · ${(issue.dispatches ?? []).length} ON RECORD`}
      />
      <Dispatches items={issue.dispatches} />

      <SectionRail
        num="§ 05"
        title="The Desks & The Programs"
        meta="PP. 032 — 034 · ON THE RECORD"
      />
      <Trades trades={issue.trades} calendar={issue.calendar} />

      <SectionRail
        num="§ 06"
        title="Open Calls & Notices"
        meta="PP. 036 — 038 · BACK OF BOOK"
      />
      <Classifieds items={issue.classifieds} />

      <SectionRail num="§ 07" title="Archive — Numbered Folios" meta="NUMBERED, NEVER DATED" />
      <Archive issues={issue.archive} />

      <Colophon data={issue.colophon} indicia={issue.indicia} />
    </div>
    <CornerAccent />
    <DispatchReader client:idle />
  </main>
</Layout>
