---
/**
 * DivisionCrossDoorsBlock.astro — the strip across to the other two divisions.
 *
 * Two door panels (the divisions this page is NOT), each with the hero lockup at
 * scale, the one-line mandate, and a link across. Reuses the screening-room
 * door reveal hooks ([data-motion="door"] / [data-motion="door-logo"], trigger
 * [data-motion="doors"]); static-visible by SSR default under every other theme.
 */
import type { DivisionCrossDoorsData } from '../../content/v4'

interface Props {
  block: DivisionCrossDoorsData
}

const { block } = Astro.props
---

<section class="division-cross" aria-label="The other divisions">
  <div class="container">
    <div class="division-cross__head">
      <h2 class="division-cross__heading">{block.heading}</h2>
      <span class="division-cross__keycode">{block.keycode}</span>
    </div>

    <div class="division-cross__grid" data-motion="doors">
      {block.doors.map((door) => (
        <a class:list={['division-cross__door', `division-cross__door--${door.tone}`]} href={door.href} data-motion="door">
          <span class="division-cross__logo">
            <img src={door.logo} alt={door.logoAlt} data-motion="door-logo" loading="lazy" />
          </span>
          <div class="division-cross__text">
            <h3 class="division-cross__name">{door.name}</h3>
            <p class="division-cross__line">{door.line}</p>
          </div>
          <span class="division-cross__go" aria-hidden="true">Enter &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .division-cross {
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .division-cross__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    border-top: 1px solid var(--rule-strong);
    padding-top: var(--s-5);
  }
  .division-cross__heading {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: var(--type-h3);
    letter-spacing: -0.01em;
    color: var(--fg-1);
    margin: 0;
  }
  .division-cross__keycode {
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-strip);
    text-transform: uppercase;
    color: var(--fg-5);
  }

  .division-cross__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  @media (min-width: 760px) {
    .division-cross__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .division-cross__door {
    position: relative;
    background: var(--bg-0);
    padding: clamp(1.75rem, 3vw, 2.75rem);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: clamp(1.1rem, 2.2vw, 1.6rem);
    color: inherit;
    text-decoration: none;
    transition: none;
  }
  /* Division-colour wash on hover (transform + opacity only). */
  .division-cross__door::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--door-c);
    transform: translateY(101%);
    opacity: 0.14;
    transition: transform 0.5s var(--ease-out);
    pointer-events: none;
  }
  .division-cross__door:hover::before,
  .division-cross__door:focus-visible::before {
    transform: translateY(0);
  }
  .division-cross__door:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .division-cross__logo {
    height: 84px;
    display: flex;
    align-items: center;
  }
  .division-cross__logo img {
    max-height: 100%;
    width: auto;
    max-width: 200px;
    display: block;
  }

  .division-cross__name {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    color: var(--fg-1);
    margin: 0;
  }
  .division-cross__line {
    margin: var(--s-2) 0 0;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.95rem;
    line-height: var(--leading-body);
    color: var(--fg-3);
    max-width: 40ch;
  }

  .division-cross__go {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--door-c-text, var(--fg-4));
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .division-cross__go::before {
    content: '';
    width: 26px;
    height: 2px;
    background: var(--door-c);
  }

  .division-cross__door--212 {
    --door-c: var(--apr-amber);
    --door-c-text: #c98a3f;
  }
  .division-cross__door--310 {
    --door-c: var(--apr-imax);
    --door-c-text: #3aa8ba;
  }
  .division-cross__door--nrc {
    --door-c: var(--apr-grey);
    --door-c-text: var(--apr-grey);
  }
  :global([data-theme='light']) .division-cross__door--212 {
    --door-c-text: #8a5a12;
  }
  :global([data-theme='light']) .division-cross__door--310 {
    --door-c-text: #0a5c6b;
  }
  :global([data-theme='light']) .division-cross__door--nrc {
    --door-c-text: #5a5a5a;
  }
</style>
