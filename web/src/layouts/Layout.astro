---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import MagneticNavIsland from '../components/islands/MagneticNavIsland'
import { fetchSiteSettings, fetchFooterLinks, resolveMediaUrl } from '../lib/payload'
import type { FooterLink } from '../lib/payload'

interface Props {
  title?: string
  description?: string
  faviconOverride?: unknown
  navLogoOverride?: unknown
  navLogoAltOverride?: string
  footerLogoOverride?: unknown
  footerLogoAltOverride?: string
}

const [{ settings }, { footerLinks }] = await Promise.all([
  fetchSiteSettings(),
  fetchFooterLinks(),
])

const siteName    = settings?.brandLabel ?? 'APR 70 Pictures'
const { title = siteName, description = settings?.tagline ?? '' } = Astro.props
const pageTitle   = title === siteName ? siteName : `${title} — ${siteName}`
const showRails   = settings?.showFilmstripRails !== false

const primaryFromPayload = (footerLinks?.primaryNav ?? []).filter(
  (l): l is FooterLink => Boolean(l?.href && l?.label),
)
const primaryNav: FooterLink[] =
  primaryFromPayload.length > 0
    ? primaryFromPayload
    : [
        { label: 'Work', href: '/work' },
        { label: 'About', href: '/about' },
        { label: 'Investors', href: '/investors' },
        { label: 'Contact', href: '/contact' },
      ]

const faviconMedia = Astro.props.faviconOverride ?? settings?.favicon
const faviconSrc = resolveMediaUrl(
  typeof faviconMedia === 'object' && faviconMedia ? faviconMedia as any : undefined,
)

const navLogoOverrideMedia = Astro.props.navLogoOverride
const navLogoOverrideSrc = resolveMediaUrl(
  typeof navLogoOverrideMedia === 'object' && navLogoOverrideMedia ? navLogoOverrideMedia as any : undefined,
)
const navLogoLightSrc = resolveMediaUrl(
  typeof settings?.navLogoLight === 'object' && settings.navLogoLight ? settings.navLogoLight as any : undefined,
)
const navLogoSrc = navLogoOverrideSrc ?? navLogoLightSrc
const navLogoAlt = Astro.props.navLogoAltOverride ?? siteName

const footerLogoOverrideMedia = Astro.props.footerLogoOverride
const footerLogoSrc = resolveMediaUrl(
  typeof footerLogoOverrideMedia === 'object' && footerLogoOverrideMedia ? footerLogoOverrideMedia as any : undefined,
)
const footerLogoAlt = Astro.props.footerLogoAltOverride
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {faviconSrc ? (
      <link rel="icon" type="image/svg+xml" href={faviconSrc} />
    ) : (
      <Fragment>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
      </Fragment>
    )}
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <div class="site-chrome-top">
      <!-- Top filmstrip rail (feature-flagged) -->
      {showRails && (
        <div class="strip-rail strip-rail--top" aria-hidden="true">
          {Array.from({ length: 32 }).map(() => (
            <span class="sprocket" />
          ))}
        </div>
      )}

      <header class="site-header">
        <div class="container site-header__inner">
          <MagneticNavIsland
            client:idle
            items={primaryNav}
            logoSrc={navLogoSrc}
            logoAlt={navLogoAlt}
          />
        </div>
      </header>
    </div>

    <slot />

    <Footer settings={settings} footerLinks={footerLinks} footerLogoSrc={footerLogoSrc} footerLogoAlt={footerLogoAlt} />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  .site-chrome-top {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .strip-rail--top {
    border-bottom: 1px solid var(--bg-3);
    border-top: none;
  }

  .site-header {
    background: color-mix(in srgb, var(--bg-1) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--bg-3);
  }

  .site-header__inner {
    display: flex;
    justify-content: center;
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
  }
</style>
