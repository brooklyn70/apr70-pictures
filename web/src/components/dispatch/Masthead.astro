---
import type { DispatchIssueDoc } from '../../lib/payload'
import { V4_DISPATCH_INDICIA } from '../../content/v4'

interface Props {
  indicia: DispatchIssueDoc['indicia']
  title?: string
}

const { indicia, title = 'DIS·PATCH' } = Astro.props
const parts = String(title).split('·')
/* Numbered, never dated: the masthead renders the issue NUMBER (+ reel keycode)
   only — no Vol., no season, no month, no year, regardless of what the data
   still carries. The number is the only clock. */
---

<div class="masthead">
  <div class="masthead-row">
    <div class="masthead-left">{indicia.number}</div>
    <div class="masthead-wordmark">
      {parts.map((p, i) => (
        <>
          {p}
          {i < parts.length - 1 && <span class="amp">·</span>}
        </>
      ))}
    </div>
    <div class="masthead-right">{indicia.reel}</div>
  </div>
  <div class="masthead-indicia">
    <span><b>APR 70 PICTURES</b></span>
    <span>{V4_DISPATCH_INDICIA.numberedLine}</span>
    <span>{V4_DISPATCH_INDICIA.clockLine}</span>
    <span>{indicia.offices}</span>
  </div>
</div>
