---
import type { DispatchIssueDoc } from '../../lib/payload'
import { resolveMediaSrcOrPlaceholder } from '../../lib/payload'
import type { Media } from 'payload-types'

interface Props {
  data: DispatchIssueDoc['editorial']
}

const { data } = Astro.props
const paragraphs = data.paragraphs ?? []

const portrait =
  typeof data.portrait === 'object' && data.portrait ? (data.portrait as Media) : null
const portraitSrc = resolveMediaSrcOrPlaceholder(portrait, {
  aspect: '4x3',
  division: null,
})
---

<section class="editor" aria-labelledby="editor-title">
  <aside class="editor-aside">
    <div class="editor-aside-portrait">
      <img class="editor-portrait-img" src={portraitSrc.src} alt={portraitSrc.alt || 'Editor portrait'} />
    </div>
    <div class="editor-aside-name">Marc A. Caruso</div>
    <div class="editor-aside-role">Founder · Editor of Record</div>
    <div class="editor-aside-quote">{data.quote}</div>
  </aside>
  <div class="editor-main">
    <span class="editor-eyebrow">{data.eyebrow}</span>
    <h2 class="editor-title" id="editor-title">{data.title}</h2>
    <p class="editor-lead">{data.lead}</p>
    <div class="editor-body">
      {paragraphs.map((p) => <p>{p.text}</p>)}
    </div>
    <div class="editor-signoff">
      <span class="editor-signoff-script">— M.</span>
      <span class="editor-signoff-name">{data.signatureMeta}</span>
    </div>
  </div>
</section>

<style>
  .editor-portrait-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
