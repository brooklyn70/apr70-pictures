---
/**
 * DivisionSectionBlock.astro — the division's Draft-3 section copy, VERBATIM.
 *
 * A kicker rail + a large opening line (the lede) + the reading passage, plus an
 * optional formats line (212). Zero JS, tokens only, both modes. The reading
 * passage is the SSR-visible default; no scrub hook that could leave it dim.
 */
import type { DivisionSectionData } from '../../content/v4'
import { toParagraphs } from '../../content/v4'

interface Props {
  block: DivisionSectionData
}

const { block } = Astro.props
const paragraphs = toParagraphs(block.body)
---

<section class:list={['division-section', `division-section--${block.tone}`]} aria-label="Division mandate">
  <div class="container division-section__inner">
    <div class="division-section__rail">
      <span class="division-section__kicker">{block.kicker}</span>
    </div>
    <div class="division-section__main">
      <p class="division-section__lede">{block.lede}</p>
      {paragraphs.map((p) => (
        <p class="division-section__body">{p}</p>
      ))}
      {block.formats && (
        <div class="division-section__formats">
          {block.formatsLabel && <span class="division-section__formats-label">{block.formatsLabel}</span>}
          <p class="division-section__formats-text">{block.formats}</p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .division-section {
    border-bottom: 1px solid var(--rule);
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }

  .division-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5) var(--s-8);
  }
  @media (min-width: 860px) {
    .division-section__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.7fr);
    }
  }

  .division-section__rail {
    position: relative;
    padding-left: 16px;
  }
  .division-section__rail::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    bottom: 2px;
    width: 3px;
    background: var(--div-c);
  }
  .division-section__kicker {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--div-c-text);
  }

  .division-section__lede {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 4vw, 2.9rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--fg-1);
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
    max-width: 20ch;
  }

  .division-section__body {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-body-lg);
    line-height: var(--leading-body);
    color: var(--fg-2);
    max-width: 62ch;
    margin: 0 0 var(--s-5);
  }
  .division-section__body:last-child {
    margin-bottom: 0;
  }

  .division-section__formats {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .division-section__formats-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--fg-4);
    margin-bottom: var(--s-2);
  }
  .division-section__formats-text {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--type-body);
    line-height: var(--leading-snug);
    color: var(--div-c-text);
    margin: 0;
    max-width: 54ch;
  }

  /* ── Division tones ── */
  .division-section--212 {
    --div-c: var(--apr-amber);
    --div-c-text: #c98a3f;
  }
  .division-section--310 {
    --div-c: var(--apr-imax);
    --div-c-text: #3aa8ba;
  }
  .division-section--nrc {
    --div-c: var(--apr-grey);
    --div-c-text: var(--apr-grey);
  }
  :global([data-theme='light']) .division-section--212 {
    --div-c-text: #8a5a12;
  }
  :global([data-theme='light']) .division-section--310 {
    --div-c-text: #0a5c6b;
  }
  :global([data-theme='light']) .division-section--nrc {
    --div-c-text: #5a5a5a;
  }
</style>
