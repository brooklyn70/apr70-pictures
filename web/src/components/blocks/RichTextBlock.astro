---
import type { Home } from 'payload-types'

import { richTextLexicalToHtml } from '../../lib/lexicalToHtml'

type RichBlock = Extract<
  NonNullable<NonNullable<Home['layout']>[number]>,
  { blockType: 'richText' }
>

interface Props {
  block: RichBlock
}

const { block } = Astro.props

const html = richTextLexicalToHtml(block.content ?? undefined)
const isMega = (block as any).megaScale === true
---

<section class="rich-text-block" aria-label="Rich text">
  {!html ? <p class="rich-text-block__empty">No content.</p> : null}
  {html ? <div class:list={["rich-text-block__body", "payload-richtext"]} data-display={isMega ? "mega" : undefined} set:html={html} /> : null}
</section>

<style is:global>
  /* Mirrors v2 Payload RichText.tsx D-7 blocks */
  .rich-text-block__body.payload-richtext {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-body);
    line-height: var(--leading-body);
    color: var(--fg-2);
    max-width: 42rem;
  }

  .rich-text-block__body.payload-richtext :where(p) {
    margin: 0 0 var(--s-5);
  }

  .rich-text-block__body.payload-richtext :where(a) {
    color: var(--fg-1);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: opacity var(--dur-base) var(--ease-in);
  }

  .rich-text-block__body.payload-richtext :where(a:hover) {
    opacity: 0.7;
  }

  .d7-structure-divider {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-block: var(--s-9);
    width: 100%;
    box-sizing: border-box;
  }

  .d7-structure-divider--plain .d7-structure-divider__rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .d7-structure-divider--labeled .d7-structure-divider__rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .d7-structure-divider__label {
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: var(--track-eyebrow);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--type-micro);
    color: var(--fg-4);
  }

  .d7-button-wrap {
    margin-block: var(--s-5);
  }

  .d7-button {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    padding: 0.625rem var(--s-6);
    text-transform: uppercase;
    letter-spacing: var(--track-wider);
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    text-decoration: none;
    cursor: crosshair;
    transition:
      color var(--dur-base) var(--ease-in),
      border-color var(--dur-base) var(--ease-in),
      background-color var(--dur-base) var(--ease-in);
  }

  .d7-button--primary {
    color: var(--fg-1);
    border: 1px solid var(--rule-strong);
    background-color: transparent;
  }

  .d7-button--primary:hover {
    color: var(--apr-black);
    background-color: var(--apr-white);
    border-color: var(--apr-white);
  }

  .d7-button--secondary {
    color: var(--fg-3);
    border: 1px solid var(--rule);
    background-color: transparent;
  }

  .d7-button--secondary:hover {
    color: var(--fg-1);
    border-color: var(--rule-strong);
  }

  .d7-accent-text {
    margin-block: var(--s-8);
    padding-block: var(--s-2);
    padding-inline-start: var(--s-6);
    border-left-style: solid;
    border-left-width: 2px;
    border-color: var(--apr-amber);
    white-space: pre-line;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-body-lg);
    line-height: var(--leading-loose);
    color: var(--fg-1);
  }
</style>

<style>
  .rich-text-block {
    padding: 0 var(--s-3) var(--s-8);
    box-sizing: border-box;
    width: 100%;
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .rich-text-block__empty {
    margin: 0;
    font-family: var(--font-body);
    color: var(--fg-4);
    font-style: italic;
  }
</style>
