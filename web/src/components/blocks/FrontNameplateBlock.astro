---
/**
 * FrontNameplateBlock.astro — the front-door nameplate (Screening Room / T1).
 *
 * APR 70 / PICTURES. stacked at poster scale, orange full stop; the entertainment
 * sub-line + Long Island City address; the mono indicia strip. Zero JS, tokens
 * only (both modes rebind automatically). The nameplate letters compose on load
 * (after the splash when it plays) via src/lib/motion/screening-room.ts, which
 * selects the [data-motion="nameplate-*"] hooks; the SSR default is fully visible.
 */
import type { FrontNameplateData } from '../../content/v4'

interface Props {
  block: FrontNameplateData
}

const { block } = Astro.props
---

<header class="front-nameplate">
  <div class="container front-nameplate__inner">
    <h1 class="front-nameplate__wordmark" aria-label={`${block.lineOne} ${block.lineTwo}.`}
      ><span class="front-nameplate__line" data-motion="nameplate-line">{block.lineOne}</span
      ><span class="front-nameplate__line" data-motion="nameplate-line"
        >{block.lineTwo}<span class="front-nameplate__dot" aria-hidden="true">.</span></span
      ></h1
    >

    <div class="front-nameplate__meta" data-motion="nameplate-meta">
      <p class="front-nameplate__subline">{block.subLine}</p>
      <p class="front-nameplate__location">{block.location}</p>
    </div>

    {block.indicia.length > 0 && (
      <ul class="front-nameplate__indicia" data-motion="nameplate-meta" role="list">
        {block.indicia.map((word, i) => (
          <li class="front-nameplate__indicium">
            {i === 0 ? <b>{word}</b> : word}
          </li>
        ))}
      </ul>
    )}
  </div>
</header>

<style>
  .front-nameplate {
    border-bottom: 1px solid var(--rule-strong);
    padding: clamp(2.25rem, 6vw, 5rem) 0 0;
    /* Ultra-wide guard: a single poster line never forces horizontal scroll. */
    overflow-x: clip;
  }

  .front-nameplate__inner {
    text-align: center;
  }

  .front-nameplate__wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3.4rem, 15vw, 19rem);
    line-height: var(--leading-crush);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--fg-1);
    margin: 0;
  }

  .front-nameplate__line {
    display: block;
    /* Masks the SplitText chars' entrance (yPercent 110 -> 0): without the
       clip, chars sliding up from below would peek past the crushed line
       box before settling. Matches the reference's .mast-line exactly. */
    overflow: hidden;
  }

  .front-nameplate__dot {
    color: var(--accent);
  }

  .front-nameplate__meta {
    margin-top: clamp(0.9rem, 2.2vw, 1.3rem);
  }

  .front-nameplate__subline {
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 1.3vw, 0.6875rem);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--fg-3);
    margin: 0;
    line-height: 1.7;
  }

  .front-nameplate__location {
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 1.2vw, 0.625rem);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--fg-4);
    margin: var(--s-2) 0 0;
  }

  .front-nameplate__indicia {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
    padding: var(--s-3) 0;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--fg-4);
  }
  .front-nameplate__indicium b {
    color: var(--fg-1);
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .front-nameplate__indicia {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--s-1);
    }
  }
</style>
