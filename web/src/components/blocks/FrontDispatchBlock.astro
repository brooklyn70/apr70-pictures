---
/**
 * FrontDispatchBlock.astro — the numbered-issue dispatch band.
 * Orange leader tab, "Dispatch No. 1", offices line, the numbered-not-dated
 * note, and the CTA to /news. The band slides in on scroll
 * (screening-room.ts, [data-motion="dispatch-band"]).
 */
import type { FrontDispatchData } from '../../content/v4'

interface Props {
  block: FrontDispatchData
}

const { block } = Astro.props
---

<section class="front-dispatch" aria-label="Dispatch">
  <div class="front-dispatch__band" data-motion="dispatch-band">
    <span class="front-dispatch__name">{block.label} <b>{block.number}</b></span>
    <span class="front-dispatch__from">{block.from}</span>
    <span class="front-dispatch__note">{block.note}</span>
    <a class="front-dispatch__cta" href={block.cta.href}>{block.cta.label}</a>
  </div>
</section>

<style>
  .front-dispatch {
    /* The leader tab lives on the band; the band spans the padded width. */
  }
  .front-dispatch__band {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 32px);
    flex-wrap: wrap;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    padding: var(--s-4) var(--pad-x);
    overflow: hidden;
  }
  .front-dispatch__band::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: var(--accent);
  }

  .front-dispatch__name {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    letter-spacing: 0.01em;
    color: var(--fg-1);
    padding-left: var(--s-2);
  }
  .front-dispatch__name b {
    color: var(--accent);
    font-weight: 900;
  }

  .front-dispatch__from {
    font-family: var(--font-body);
    font-size: var(--type-caption);
    color: var(--fg-3);
    letter-spacing: 0.04em;
  }

  .front-dispatch__note {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--fg-4);
  }

  .front-dispatch__cta {
    font-family: var(--font-body);
    font-size: var(--type-micro);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--fg-1);
    border: 1px solid var(--rule-strong);
    padding: 9px 18px;
    transition:
      background var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .front-dispatch__cta:hover,
  .front-dispatch__cta:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }

  @media (max-width: 720px) {
    .front-dispatch__note {
      margin-left: 0;
    }
  }
</style>
