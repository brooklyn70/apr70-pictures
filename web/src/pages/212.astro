---
/**
 * /212 - the (212) Pictures division page (v9 chrome, marquee design).
 * Rebuilt 2026-07-12 to the v10 Divisions panel ruling: full-size typographic
 * lockup, discipline line, investor paragraph, and the division's own slate.
 */
import V9Layout from '../layouts/V9Layout.astro'
import DivisionPage from '../components/v9/DivisionPage.astro'
import { fetchDivisionSlate } from '../lib/payload'
import { NAP } from '../lib/v9/site'

const { slate } = await fetchDivisionSlate('212')

const lockup = '(212) Pictures'
const discipline = 'New York television at street level, built from the five boroughs.'
const paragraph =
  '(212) Pictures makes New York television at street level. Crime, drama, and documentary at the level of specificity the city demands, where the five boroughs are a living subject rather than a backdrop. When a feature grows out of this territory it carries the New Renaissance Cinema banner and (212) joins as co-production, so a New York story can move to the big screen without changing hands.'
const title = `${lockup} · ${NAP.name}`
---

<V9Layout title={title} description={discipline}>
  <script is:inline>document.documentElement.setAttribute('data-accent', 'flame')</script>
  <DivisionPage
    division="212"
    lockup={lockup}
    discipline={discipline}
    paragraph={paragraph}
    slate={slate}
  />
</V9Layout>
