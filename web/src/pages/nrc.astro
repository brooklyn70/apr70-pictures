---
/**
 * /nrc - the New Renaissance Cinema division page (v9 chrome, marquee design).
 * Rebuilt 2026-07-12 to the v10 Divisions panel ruling: full-size typographic
 * lockup, discipline line, investor paragraph, and the division's own slate.
 * NRC holds the feature slate (the deep bench, six of ten properties), including
 * Sea Gate and Da Hook, both ruled NRC features 2026-07-12.
 */
import V9Layout from '../layouts/V9Layout.astro'
import DivisionPage from '../components/v9/DivisionPage.astro'
import { fetchDivisionSlate, fetchV9SlateProjects } from '../lib/payload'
import { NAP } from '../lib/v9/site'

const [{ slate }, { slate: whole }] = await Promise.all([
  fetchDivisionSlate('nrc'),
  fetchV9SlateProjects(),
])

const lockup = 'New Renaissance Cinema'
const discipline = 'Feature films built for permanence.'
const paragraph =
  // v15: Neon's text (N-035), copied from the review / round 1 answers.
  'Original and public-domain feature screenplays written for theaters and a long shelf life. Every APR 70 feature carries this banner. Stories rooted in New York or Los Angeles co-produce with (212) or (310); stories set elsewhere, such as U Bruculinu in Sicily, stand here alone.'
const title = `${lockup} · ${NAP.name}`
---

<V9Layout title={title} description={discipline} division="nrc">
  <DivisionPage
    division="nrc"
    lockup={lockup}
    discipline={discipline}
    paragraph={paragraph}
    slate={slate}
    slateCount={whole.length}
  />
</V9Layout>
