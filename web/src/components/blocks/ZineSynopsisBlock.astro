---
/**
 * ZineSynopsisBlock.astro — synopsis-as-hero property treatment (v4).
 * No image dependence; the text is the hero. Draft state renders as a
 * discreet small-caps "working draft" tag. Zero JS, tokens only.
 */
import type { ZineSynopsisData } from '../../content/v4'
import { toParagraphs } from '../../content/v4'

interface Props {
  block: ZineSynopsisData
}

const { block } = Astro.props
const paragraphs = toParagraphs(block.body)
---

<article class="zine-synopsis">
  <div class="container zine-synopsis__inner">
    <header class="zine-synopsis__header">
      {block.kicker && <p class="zine-synopsis__kicker">{block.kicker}</p>}
      <h1 class="zine-synopsis__title">{block.title}</h1>
      {block.workingDraft && <span class="zine-synopsis__draft">working draft</span>}
    </header>

    {block.logline && <p class="zine-synopsis__logline">{block.logline}</p>}

    <div class="zine-synopsis__body">
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    {block.note && <p class="zine-synopsis__note">{block.note}</p>}
  </div>
</article>

<style>
  .zine-synopsis {
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(2rem, 5vw, 4rem);
  }

  .zine-synopsis__inner {
    max-width: min(var(--max-content), 100%);
  }

  .zine-synopsis__header {
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: clamp(1rem, 2.5vw, 1.75rem);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .zine-synopsis__kicker {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--apr-orange);
    margin: 0 0 var(--s-3);
  }

  .zine-synopsis__title {
    font-size: clamp(2.25rem, 8vw, 6rem);
    line-height: var(--leading-crush);
    margin: 0;
    color: var(--fg-1);
    text-wrap: balance;
  }

  .zine-synopsis__draft {
    display: inline-block;
    margin-top: var(--s-4);
    font-family: var(--font-body);
    font-variant: small-caps;
    font-weight: 400;
    font-size: var(--type-caption);
    letter-spacing: var(--track-wider);
    color: var(--fg-3);
    border: 1px solid var(--rule-strong);
    padding: 0.1em 0.7em 0.2em;
  }

  .zine-synopsis__logline {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    line-height: var(--leading-snug);
    color: var(--fg-1);
    max-width: 34em;
    margin: 0 0 clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .zine-synopsis__body p {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-body-lg);
    line-height: var(--leading-body);
    color: var(--fg-2);
    max-width: 68ch;
    margin: 0 0 var(--s-5);
  }

  .zine-synopsis__body p:first-child::first-letter {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3.2em;
    line-height: 0.8;
    float: left;
    padding-right: 0.12em;
    color: var(--fg-1);
  }

  .zine-synopsis__note {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--fg-3);
    border-top: 1px solid var(--rule);
    padding-top: var(--s-4);
    margin: var(--s-6) 0 0;
    max-width: 68ch;
  }
</style>
