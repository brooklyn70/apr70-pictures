---
/**
 * PlaybillBlock.astro — presentation card for a Troupe Presents episode.
 * Mercury-lineage program card: number, title, runtime, voice/doubling
 * roster, scene count, status. Zero JS. Token-locked, both color modes.
 *
 * Poster media comes from the Payload Media relationship when set; until a
 * PD-verified image is uploaded it falls back to the local placeholder line
 * art in web/public/troupe/.
 */
import { resolveMediaUrl } from '../../lib/payload'
import type { PlaybillBlockData } from '../../lib/troupe'

interface Props {
  block: PlaybillBlockData
}

const { block } = Astro.props

const posterMedia = typeof block.posterImage === 'object' && block.posterImage ? block.posterImage : null
const posterUrl = resolveMediaUrl(posterMedia ?? undefined)

const artworkFiles: Record<string, string> = {
  'on-air': '/troupe/on-air.svg',
  microphone: '/troupe/microphone.svg',
  script: '/troupe/bradded-script.svg',
}
const fallbackArt = artworkFiles[block.artwork ?? 'on-air'] ?? artworkFiles['on-air']
const artSrc = posterUrl ?? fallbackArt
const artAlt = posterMedia?.alt || `${block.title} program artwork`

const statusLabels: Record<string, string> = {
  'in-production': 'In production',
  'coming-soon': 'Coming soon',
  released: 'Released',
}
const statusLabel = statusLabels[block.status] ?? block.status

const voices = block.voices ?? []
---

<section class="playbill-block" aria-label={`Playbill: ${block.title}`}>
  <div class="playbill-card">
    <div class="playbill-art">
      <img src={artSrc} alt={artAlt} width="600" height="750" loading="lazy" />
    </div>

    <div class="playbill-body">
      <p class="playbill-eyebrow">
        APR 70 Troupe Presents{block.programNumber ? ` — ${block.programNumber}` : ''}
      </p>

      <h2 class="playbill-title">{block.title}</h2>

      {block.subtitle && <p class="playbill-subtitle">{block.subtitle}</p>}

      <dl class="playbill-meta">
        {block.runtime && (
          <div class="meta-cell">
            <dt>Runtime</dt>
            <dd>{block.runtime}</dd>
          </div>
        )}
        {typeof block.sceneCount === 'number' && (
          <div class="meta-cell">
            <dt>Scenes</dt>
            <dd>{block.sceneCount}</dd>
          </div>
        )}
        <div class="meta-cell">
          <dt>Status</dt>
          <dd><span class="status-chip">{statusLabel}</span></dd>
        </div>
      </dl>

      {voices.length > 0 && (
        <div class="playbill-roster">
          <h3 class="roster-heading">The Troupe — doubling plan</h3>
          <ul class="roster-list">
            {voices.map((v) => (
              <li class="roster-row">
                <span class="roster-voice">{v.voice}</span>
                {v.descriptor && <span class="roster-desc">{v.descriptor}</span>}
                <span class="roster-roles">
                  {v.roles}
                  {v.note && <em class="roster-note"> {v.note}</em>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {block.notes && <p class="playbill-notes">{block.notes}</p>}
    </div>
  </div>
</section>

<style>
  .playbill-block {
    width: 100%;
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--s-8) var(--s-3);
    box-sizing: border-box;
  }

  .playbill-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    border: 1px solid var(--rule-strong);
    background: var(--bg-1);
    padding: clamp(1rem, 4vw, 3rem);
  }

  @media (min-width: 768px) {
    .playbill-card {
      grid-template-columns: minmax(200px, 300px) 1fr;
      gap: var(--s-7);
    }
  }

  .playbill-art {
    align-self: start;
    max-width: 300px;
    margin: 0 auto;
    width: 100%;
  }

  @media (min-width: 768px) {
    .playbill-art {
      margin: 0;
    }
  }

  .playbill-art img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .playbill-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--fg-3);
    margin: 0 0 var(--s-3);
  }

  .playbill-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    color: var(--fg-1);
    margin: 0 0 var(--s-2);
    white-space: normal;
  }

  .playbill-subtitle {
    font-family: var(--font-body);
    font-size: var(--type-body-lg);
    font-weight: 300;
    font-style: italic;
    color: var(--fg-2);
    margin: 0 0 var(--s-5);
  }

  .playbill-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5) var(--s-7);
    margin: 0 0 var(--s-6);
    padding: var(--s-4) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .meta-cell dt {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--fg-4);
    margin-bottom: var(--s-1);
  }

  .meta-cell dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--type-body);
    color: var(--fg-1);
  }

  .status-chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--color-310-imax);
    border: 1px solid var(--color-310-imax);
    border-radius: var(--r-xs);
    padding: 1px var(--s-3);
  }

  .roster-heading {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    font-weight: 400;
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--fg-3);
    margin: 0 0 var(--s-3);
  }

  .roster-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .roster-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-1) var(--s-4);
    padding: var(--s-3) 0;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 640px) {
    .roster-row {
      grid-template-columns: minmax(90px, 7.5rem) minmax(70px, 6rem) 1fr;
      align-items: baseline;
    }
  }

  .roster-voice {
    font-family: var(--font-mono);
    font-size: var(--type-small);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--fg-1);
  }

  .roster-desc {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    color: var(--fg-4);
  }

  .roster-roles {
    font-family: var(--font-body);
    font-size: var(--type-small);
    font-weight: 400;
    color: var(--fg-2);
    line-height: var(--leading-snug);
  }

  .roster-note {
    font-style: italic;
    color: var(--fg-4);
  }

  .playbill-notes {
    font-family: var(--font-body);
    font-size: var(--type-small);
    font-weight: 300;
    color: var(--fg-3);
    line-height: var(--leading-body);
    margin: var(--s-5) 0 0;
  }
</style>
