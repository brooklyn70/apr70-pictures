---
/**
 * ZineMastheadBlock.astro — DISPATCH identity masthead (v4 front door).
 * Text-forward, zero JS. Tokens only, so all five [data-design] skins and
 * both modes rebind automatically. Issues numbered, never dated.
 */
import type { ZineMastheadData } from '../../content/v4'

interface Props {
  block: ZineMastheadData
}

const { block } = Astro.props
---

<section class="zine-masthead">
  <div class="container zine-masthead__inner">
    {block.issueLabel && <p class="zine-masthead__issue">{block.issueLabel}</p>}
    <h1 class="zine-masthead__nameplate">{block.title}</h1>
    {block.officesLine && <p class="zine-masthead__offices">{block.officesLine}</p>}
    {block.dek && (
      <div class="zine-masthead__dek-wrap">
        <p class="zine-masthead__dek">{block.dek}</p>
      </div>
    )}
  </div>
</section>

<style>
  .zine-masthead {
    border-bottom: 1px solid var(--rule-strong);
    padding: clamp(2rem, 6vw, 4.5rem) 0 clamp(1.5rem, 4vw, 3rem);
  }

  .zine-masthead__inner {
    text-align: center;
  }

  .zine-masthead__issue {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--fg-3);
    margin: 0 0 var(--s-4);
  }

  .zine-masthead__nameplate {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 14vw, 10rem);
    line-height: var(--leading-crush);
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    color: var(--fg-1);
    margin: 0;
    text-wrap: balance;
  }

  .zine-masthead__offices {
    font-family: var(--font-mono);
    font-size: clamp(0.5625rem, 1.4vw, 0.6875rem);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--fg-3);
    margin: var(--s-4) 0 0;
  }

  .zine-masthead__dek-wrap {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    padding-top: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--rule);
  }

  .zine-masthead__dek {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(1.0625rem, 1.8vw, 1.375rem);
    line-height: var(--leading-body);
    color: var(--fg-2);
    max-width: 62ch;
    margin: 0 auto;
  }
</style>
