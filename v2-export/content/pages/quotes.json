      "quotes": [
        {
          "id": "69fea32c668925d999139408",
          "quote": "The cinema is not a slice of life, but a piece of cake.",
          "attribution": "Alfred Hitchcock"
        },
        {
          "id": "69fea32c668925d999139409",
          "quote": "Cinema is a matter of what's in the frame and what's out.",
          "attribution": "Martin Scorsese"
        },
        {
          "id": "69fea32c668925d99913940a",
          "quote": "I steal from every single movie ever made.",
          "attribution": "Quentin Tarantino"
        },
        {
          "id": "69fea32c668925d99913940b",
          "quote": "Every great film should seem new every time you see it.",
          "attribution": "Roger Ebert"
        },
        {
          "id": "69fea32c668925d99913940c",
          "quote": "Film is a disease.",
          "attribution": "Frank Capra"
        },
        {
          "id": "69fea32c668925d99913940d",
          "quote": "A story should have a beginning, a middle, and an end, but not necessarily in that order.",
          "attribution": "Jean-Luc Godard"
        },
        {
          "id": "69fea32c668925d99913940e",
          "quote": "The most honest form of filmmaking is to make a film for yourself.",
          "attribution": "Peter Jackson"
        }
