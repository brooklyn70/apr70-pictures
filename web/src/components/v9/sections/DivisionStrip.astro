---
/** divisionStrip — the three-division strip on /slate. */
import type { V9Section } from '../../../lib/payload'

type DivisionStripData = Extract<V9Section, { blockType: 'divisionStrip' }>
const section = Astro.props.section as DivisionStripData
const divisions = (section.divisions ?? []).filter((d) => d.name)
---

{
  divisions.length > 0 && (
    <section class="v9-section v9-section--tight" aria-label="Divisions">
      <div class="v9-col">
        <div class="v9-divisionstrip">
          {divisions.map((d) => (
            <div class="v9-division">
              <h3 class="v9-division__name">{d.name}</h3>
              {d.blurb && <p class="v9-division__blurb">{d.blurb}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
