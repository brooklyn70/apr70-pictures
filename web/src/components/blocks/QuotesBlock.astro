---
import type { Home } from 'payload-types'

type QuotesBlockType = Extract<
  NonNullable<NonNullable<Home['layout']>[number]>,
  { blockType: 'quotes' }
>

interface Props {
  block: QuotesBlockType
}

const { block } = Astro.props
---

<section class="quotes-block">
  {block.heading && (
    <div class="quotes-block__header">
      <h2 class="quotes-block__heading">{block.heading}</h2>
    </div>
  )}

  <div class={`quotes-block__list ${block.layout === 'carousel' ? 'is-carousel' : ''}`}>
    {block.quotes?.map((q) => (
      <blockquote class="quote">
        <p class="quote__text">"{q.quote}"</p>
        {q.attribution && (
          <footer class="quote__attr">
            <cite class="eyebrow">-- {q.attribution}</cite>
          </footer>
        )}
      </blockquote>
    ))}
  </div>
</section>

<style>
  .quotes-block {
    width: 100%;
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--s-8) var(--s-3);
    box-sizing: border-box;
  }

  .quotes-block__header {
    margin-bottom: var(--s-6);
  }

  .quotes-block__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h2);
    line-height: var(--leading-snug);
    letter-spacing: var(--track-tight);
    color: var(--fg-1);
    text-transform: uppercase;
  }

  .quotes-block__list {
    display: flex;
    flex-direction: column;
    gap: var(--s-7);
  }

  .quotes-block__list.is-carousel {
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: var(--s-5);
    padding-bottom: var(--s-4);
  }

  .quotes-block__list.is-carousel .quote {
    min-width: 80%;
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .quotes-block__list.is-carousel .quote {
      min-width: 400px;
    }
  }

  .quote {
    margin: 0;
    padding: 0;
    border-left: var(--s-1) solid var(--apr-amber);
    padding-left: var(--s-4);
  }

  .quote__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h3);
    line-height: var(--leading-snug);
    color: var(--fg-1);
    text-wrap: balance;
  }

  .quote__attr {
    margin-top: var(--s-3);
  }
</style>
