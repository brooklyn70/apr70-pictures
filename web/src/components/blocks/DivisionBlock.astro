---
/**
 * DivisionBlock.astro — Division Showcase renderer.
 * Currently renders Variant 0 (v2-faithful baseline: stacked rows with ghost numerals).
 * Variants 1-4 will be built during Phase 5.
 */
interface Division {
  name: string
  colorToken: string
  subtitle?: string
  description?: string
  media?: any
}

interface Props {
  block: {
    variant: string
    heading?: string
    subtext?: string
    divisions: Division[]
  }
}

const { block } = Astro.props
const divisions = block.divisions ?? []

/** Map token keys to CSS variable references */
function tokenToVar(token: string): string {
  return `var(--color-${token})`
}
---

<section class="division-showcase">
  {block.heading && (
    <div class="division-header container">
      <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
      {block.subtext && (
        <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
      )}
    </div>
  )}

  <div class="division-rows container">
    {divisions.map((div, i) => {
      const num = String(i + 1).padStart(2, '0')
      const color = tokenToVar(div.colorToken)
      return (
        <div class="division-row" style={`--div-color: ${color}`}>
          {/* Ghost numeral */}
          <span class="ghost-num" aria-hidden="true">{num}</span>

          <div class="division-content">
            <span class="eyebrow">{num}</span>
            <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
            {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
            {div.description && (
              <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
            )}
          </div>
        </div>
      )
    })}
  </div>
</section>

<style>
  .division-showcase {
    padding: var(--s-9) 0;
  }

  .division-header {
    text-align: center;
    margin-bottom: var(--s-9);
  }

  .division-header .body-lg {
    max-width: 640px;
    margin: var(--s-5) auto 0;
    color: var(--fg-3);
  }

  .division-rows {
    display: flex;
    flex-direction: column;
  }

  .division-row {
    position: relative;
    border-top: 1px solid var(--rule);
    padding: var(--s-9) 0;
    overflow: hidden;
  }

  .ghost-num {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 16vw, 14rem);
    color: var(--fg-6);
    line-height: 1;
    letter-spacing: var(--track-tight);
    pointer-events: none;
    user-select: none;
  }

  .division-content {
    position: relative;
    max-width: 780px;
  }

  .division-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: var(--track-tight);
    margin-bottom: var(--s-4);
    text-transform: uppercase;
  }

  .division-subtitle {
    display: block;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(0.8125rem, 1vw, 0.875rem);
    color: var(--fg-4);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    margin-bottom: var(--s-5);
  }

  .division-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--fg-2);
    line-height: 1.72;
    max-width: 620px;
  }
</style>
