---
import Layout from '../../layouts/Layout.astro'
import DivisionBlock from '../../components/blocks/DivisionBlock.astro'

const mockDivisions = [
  {
    name: '(212) Pictures',
    colorToken: '212-amber',
    subtitle: 'New York TV Label',
    description: 'Character-driven drama, crime, and documentary rooted in the American Northeast. Named for the original Manhattan area code.',
    number: '01',
    taglineLines: ['New York.', 'Television.'],
    projects: [
      { title: 'A NEED GROWS IN BROOKLYN', badge: '10 EPS' },
      { title: 'THE MAYORS', badge: 'DOC · 11 EPS' },
      { title: 'THE MALTESE FALCON', badge: 'STAGE' },
    ],
  },
  {
    name: '(310) Pictures',
    colorToken: '310-imax',
    subtitle: 'LA / Global TV Label',
    description: 'Elevated genre — political thrillers, sci-fi, and hybrid formats. Los Angeles-rooted, globally minded.',
    number: '02',
    taglineLines: ['Los Angeles.', 'Global.'],
    projects: [
      { title: 'L.A. DOLCE VITA', badge: '$30–50M' },
      { title: "L'ODISSEA DI CLEOPATRA", badge: '$40–80M' },
      { title: 'SHADOWMASTER', badge: 'HYBRID' },
    ],
  },
  {
    name: 'New Renaissance Cinema',
    colorToken: 'nrc-grey',
    subtitle: 'Feature Film',
    description: 'Auteur-driven feature films with a classic-modern sensibility. The art of the possible.',
    number: '03',
    taglineLines: ['Features.', 'Tour.'],
    projects: [
      { title: 'U BRUCCULINU', badge: 'FEATURE' },
      { title: 'ALPHA YY', badge: 'FEATURE' },
    ],
  },
]

const variantMeta: { key: string; label: string }[] = [
  { key: 'v0.1', label: 'V0.1 — card layout, printer-frame stroke, reg marks' },
  { key: 'v0.3', label: 'V0.3 — ledger rows, typographic hierarchy, hover states' },
]

const createMockBlock = (variant: string) => ({
  blockType: 'divisionShowcase',
  variant,
  heading: `APR 70 — EST. 2026`,
  subtext: 'The classics never go out of style.',
  divisions: mockDivisions,
})
---

<Layout title="Division Variants — V0.1–V0.4">
  <main class="variants-main">
    <div class="container variants-intro">
      <h1 class="h1">Division Variants</h1>
      <p class="body-lg">V0.1 and V0.3 — pick one to advance to V1.</p>
    </div>

    {variantMeta.map(({ key, label }) => (
      <div class="variant-wrapper">
        <div class="container">
          <div class="variant-label">{label}</div>
        </div>
        <DivisionBlock block={createMockBlock(key) as any} />
      </div>
    ))}

    <div class="variant-wrapper">
      <div class="container">
        <div class="variant-label" style="background: red;">V0.3 — ALIGNMENT DEBUG GRID (20px grid)</div>
        <p style="font-family: monospace; font-size: 0.75rem; color: #888; margin-bottom: 1rem;">
          Red grid = 20px intervals (horizontal + vertical). Find the Y value where the TOP of the logo and the TOP of "NEW YORK." land. Same line = aligned.
        </p>
      </div>
      <div class="debug-grid-wrapper" id="debug-wrapper">
        <DivisionBlock block={createMockBlock('v0.3') as any} />
        <canvas id="debug-canvas" aria-hidden="true"></canvas>
      </div>
    </div>
  </main>
</Layout>

<script>
  const wrapper = document.getElementById('debug-wrapper') as HTMLElement
  const canvas = document.getElementById('debug-canvas') as HTMLCanvasElement

  function drawGrid() {
    if (!wrapper || !canvas) return
    const h = wrapper.offsetHeight
    const w = wrapper.offsetWidth
    canvas.width = w
    canvas.height = h
    const ctx = canvas.getContext('2d')
    if (!ctx) return

    ctx.clearRect(0, 0, w, h)

    const interval = 20

    // horizontal lines
    for (let y = 0; y <= h; y += interval) {
      ctx.strokeStyle = y % 100 === 0 ? 'rgba(255,0,0,0.6)' : 'rgba(255,0,0,0.2)'
      ctx.lineWidth = y % 100 === 0 ? 1.5 : 0.5
      ctx.beginPath()
      ctx.moveTo(0, y)
      ctx.lineTo(w, y)
      ctx.stroke()

      ctx.fillStyle = 'rgba(255,0,0,0.85)'
      ctx.font = 'bold 9px monospace'
      ctx.fillText(String(y), 4, y > 4 ? y - 2 : 10)
    }

    // vertical lines
    for (let x = 0; x <= w; x += interval) {
      ctx.strokeStyle = x % 100 === 0 ? 'rgba(255,0,0,0.6)' : 'rgba(255,0,0,0.2)'
      ctx.lineWidth = x % 100 === 0 ? 1.5 : 0.5
      ctx.beginPath()
      ctx.moveTo(x, 0)
      ctx.lineTo(x, h)
      ctx.stroke()

      ctx.fillStyle = 'rgba(255,0,0,0.85)'
      ctx.font = 'bold 9px monospace'
      ctx.save()
      ctx.translate(x > 4 ? x - 2 : 10, 4)
      ctx.rotate(-Math.PI / 2)
      ctx.fillText(String(x), 0, 0)
      ctx.restore()
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', drawGrid)
  } else {
    drawGrid()
  }
  window.addEventListener('resize', drawGrid)
</script>

<style>
  .variants-main {
    padding-top: var(--s-11);
    padding-bottom: var(--s-11);
  }
  .variants-intro {
    margin-bottom: var(--s-11);
  }
  .variant-wrapper {
    margin-bottom: var(--s-11);
    padding-bottom: var(--s-10);
    border-bottom: 2px dashed var(--rule);
  }
  .variant-label {
    display: inline-block;
    padding: var(--s-1) var(--s-3);
    background: var(--fg-1);
    color: var(--bg-1);
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-size: 0.8125rem;
    font-weight: bold;
    letter-spacing: var(--track-wide);
    margin-bottom: var(--s-6);
  }
  .debug-grid-wrapper {
    position: relative;
  }
  #debug-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
  }
</style>
