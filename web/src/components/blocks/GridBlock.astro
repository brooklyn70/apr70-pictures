---
import type { Home } from 'payload-types'
import { richTextLexicalToHtml } from '../../lib/lexicalToHtml'
import { resolveMediaSrcOrPlaceholder } from '../../lib/payload'

type GridBlockType = Extract<
  NonNullable<NonNullable<Home['layout']>[number]>,
  { blockType: 'grid' }
>

interface Props {
  block: GridBlockType
}

const { block } = Astro.props
---

<section class="grid-block">
  {block.heading && (
    <div class="grid-block__header">
      <h2 class="grid-block__heading">{block.heading}</h2>
    </div>
  )}

  <div class="grid-block__grid">
    {block.items?.map((item) => {
      const media = typeof item.media === 'object' && item.media ? item.media : null
      const img = resolveMediaSrcOrPlaceholder(media, { aspect: '16x9' })
      const html = richTextLexicalToHtml(item.description ?? undefined)

      return (
        <article class="grid-card">
          <div class="grid-card__media" data-placeholder={img.isPlaceholder ? 'true' : undefined}>
            <img
              class="grid-card__img"
              src={img.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              loading="lazy"
            />
          </div>
          <div class="grid-card__content">
            {item.title && <h3 class="grid-card__title">{item.title}</h3>}
            {html && <div class="payload-richtext grid-card__desc" set:html={html} />}
          </div>
        </article>
      )
    })}
  </div>
</section>

<style>
  .grid-block {
    width: 100%;
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--s-8) var(--s-3);
    box-sizing: border-box;
  }

  .grid-block__header {
    margin-bottom: var(--s-6);
  }

  .grid-block__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h2);
    line-height: var(--leading-snug);
    letter-spacing: var(--track-tight);
    color: var(--fg-1);
    text-transform: uppercase;
  }

  .grid-block__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--s-5);
  }

  @media (min-width: 768px) {
    .grid-block__grid {
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--s-6);
    }
  }

  .grid-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .grid-card__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-1);
  }

  .grid-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .grid-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .grid-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--type-h3);
    line-height: var(--leading-snug);
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    color: var(--fg-1);
  }

  .grid-card__desc :global(.payload-richtext) {
    font-family: var(--font-body);
    font-size: var(--type-body);
    font-weight: 300;
    line-height: var(--leading-body);
    color: var(--fg-2);
  }

  .grid-card__desc :global(.payload-richtext p) {
    margin: 0 0 var(--s-3);
  }

  .grid-card__desc :global(.payload-richtext p:last-child) {
    margin-bottom: 0;
  }

  .grid-card__desc :global(.payload-richtext a) {
    color: var(--fg-1);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: opacity var(--dur-base) var(--ease-in);
  }

  .grid-card__desc :global(.payload-richtext a:hover) {
    opacity: 0.7;
  }
</style>
