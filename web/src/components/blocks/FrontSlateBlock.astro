---
/**
 * FrontSlateBlock.astro — "The Slate, On Record". Seven property rows with mono
 * indexes, division tag, format line, and a hover advance; each links to
 * /work/<slug>. Rows file in on scroll (screening-room.ts,
 * [data-motion="slate-row"], trigger [data-motion="slate"]); the head dissolves
 * on exit. SSR default is the full static list.
 */
import type { FrontSlateData } from '../../content/v4'

interface Props {
  block: FrontSlateData
}

const { block } = Astro.props
---

<section class="front-slate" aria-label="The slate">
  <div class="container front-slate__inner">
    <div class="front-slate__head">
      <h2 class="front-slate__heading" data-motion="dissolve-head">{block.heading}</h2>
      <p class="front-slate__lede">{block.lede}</p>
    </div>

    <div class="front-slate__list" data-motion="slate">
      {block.rows.map((row) => (
        <a class:list={['front-slate__row', `front-slate__row--${row.tone}`]} href={row.href} data-motion="slate-row">
          <span class="front-slate__idx">{row.idx}</span>
          <span class="front-slate__title">{row.title}</span>
          <span class="front-slate__div">{row.division}</span>
          <span class="front-slate__fmt">{row.format}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .front-slate {
    background: var(--bg-1);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .front-slate__inner {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .front-slate__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .front-slate__heading {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: var(--type-h2);
    color: var(--fg-1);
    margin: 0;
  }
  .front-slate__lede {
    font-family: var(--font-body);
    font-weight: 300;
    color: var(--fg-3);
    font-size: 0.95rem;
    margin: 0;
  }

  .front-slate__list {
    margin-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .front-slate__row {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: var(--s-4);
    align-items: baseline;
    padding: clamp(0.8rem, 1.8vw, 0.95rem) 0;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
    transition:
      padding-left var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out);
  }
  @media (min-width: 720px) {
    .front-slate__row {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto auto;
      gap: var(--s-5);
    }
  }
  .front-slate__row:hover,
  .front-slate__row:focus-visible {
    padding-left: 12px;
    background: color-mix(in srgb, var(--fg-1) 3%, transparent);
  }
  .front-slate__row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .front-slate__idx {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    color: var(--fg-5);
  }
  .front-slate__title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    letter-spacing: 0.01em;
    color: var(--fg-1);
    min-width: 0;
  }
  .front-slate__div {
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--slate-c, var(--fg-4));
  }
  .front-slate__fmt {
    font-family: var(--font-body);
    font-size: var(--type-micro);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--fg-4);
    text-align: right;
  }
  /* division-only + format hidden on the narrow grid (kept accessible in DOM). */
  @media (max-width: 719px) {
    .front-slate__div,
    .front-slate__fmt {
      grid-column: 2;
      text-align: left;
    }
    .front-slate__fmt {
      color: var(--fg-5);
    }
  }

  .front-slate__row--212 {
    --slate-c: #c98a3f;
  }
  .front-slate__row--310 {
    --slate-c: #3aa8ba;
  }
  .front-slate__row--nrc {
    --slate-c: var(--apr-grey);
  }
  :global([data-theme='light']) .front-slate__row--nrc {
    --slate-c: #6a6a6a;
  }
</style>
