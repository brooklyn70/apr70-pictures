---
import '../styles/global.css'
import '../styles/themes/index.css'
import { ClientRouter } from 'astro:transitions'
import Footer from '../components/Footer.astro'
import SiteNav from '../components/SiteNav.astro'
import ThemeControlIsland from '../components/islands/ThemeControlIsland'
import { fetchSiteSettings, fetchFooterLinks, fetchProjects, resolveMediaUrl } from '../lib/payload'
import { DESIGNS, resolveDesign, designThemeMode, LOGO_SIZE } from '../designs/manifest'
import { DEFAULT_LOGO, logoFileMap, logoSrc } from '../designs/logos'

interface Props {
  title?: string
  description?: string
  faviconOverride?: unknown
  navLogoOverride?: unknown
  navLogoAltOverride?: string
  footerLogoOverride?: unknown
  footerLogoAltOverride?: string
  /** SSR design slug (dev/preview surfaces only). Themes are GLOBAL and
      visitor-selected — the pre-paint script overrides this from
      localStorage (`apr70:design`). Divisions no longer force a skin. */
  design?: string
}

/* Chrome meta description — SPEC §0 ruling: APR 70 is an ENTERTAINMENT company
   (film, television, theater, radio, books). Pages may override via `description`. */
const CHROME_DESCRIPTION =
  'APR 70 Pictures. An entertainment company: film, television, theater, radio, books. Long Island City, New York.'

const [{ settings }, { footerLinks }, { projects: navProjects }] = await Promise.all([
  fetchSiteSettings(),
  fetchFooterLinks(),
  fetchProjects(),
])

const siteName    = settings?.brandLabel ?? 'APR 70 Pictures'
const { title = siteName, description = CHROME_DESCRIPTION } = Astro.props
const pageTitle   = title === siteName ? siteName : `${title} · ${siteName}`
/* V5 (2026-07-08 feedback): the decorative rails/rulers above the nav are gone
   on every theme — "added fluff and do nothing to tell the story of who we are." */

const faviconMedia = Astro.props.faviconOverride ?? settings?.favicon
const faviconSrc = resolveMediaUrl(
  typeof faviconMedia === 'object' && faviconMedia ? faviconMedia as any : undefined,
)

const navLogoOverrideMedia = Astro.props.navLogoOverride
const navLogoOverrideSrc = resolveMediaUrl(
  typeof navLogoOverrideMedia === 'object' && navLogoOverrideMedia ? navLogoOverrideMedia as any : undefined,
)
/* Global brand mark is visitor-picked (control panel). A division page still
   shows its own division logo via navLogoOverride — that one is never swapped
   by the picker. SSR falls back to the default mark for the SSR design/mode;
   the pre-paint script + body sync correct it before first paint. */
const brandSwappable = !navLogoOverrideSrc
const navLogoAlt = Astro.props.navLogoAltOverride ?? siteName

const footerLogoOverrideMedia = Astro.props.footerLogoOverride
const footerLogoSrc = resolveMediaUrl(
  typeof footerLogoOverrideMedia === 'object' && footerLogoOverrideMedia ? footerLogoOverrideMedia as any : undefined,
)
const footerLogoAlt = Astro.props.footerLogoAltOverride

const design = resolveDesign(Astro.props.design)
const themeMode = designThemeMode(design)
const navLogoSrc = navLogoOverrideSrc ?? logoSrc(DEFAULT_LOGO, themeMode)

/* Data for the pre-paint stamp script (kept in sync with manifest + logos.ts). */
const designModes = Object.fromEntries(DESIGNS.map((d) => [d.slug, d.base]))
const logoFiles = logoFileMap()
const defaultLogo = DEFAULT_LOGO
const logoDefaults = { min: LOGO_SIZE.min, max: LOGO_SIZE.max, def: LOGO_SIZE.default }
---

<!doctype html>
<html lang="en" data-design={design} data-theme={themeMode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ designModes, logoFiles, defaultLogo, logoDefaults }}>
      /* Pre-paint stamp — global visitor-selected theme state. Runs before
         first paint so there is no FOUC. Precedence for mode: a stored
         explicit mode (apr70:mode) wins; otherwise the active theme's default.
         Legacy/invalid design values fall back cleanly to screening-room.
         Keys: apr70:design, apr70:mode, apr70:logo, apr70:logo-size,
         apr70:font-scale. Live updates come from the control panel.
         V5: re-stamps after every view-transition swap (astro:after-swap
         fires before the new frame paints, so there is still no FOUC). */
      ;(function () {
        function stamp() {
        var doc = document.documentElement
        function read(key) {
          try { return localStorage.getItem(key) } catch (e) { return null }
        }

        var design = read('apr70:design')
        if (!design || !designModes[design]) design = 'premiere-night'
        doc.setAttribute('data-design', design)

        var stored = read('apr70:mode')
        var userMode = stored === 'light' || stored === 'dark'
        var mode = userMode ? stored : (designModes[design] === 'light' ? 'light' : 'dark')
        doc.setAttribute('data-theme', mode)
        doc.setAttribute('data-mode-source', userMode ? 'user' : 'theme')

        var logo = read('apr70:logo')
        if (!logo || !logoFiles[logo]) logo = defaultLogo
        doc.setAttribute('data-logo', logo)
        doc.setAttribute('data-logo-src', logoFiles[logo][mode])

        var size = parseInt(read('apr70:logo-size'), 10)
        if (!isFinite(size)) size = logoDefaults.def
        if (size < logoDefaults.min) size = logoDefaults.min
        if (size > logoDefaults.max) size = logoDefaults.max
        doc.setAttribute('data-logo-size', String(size))
        doc.style.setProperty('--logo-h', size + 'px')

        var scales = { s: '0.9', m: '1', l: '1.1', xl: '1.2' }
        var scale = read('apr70:font-scale')
        if (!scale || !scales[scale]) scale = 'm'
        doc.setAttribute('data-font-scale', scale)
        doc.style.setProperty('--font-scale', scales[scale])

        /* Wave G2 — font deployment (apr70:font) + division-accent preference
           (apr70:accent). Token rebinds are CSS (theme-control.css); here we
           only stamp the attributes pre-paint so there is no FOUC. */
        var fonts = { house: 1, condensed: 1, serif: 1, mono: 1 }
        var font = read('apr70:font')
        if (!font || !fonts[font]) font = 'house'
        doc.setAttribute('data-font', font)

        var accents = { orange: 1, amber: 1, blue: 1, navy: 1, teal: 1, ink: 1 }
        var accent = read('apr70:accent')
        if (accent && accents[accent]) doc.setAttribute('data-accent', accent)
        /* 'auto'/absent -> no data-accent attribute; theme/base --accent flows. */
        }
        stamp()
        document.addEventListener('astro:after-swap', stamp)
      })()
    </script>
    {faviconSrc ? (
      <link rel="icon" type="image/svg+xml" href={faviconSrc} />
    ) : (
      <Fragment>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
      </Fragment>
    )}
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta name="theme-color" content="#000000" />
    <ClientRouter />
  </head>
  <body>
    <div class="site-chrome-top">
      <header class="site-header">
        <SiteNav logoSrc={navLogoSrc} logoAlt={navLogoAlt} brandSwappable={brandSwappable} projects={navProjects} />
      </header>
      <script is:inline>
        /* Sync the SSR brand mark to the pre-paint pick before anything else.
           V5: also after every view-transition swap (new DOM, same rule). */
        ;(function () {
          function syncMark() {
            var src = document.documentElement.getAttribute('data-logo-src')
            var img = document.querySelector('img[data-brand-wordmark]')
            if (src && img && img.getAttribute('src') !== src) img.setAttribute('src', src)
          }
          syncMark()
          document.addEventListener('astro:after-swap', syncMark)
        })()
      </script>
    </div>

    <slot />

    <Footer settings={settings} footerLinks={footerLinks} footerLogoSrc={footerLogoSrc} footerLogoAlt={footerLogoAlt} />

    <ThemeControlIsland client:load transition:persist="apr70-control-panel" />

    <script>
      /* Boot the site motion layer (dispatcher + cursor + one-time splash).
         Bundled module — runs after parse; SSR content is fully static without
         it. All gating (reduced-motion, touch, front-door-only, once-per-
         session) lives in the motion modules.
         V5: with the ClientRouter, re-init per-page motion on every soft
         navigation (astro:page-load fires after the swap settles) so
         ScrollTriggers bind to the NEW page's DOM. bootMotion itself stays
         once-per-full-load. */
      import { bootMotion, initThemeMotion } from '../lib/motion'
      bootMotion()
      document.addEventListener('astro:page-load', () => {
        const design = document.documentElement.getAttribute('data-design') || 'premiere-night'
        void initThemeMotion(design)
      })
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  .site-chrome-top {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .strip-rail--top {
    border-bottom: 1px solid var(--bg-3);
    border-top: none;
  }

  .site-header {
    background: color-mix(in srgb, var(--bg-1) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
</style>
