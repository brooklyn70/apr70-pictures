---
/**
 * DivisionSlateBlock.astro — the division's slate (Wave F).
 *
 * The division's properties as slate rows: mono index, title, division tag, and
 * format line, each linking to /work/<slug>. Rows carry the screening-room
 * one-time reveal hooks ([data-motion="slate-row"], trigger [data-motion="slate"]),
 * which heal to full opacity; every other theme leaves them static-visible by
 * SSR default. Zero JS otherwise.
 */
import type { DivisionSlateData } from '../../content/v4'

interface Props {
  block: DivisionSlateData
}

const { block } = Astro.props
---

<section class:list={['division-slate', `division-slate--${block.tone}`]} aria-label="Division slate">
  <div class="container division-slate__inner">
    <div class="division-slate__head">
      <h2 class="division-slate__heading">{block.heading}</h2>
      <p class="division-slate__lede">{block.lede}</p>
    </div>

    <div class="division-slate__list" data-motion="slate">
      {block.rows.map((row) => (
        <a class:list={['division-slate__row', `division-slate__row--${row.tone}`]} href={row.href} data-motion="slate-row">
          <span class="division-slate__idx">{row.idx}</span>
          <span class="division-slate__title">{row.title}</span>
          <span class="division-slate__div">{row.division}</span>
          <span class="division-slate__fmt">{row.format}</span>
          <span class="division-slate__arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .division-slate {
    background: var(--bg-1);
    border-bottom: 1px solid var(--rule);
  }

  .division-slate__inner {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .division-slate__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .division-slate__heading {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: var(--type-h2);
    color: var(--fg-1);
    margin: 0;
  }
  .division-slate__lede {
    font-family: var(--font-body);
    font-weight: 300;
    color: var(--fg-3);
    font-size: 0.95rem;
    margin: 0;
  }

  .division-slate__list {
    margin-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }

  .division-slate__row {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) auto;
    gap: var(--s-3) var(--s-4);
    align-items: baseline;
    padding: clamp(0.85rem, 1.8vw, 1.05rem) 0;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
    transition:
      padding-left var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out);
  }
  @media (min-width: 760px) {
    .division-slate__row {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto auto 1.5rem;
      gap: var(--s-5);
    }
  }
  .division-slate__row:hover,
  .division-slate__row:focus-visible {
    padding-left: 12px;
    background: color-mix(in srgb, var(--div-c) 8%, transparent);
  }
  .division-slate__row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .division-slate__idx {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    color: var(--fg-5);
  }
  .division-slate__title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.1rem, 2vw, 1.55rem);
    letter-spacing: 0.01em;
    color: var(--fg-1);
    min-width: 0;
  }
  .division-slate__div {
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--slate-c, var(--fg-4));
  }
  .division-slate__fmt {
    font-family: var(--font-body);
    font-size: var(--type-micro);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--fg-4);
    text-align: right;
  }
  .division-slate__arrow {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    color: var(--div-c);
    text-align: right;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .division-slate__row:hover .division-slate__arrow,
  .division-slate__row:focus-visible .division-slate__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Narrow: division tag + format wrap under the title; arrow hidden. */
  @media (max-width: 759px) {
    .division-slate__div,
    .division-slate__fmt {
      grid-column: 2;
      text-align: left;
    }
    .division-slate__fmt {
      color: var(--fg-5);
    }
    .division-slate__arrow {
      display: none;
    }
  }

  .division-slate__row--212 {
    --slate-c: #c98a3f;
  }
  .division-slate__row--310 {
    --slate-c: #3aa8ba;
  }
  .division-slate__row--nrc {
    --slate-c: var(--apr-grey);
  }
  :global([data-theme='light']) .division-slate__row--212 {
    --slate-c: #8a5a12;
  }
  :global([data-theme='light']) .division-slate__row--310 {
    --slate-c: #0a5c6b;
  }
  :global([data-theme='light']) .division-slate__row--nrc {
    --slate-c: #5a5a5a;
  }

  /* Division accent for the row hover wash + arrow. */
  .division-slate--212 {
    --div-c: var(--apr-amber);
  }
  .division-slate--310 {
    --div-c: var(--apr-imax);
  }
  .division-slate--nrc {
    --div-c: var(--apr-grey);
  }
</style>
