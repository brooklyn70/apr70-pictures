---
import type { DispatchIssueDoc } from '../../lib/payload'
import { resolveMediaSrcOrPlaceholder } from '../../lib/payload'
import type { Media } from 'payload-types'

interface Props {
  data: DispatchIssueDoc['feature']
}

const { data } = Astro.props
const titleParts = data.titleParts ?? []
const metaRows = data.meta ?? []
const paragraphs = data.paragraphs ?? []
const factboxLabel = data.factbox?.label ?? 'AT A GLANCE'
const factboxFields = data.factbox?.fields ?? []
const related = data.related ?? []
const caption = data.imageCaption?.caption ?? ''
const credit = data.imageCaption?.credit ?? ''

const hero =
  typeof data.heroImage === 'object' && data.heroImage ? (data.heroImage as Media) : null
const heroSrc = resolveMediaSrcOrPlaceholder(hero, {
  aspect: '16x9',
  division: '212',
})

const featureArticle = {
  section: 'FEATURES',
  folio: '012',
  eyebrow: data.eyebrow ?? 'FEATURE',
  title: titleParts.map((p) => p.text).join(' '),
  deck: data.deck ?? '',
  by: metaRows.find((m) => m.key === 'BYLINE')?.value ?? 'M.A. CARUSO',
  date: metaRows.find((m) => m.key === 'FILED')?.value ?? '',
  length: metaRows.find((m) => m.key === 'LENGTH')?.value ?? '',
  body: paragraphs.map((p) => ({
    variant: p.variant,
    text: p.text,
    attr: p.attr ?? null,
  })),
  heroSrc: heroSrc.src,
}
const featureJson = JSON.stringify(featureArticle)
---

<section class="feature" aria-labelledby="feature-title">
  <div class="feature-head">
    <div>
      <div class="feature-eyebrow">{data.eyebrow}</div>
      <h2 class="feature-title">
        {titleParts.map((p) => (
          <span class={p.italic ? 'ital' : ''}>{p.text} </span>
        ))}
      </h2>
      <p class="feature-deck">{data.deck}</p>
    </div>
    <div class="feature-meta">
      {metaRows.map((m) => (
        <div class="feature-meta-row">
          <span>{m.key}</span>
          <b>{m.value}</b>
        </div>
      ))}
    </div>
  </div>

  <figure class="feature-image">
    <img class="feature-hero-img" src={heroSrc.src} alt={heroSrc.alt || 'Feature hero'} />
    <figcaption class="feature-image-caption">
      <span><b>FIG. 01</b> &nbsp; {caption}</span>
      <span>{credit}</span>
    </figcaption>
  </figure>

  <div class="feature-body-wrap">
    <div class="feature-body">
      {paragraphs.map((p) => {
        if (p.variant === 'pull') {
          return (
            <p class="pull">
              {p.text}
              {p.attr && <span class="pull-attr">-- {p.attr}</span>}
            </p>
          )
        }
        if (p.variant === 'small') return <p class="small">· · · {p.text} · · ·</p>
        if (p.variant === 'head') return <h3>{p.text}</h3>
        return <p class={p.variant === 'first' ? 'first' : ''}>{p.text}</p>
      })}
    </div>
    <aside class="feature-side">
      <div class="feature-factbox">
        <h4>{factboxLabel}</h4>
        <dl>
          {factboxFields.map((f) => (
            <>
              <dt>{f.key}</dt>
              <dd class={f.accent && f.accent !== 'none' ? f.accent : ''}>{f.value}</dd>
            </>
          ))}
        </dl>
      </div>
      <div>
        <h4>Related in this issue</h4>
        <ul class="feature-related-list">
          {related.map((r) => (
            <li>
              <span>{r.idx}</span>
              <b>{r.name}</b>
              <span>{r.meta}</span>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>

  <div class="feature-jumpline">
    <span>{data.jumpFrom}</span>
    <a data-dispatch-open-feature href="#feature-full">OPEN FULL STORY →</a>
    <span>{data.jumpTo}</span>
  </div>
</section>

<script type="application/json" data-dispatch-feature-article set:html={featureJson} />

<style>
  .feature-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
