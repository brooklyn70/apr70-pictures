---
/** routeLine — the inline route strip on the home page. */
import type { V9Section } from '../../../lib/payload'
import { localePath } from '../../../lib/i18n/paths'

type RouteLineData = Extract<V9Section, { blockType: 'routeLine' }>
const section = Astro.props.section as RouteLineData
const links = section.links ?? []
/* i18n: internal links carry the locale prefix on prefixed pages. */
const locale = Astro.locals.locale
---

{
  links.length > 0 && (
    <section class="v9-section v9-section--tight" aria-label="Site routes">
      <nav class="v9-col v9-routeline">
        {links.map((link, i) => (
          <a class="v9-routeline__link" href={localePath(locale, link.href)}>
            <span class="v9-routeline__index">{String(i + 1).padStart(2, '0')}</span>
            {link.label}
          </a>
        ))}
      </nav>
    </section>
  )
}
