---
/**
 * Layer 1 — film grain / atmospheric field. Zero JS: an inline SVG
 * feTurbulence tile (the holding page's grain, as a 160px pattern so the
 * filter rasterises once, not per viewport pixel) over the theme paper.
 * White grain on black in Marquee Night, ink grain on paper in House Lights;
 * opacity and the optional steps() flicker live in themes/layered.css.
 * Layered-cinema POC (2026-09-02): hidden until html[data-design="layered"].
 */
---

<div class="v9lg-grain" data-layer="grain" aria-hidden="true">
  <svg class="v9lg-grain__tile" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
    <defs>
      <filter id="v9lg-grain-f" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <pattern id="v9lg-grain-p" width="160" height="160" patternUnits="userSpaceOnUse">
        <rect width="160" height="160" filter="url(#v9lg-grain-f)" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#v9lg-grain-p)" />
  </svg>
</div>
