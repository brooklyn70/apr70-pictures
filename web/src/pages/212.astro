---
import Layout from '../layouts/Layout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { fetchDivision212Global } from '../lib/payload';
import { V4_DIVISION_PASSAGES } from '../content/v4';

const { division212, error } = await fetchDivision212Global();
const dbBlocks = division212?.layout || [];
// V4 zine: the bundle's division copy leads. Once the Payload layout carries
// a zinePassage block (apply-v4-content.ts), the DB version takes over.
const hasZine = dbBlocks.some((b) => (b as { blockType?: string }).blockType === 'zinePassage');
const blocks = hasZine ? dbBlocks : [V4_DIVISION_PASSAGES['212'], ...dbBlocks];
// Themes are global + visitor-selected: the Payload `theme` field is dormant
// and divisions no longer force a skin (division logo/favicon still apply).
const faviconOverride = typeof division212?.faviconOverride === 'object' ? division212.faviconOverride : undefined;
const headerLogo = typeof division212?.headerLogo === 'object' ? division212.headerLogo : undefined;
const footerLogo = typeof division212?.footerLogo === 'object' ? division212.footerLogo : undefined;
---

<Layout title="212 Division" faviconOverride={faviconOverride} navLogoOverride={headerLogo} navLogoAltOverride="212 Pictures" footerLogoOverride={footerLogo} footerLogoAltOverride="212 Pictures">
  <main>
    {error && (
      <div style="padding: 1rem; margin: 2rem auto; max-width: 600px; background: rgba(255,0,0,0.1); border: 1px solid red; border-radius: 4px; font-family: var(--font-body); color: #cc0000;">
        <strong>Fetch Error:</strong> {error}
      </div>
    )}
    <BlockRenderer blocks={blocks} />
  </main>
</Layout>
