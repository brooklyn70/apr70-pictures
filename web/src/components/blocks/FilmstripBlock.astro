---
/**
 * FilmstripBlock.astro — Physically authentic film rail and frame renderer.
 * Built with strict adherence to Kodak KeyKode, SMPTE leader specs, and BVA optical soundtracks.
 */
import { fetchProjects, resolveMediaUrl } from '../../lib/payload'

interface Props {
  block: {
    source: 'custom-media' | 'from-projects'
    format?: 'academy' | 'super35' | 'widescreen200' | 'imax' | 'v2-header' | 'v2-footer'
    projectFilter?: 'all' | '212' | '310' | 'nrc'
    tiles?: Array<{
      media: any
      caption?: string
      division?: string
    }>
    showPerforations?: boolean
  }
}

const { block } = Astro.props
const showPerfs = block.showPerforations !== false
const format = block.format || 'super35'

const isEdgeOnly = format.startsWith('v2-')
const isFullFrame = !isEdgeOnly

type ComputedTile = {
  url: string
  alt: string
  caption: string
  division: string
  href?: string
}

let computedTiles: ComputedTile[] = []

if (block.source === 'from-projects' && isFullFrame) {
  const { projects } = await fetchProjects()
  let filtered = projects || []
  if (block.projectFilter && block.projectFilter !== 'all') {
    filtered = filtered.filter(p => p.division === block.projectFilter)
  }
  for (const proj of filtered) {
    if (proj.heroImage && typeof proj.heroImage === 'object' && 'url' in proj.heroImage) {
      const media = proj.heroImage as any
      const url = resolveMediaUrl(media)
      if (url) {
        computedTiles.push({
          url,
          alt: media.alt || proj.title,
          caption: proj.title,
          division: proj.division || 'none',
          href: `/work/${proj.slug}`
        })
      }
    }
  }
} else if (isFullFrame) {
  const rawTiles = block.tiles || []
  for (const tile of rawTiles) {
    if (tile.media) {
      const url = resolveMediaUrl(tile.media)
      if (url) {
        computedTiles.push({
          url,
          alt: tile.media.alt || tile.caption || '',
          caption: tile.caption || '',
          division: tile.division || 'none',
          href: undefined
        })
      }
    }
  }
}

const perfsPerFrame = format === 'imax' ? 15 : (isEdgeOnly ? 24 : 4)

function getDivisionClass(div: string) {
  if (div === '212') return 'text-212'
  if (div === '310') return 'text-310'
  if (div === 'nrc') return 'text-nrc'
  return ''
}

// =================================================================
// 1. EXPLICIT MODE DEFINITIONS
// =================================================================
type SegmentMode = 'edge-only' | 'edge-with-image' | 'full-frame' | 'leader-frame';

const isEdgeOnlyFormat = format.startsWith('v2-');

// =================================================================
// 2. LEADER / COUNTDOWN SEQUENCE
// =================================================================
const leaderSequence = [
  { type: 'start', label: 'PICTURE START' },
  { type: 'countdown', label: '8' },
  { type: 'countdown', label: '7' },
  { type: 'countdown', label: '6' },
  { type: 'countdown', label: '5' },
  { type: 'countdown', label: '4' },
  { type: 'countdown', label: '3' },
  { type: 'countdown', label: '2' },
  { type: 'hold', label: '' },
  { type: 'hold', label: '' },
];

const tailSequence = [
  { type: 'hold', label: '' },
  { type: 'hold', label: '' },
  { type: 'end', label: 'PICTURE END' }
];

// SVG assets procedurally defined
const barcodeSvg = `
  <svg class="barcode-svg" viewBox="0 0 52 10" preserveAspectRatio="none">
    <rect x="0" y="0" width="3" height="10" fill="currentColor"/>
    <rect x="5" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="8" y="0" width="2" height="10" fill="currentColor"/>
    <rect x="12" y="0" width="3" height="10" fill="currentColor"/>
    <rect x="17" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="20" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="23" y="0" width="2" height="10" fill="currentColor"/>
    <rect x="27" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="30" y="0" width="3" height="10" fill="currentColor"/>
    <rect x="35" y="0" width="2" height="10" fill="currentColor"/>
    <rect x="39" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="42" y="0" width="2" height="10" fill="currentColor"/>
    <rect x="46" y="0" width="3" height="10" fill="currentColor"/>
    <rect x="51" y="0" width="1" height="10" fill="currentColor"/>
  </svg>
`;

const opticalWaveVerticalTop = "M10,0 L5,0 Q8,2.5 3,5 T4,10 T7,15 T2,20 T8,25 T5,30 T9,35 T3,40 T6,45 T2,50 T8,55 T5,60 T9,65 T4,70 T7,75 T3,80 T8,85 T4,90 T7,95 T2,100 L10,100 Z";
const opticalWaveVerticalBottom = "M10,0 L15,0 Q12,2.5 17,5 T16,10 T13,15 T18,20 T12,25 T15,30 T11,35 T17,40 T14,45 T18,50 T12,55 T15,60 T11,65 T16,70 T13,75 T17,80 T12,85 T16,90 T13,95 T18,100 L10,100 Z";
---

<section 
  class="filmstrip-block" 
  data-format={format}
  data-mode={isEdgeOnlyFormat ? 'edge-only' : 'full-frame'}
  aria-label={isEdgeOnlyFormat ? "Filmstrip rail" : "Filmstrip gallery"}
  role={isEdgeOnlyFormat ? "presentation" : "region"}
>
  <div class="backing-plane" aria-hidden="true"></div>

  <div class="scroll-window" tabindex="0" role="group" aria-label="Slides">
    <div class="film-base-shell">
      
      <div class="film-track">
        
        {/* ================================================================= */}
        {/* MODE: edge-only                                                   */}
        {/* Renders border components strictly separated from frame logic.    */}
        {/* ================================================================= */}
        {isEdgeOnlyFormat && Array.from({ length: 8 }).map((_, i) => (
          <div class="film-segment edge-only-segment" aria-hidden="true">
            {showPerfs && (
              <div class="film-edge top">
                <div class="edge-code-lane top"></div>
                <div class="perf-row top">
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
              </div>
            )}
            
            <div class="edge-code-lane center">
              {i % 2 === 0 && (
                <span class="code code-maroon">KODAK 5219 {83210 + i}·<span class="barcode-wrapper" set:html={barcodeSvg} /></span>
              )}
            </div>

            {showPerfs && (
              <div class="film-edge bottom">
                <div class="perf-row bottom">
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
                <div class="edge-code-lane bottom"></div>
              </div>
            )}
          </div>
        ))}

        {/* ================================================================= */}
        {/* MODE: leader-frame (HEAD)                                         */}
        {/* ================================================================= */}
        {!isEdgeOnlyFormat && leaderSequence.map((item, lIdx) => (
          <div class="film-segment leader-frame-segment">
            {showPerfs && (
              <div class="film-edge top">
                <div class="edge-code-lane top"></div>
                <div class="perf-row top">
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
              </div>
            )}
            
            <div class="leader-plate">
              {item.type === 'countdown' && (
                <div class="leader-target">
                  <div class="target-circle outer"></div>
                  <div class="target-circle inner"></div>
                  <div class="crosshair-v"></div>
                  <div class="crosshair-h"></div>
                  <div class="clock-arm"></div>
                  <div class="leader-numeral">{item.label}</div>
                </div>
              )}
              {item.type === 'start' && (
                <div class="leader-target">
                  <div class="leader-start-text">{item.label}</div>
                </div>
              )}
            </div>

            {showPerfs && (
              <div class="film-edge bottom">
                <div class="perf-row bottom">
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
                <div class="edge-code-lane bottom"></div>
              </div>
            )}
          </div>
        ))}

        {/* ================================================================= */}
        {/* MODE: edge-with-image                                             */}
        {/* Defines the primary content sequence containing media tiles.      */}
        {/* ================================================================= */}
        {!isEdgeOnlyFormat && computedTiles.map((tile, i) => {
          const Element = tile.href ? 'a' : 'div'
          return (
            <Element
              class="film-segment filmstrip-tile"
              href={tile.href}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${computedTiles.length}`}
            >
              {/* TOP PERFORATION BAND & EDGE CODES */}
              {showPerfs && (
                <div class="film-edge top">
                  <div class="edge-code-lane top">
                    {format === 'super35' && i % 4 === 0 && (
                      <span class="code">K KI 03 {1503 + Math.floor(i / 4)} 7040·<span class="barcode-wrapper" set:html={barcodeSvg} /></span>
                    )}
                    {format === 'imax' && i % 8 === 0 && (
                      <span class="code">E KI 03 {4690 + Math.floor(i / 8)} 7040·<span class="barcode-wrapper" set:html={barcodeSvg} /></span>
                    )}

                    {format === 'imax' && i % 8 === 3 && (
                      <span class="code code-small">+40</span>
                    )}
                    {format === 'imax' && i % 8 === 5 && (
                      <span class="code code-small">+80</span>
                    )}
                  </div>
                  <div class="perf-row top">
                    {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                  </div>
                </div>
              )}

              {/* IMAGE APERTURE AND SOUNDTRACK AREA */}
              <div class="frame-assembly">
                
                {/* Print-style soundtrack geometry (vertical, beside image) */}
                {format === 'academy' && (
                  <div class="soundtrack-reservation-area">
                    <svg class="optical-wave-vertical" viewBox="0 0 20 100" preserveAspectRatio="none">
                      <path d={opticalWaveVerticalTop} fill="rgba(0,0,0,0.3)" />
                      <path d={opticalWaveVerticalBottom} fill="rgba(0,0,0,0.3)" />
                    </svg>
                  </div>
                )}

                <div class="image-aperture">
                  <img src={tile.url} alt={tile.alt} loading="lazy" />
                  <div class="wireframe-cross"></div>
                </div>
              </div>

              {/* BOTTOM PERFORATION BAND & EDGE CODES */}
              {showPerfs && (
                <div class="film-edge bottom">
                  <div class="perf-row bottom">
                    {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                  </div>
                  <div class="edge-code-lane bottom">
                    {format === 'academy' && i % 4 === 0 && (
                      <span class="code">K KI 03 {1000 + Math.floor(i / 4)} 7040·<span class="barcode-wrapper" set:html={barcodeSvg} /></span>
                    )}
                    {format === 'widescreen200' && i % 4 === 0 && (
                      <span class="code">ANSCO COLOR 848 {10 + Math.floor(i / 4)}·</span>
                    )}
                    {format === 'imax' && i % 8 === 0 && (
                      <span class="code code-imax-secondary">EASTMAN 5243 025 {("0" + (2401 + Math.floor(i / 8))).slice(-4)} ID</span>
                    )}
                  </div>
                </div>
              )}
            </Element>
          )
        })}

        {/* ================================================================= */}
        {/* MODE: leader-frame (TAIL)                                         */}
        {/* ================================================================= */}
        {!isEdgeOnlyFormat && tailSequence.map((item, lIdx) => (
          <div class="film-segment leader-frame-segment">
            {showPerfs && (
              <div class="film-edge top">
                <div class="edge-code-lane top"></div>
                <div class="perf-row top">
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
              </div>
            )}
            <div class="leader-plate">
              {item.type === 'end' && <div class="leader-start-text">{item.label}</div>}
            </div>
            {showPerfs && (
              <div class="film-edge bottom">
                <div class="perf-row bottom">
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
                <div class="edge-code-lane bottom"></div>
              </div>
            )}
          </div>
        ))}

      </div>

      {/* Meta Track (Titles beneath the film strip) */}
      {isFullFrame && (
        <div class="meta-track">
          <div class="meta-segment" style={`width: calc((${leaderSequence.length} * (var(--frame-w) + var(--frame-gap))) - var(--frame-gap))`}></div>
          {computedTiles.map((tile) => (
            <div class="meta-segment">
              <div class="tile-meta">
                {tile.caption && <span class="tile-caption">{tile.caption}</span>}
                {tile.division !== 'none' && (
                  <span class={`tile-division ${getDivisionClass(tile.division)}`}>{tile.division.toUpperCase()}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

    </div>
  </div>
</section>

<style>
  .filmstrip-block {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: var(--s-7) 0;
    
    /* Default Physical Variables */
    --perfs: 4;
    --hole-w: clamp(8px, 1.2vw, 14px);
    --hole-h: clamp(16px, 2.5vw, 24px);
    --hole-gap: clamp(16px, 2vw, 32px);
    --perf-pitch: calc(var(--hole-w) + var(--hole-gap));
    --segment-w: calc(var(--perf-pitch) * var(--perfs));
    --frame-gap: 4px;
    --code-lane-h: 20px; /* Explicit edge code lane height */
    --perf-band-h: clamp(24px, 3.5vw, 32px); /* Explicit perf row height */
    --hole-radius: var(--r-hole);
    
    /* Shared Sub-blocks */
    --backing-plane: #fbfbf9; /* Clean light table background */
  }

  /* FORMAT DISCIPLINE: Super35 (Negative-forward) */
  .filmstrip-block[data-format="super35"] {
    --aspect: 2.39;
    --support-bg: rgba(200, 110, 30, 0.25); /* Paler warm amber base */
    --edge-band-bg: rgba(160, 70, 10, 0.45); /* Denser latent edge */
    --edge-text: rgba(30, 10, 0, 0.9);
    --track-bg: transparent; /* Negative: frame gaps are unexposed base */
    --aperture-bg: rgba(20, 10, 0, 0.85); /* Solid frame black */
  }

  /* FORMAT DISCIPLINE: Academy (Print-style) */
  .filmstrip-block[data-format="academy"] {
    --frame-gap: 6px;
    --aspect: 1.37;
    --support-bg: rgba(200, 200, 195, 0.2); /* Clear print base */
    --edge-band-bg: rgba(10, 10, 10, 0.85); /* Black print emulsion edge */
    --edge-text: rgba(240, 240, 235, 0.85); /* White text knocked out of black emulsion */
    --track-bg: rgba(10, 10, 10, 0.9); /* Print frame gaps are black emulsion */
    --aperture-bg: rgba(10, 10, 10, 0.95);
  }

  /* FORMAT DISCIPLINE: Widescreen 200 */
  .filmstrip-block[data-format="widescreen200"] {
    --hole-h: clamp(14px, 2vw, 20px);
    --aspect: 2.00;
    --support-bg: rgba(160, 40, 30, 0.25); 
    --edge-band-bg: rgba(120, 20, 15, 0.45);
    --edge-text: rgba(40, 0, 0, 0.9);
    --track-bg: transparent;
    --aperture-bg: rgba(30, 5, 5, 0.85);
  }

  /* FORMAT DISCIPLINE: IMAX 15/70 (Horizontal Transport) */
  .filmstrip-block[data-format="imax"] {
    --perfs: 15;
    --hole-w: clamp(12px, 1.8vw, 18px);
    --hole-h: clamp(18px, 2.8vw, 28px);
    --hole-gap: clamp(24px, 3vw, 40px);
    --code-lane-h: 26px; /* Increased from 22px to prevent dot/barcode clipping */
    --perf-band-h: clamp(28px, 4vw, 36px);
    --hole-radius: 4px;
    --frame-gap: 8px;
    --aspect: 1.43;
    --support-bg: rgba(40, 140, 150, 0.25);
    --edge-band-bg: rgba(20, 100, 110, 0.45);
    --edge-text: rgba(230, 245, 248, 0.95); /* Light text knocked out of cyan band */
    --track-bg: transparent;
    --aperture-bg: rgba(5, 20, 25, 0.85);
  }

  /* EDGE-ONLY MODES */
  .filmstrip-block[data-mode="edge-only"] {
    --perfs: 24;
    --hole-w: 13px;
    --hole-h: 9px;
    --hole-gap: 16px;
    --code-lane-h: 20px;
    --perf-band-h: 24px;
    --support-bg: rgba(0, 0, 0, 0.1);
    --edge-band-bg: rgba(0, 0, 0, 0.2);
    --edge-text: rgba(0, 0, 0, 0.8);
    --backing-plane: #fbfbf9;
    padding: 0;
  }

  /* STRUCTURAL SUB-BLOCKS */
  
  .backing-plane {
    position: absolute;
    inset: 0;
    background: transparent; /* Light box ONLY shows through perf holes now */
    z-index: 0;
  }

  .scroll-window {
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    position: relative;
    z-index: 1;
    padding: 0 var(--pad-x);
  }
  .filmstrip-block[data-mode="full-frame"] .scroll-window {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }

  .scroll-window:focus-visible {
    outline: 2px solid var(--apr-imax);
    outline-offset: 2px;
  }
  .scroll-window::-webkit-scrollbar {
    display: none;
  }

  .film-base-shell {
    display: flex;
    flex-direction: column;
    width: max-content;
    background: var(--support-bg);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1), inset 0 0 15px rgba(255,255,255,0.2);
    border-radius: 2px;
    backdrop-filter: blur(1px); /* Slight diffusion of the backlight */
  }
  .filmstrip-block[data-mode="edge-only"] .film-base-shell {
    box-shadow: none;
    border-radius: 0;
    width: 100vw;
  }

  .film-track {
    display: flex;
    background: var(--track-bg);
    padding: 0 5vw;
  }
  .filmstrip-block[data-mode="edge-only"] .film-track {
    padding: var(--s-3) var(--pad-x);
  }

  .film-segment {
    width: var(--segment-w);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    position: relative;
    scroll-snap-align: center;
    text-decoration: none;
    color: var(--fg-1);
    outline: none;
  }

  .film-edge {
    display: flex;
    flex-direction: column;
    width: var(--segment-w);
  }

  .perf-row {
    display: flex;
    align-items: center;
    height: var(--perf-band-h);
    gap: var(--hole-gap);
    width: 100%;
    position: relative;
    padding: 0 4px;
  }

  .perf-hole {
    width: var(--hole-w);
    height: var(--hole-h);
    background: var(--backing-plane); /* Punches through to the backing plane */
    border-radius: var(--hole-radius);
    flex-shrink: 0;
    box-shadow: inset 0 1px 4px rgba(0,0,0,0.08); /* Soft punch thickness instead of deep black hole */
  }
  .filmstrip-block[data-mode="edge-only"] .perf-hole {
    box-shadow: none;
    border: 1.5px solid var(--rule);
  }

  /* EDGE CODES & KEYKODE */
  .edge-code-lane {
    display: flex;
    height: var(--code-lane-h);
    width: 100%;
    background: var(--edge-band-bg);
    white-space: nowrap;
    overflow: hidden; /* Do not bleed */
    pointer-events: none;
  }
  .edge-code-lane.top { 
    align-items: flex-end;
    padding-bottom: 3px;
  }
  .edge-code-lane.bottom { 
    align-items: flex-start;
    padding-top: 3px;
  }
  .edge-code-lane.center { align-items: center; justify-content: center; }

  .code {
    display: flex;
    align-items: center; /* Enforce common baseline with barcode */
    font-family: var(--font-mono);
    font-size: 11px; /* Realistic print size */
    letter-spacing: 1px;
    color: var(--edge-text);
    text-transform: uppercase;
    margin-left: 24px; /* Explicit physical inset */
    font-weight: 600; /* Realistic print weight */
    line-height: 1;
  }
  .filmstrip-block[data-mode="edge-only"] .code {
    margin-left: 0;
  }
  
  .filmstrip-block[data-format="imax"] .code {
    font-size: 13px;
    letter-spacing: 1.5px;
    font-weight: 700;
  }
  .filmstrip-block[data-format="imax"] .barcode-wrapper {
    height: 10px;
    width: 52px;
  }
  
  .code-imax-secondary {
    transform: rotate(180deg);
    margin-right: 24px;
    margin-left: auto;
  }

  .code-small {
    font-size: 10px;
    margin-left: 24px;
    opacity: 0.8;
  }

  .barcode-wrapper {
    display: block;
    height: 8px; /* Tighter barcode */
    width: 40px;
    margin-left: 10px;
    color: var(--edge-text);
  }
  .barcode-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* FRAME ASSEMBLY (Image + Soundtrack) */
  .frame-assembly {
    display: flex;
    flex-direction: row;
    height: auto;
    width: calc(var(--segment-w) - var(--frame-gap));
    margin-right: var(--frame-gap);
  }

  .soundtrack-reservation-area {
    width: clamp(10px, 2vw, 20px);
    background-color: var(--track-bg); /* Use format variable for soundtrack background */
    border-right: 1px solid rgba(0,0,0,0.1);
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }

  .optical-wave-vertical {
    width: 100%;
    height: 100%;
    display: block;
  }

  .image-aperture {
    position: relative;
    flex-grow: 1;
    height: auto;
    aspect-ratio: var(--aspect);
    overflow: hidden;
    background: var(--aperture-bg); /* Dedicated aperture dense layer */
    border: 1px solid rgba(0,0,0,0.25); /* Defined aperture boundary */
    border-radius: 4px; /* Softer frame corners */
  }

  .image-aperture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
    transition: transform var(--dur-base) var(--ease-out), filter var(--dur-base) var(--ease-out);
  }

  .filmstrip-tile:hover .image-aperture img,
  .filmstrip-tile:focus-visible .image-aperture img {
    transform: scale(1.03);
    filter: saturate(1.15) contrast(1.1);
  }
  .filmstrip-tile:focus-visible .image-aperture {
    outline: 2px solid var(--apr-imax);
    outline-offset: 4px;
  }

  .wireframe-cross {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.15;
    background-image: 
      linear-gradient(to bottom right, transparent calc(50% - 1px), #fff calc(50% - 1px), #fff calc(50% + 1px), transparent calc(50% + 1px)),
      linear-gradient(to top right, transparent calc(50% - 1px), #fff calc(50% - 1px), #fff calc(50% + 1px), transparent calc(50% + 1px));
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* PROCEDURAL LEADER PLATE */
  .leader-plate {
    position: relative;
    width: calc(var(--segment-w) - var(--frame-gap));
    aspect-ratio: var(--aspect);
    margin-right: var(--frame-gap);
