---
import type { DispatchIssueDoc } from '../../lib/payload'

interface Props {
  trades: DispatchIssueDoc['trades']
  calendar: DispatchIssueDoc['calendar']
}

const { trades, calendar } = Astro.props
const tradesList = trades ?? []
const calendarList = calendar ?? []
---

<section class="trades" aria-label="Industry roundup and calendar">
  <div class="trades-main">
    {tradesList.map((t) => (
      <article class="clipping">
        <div class="clipping-pub">
          {t.pub}
          <span>{t.city}</span>
        </div>
        <div class="clipping-body">
          <h3 class="clipping-headline">{t.headline}</h3>
          <p class="clipping-deck">{t.deck}</p>
          <div class="clipping-attr">{t.attr}</div>
        </div>
      </article>
    ))}
  </div>
  <aside class="trades-side">
    <div class="cal">
      <h3 class="cal-head">The Calendar</h3>
      {calendarList.map((c) => (
        <div class="cal-row">
          <span class="cal-row-date">{c.date}</span>
          <span class="cal-row-title">
            {c.title}
            <span>{c.sub}</span>
          </span>
          <span class="cal-row-tag">{c.tag}</span>
        </div>
      ))}
    </div>
  </aside>
</section>
