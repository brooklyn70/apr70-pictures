---
/**
 * PropertySlideshow.astro — v2 StageFilmstrip, reborn in the v4 idiom.
 *
 * A 16:9 stage with a horizontal thumbnail rail beneath it: click a thumb to
 * advance (crossfade), drag the rail with momentum (mouse; touch keeps native
 * scroll), arrow keys navigate, the stage auto-advances on a slow reel clock,
 * and clicking the stage opens a plain fullscreen lightbox. Every plate
 * carries caption + credit (provenance) in the mono counter row.
 *
 * Tokens only (--bg-*, --fg-*, --rule, --accent, --font-*) so all three
 * themes style it automatically. When `items` is empty, a dignified
 * typographic placeholder frame renders instead of an empty hole.
 */

export type SlideshowItem = {
  src: string
  alt: string
  caption?: string | null
  credit?: string | null
}

interface Props {
  items: SlideshowItem[]
  /** Property title — labels the placeholder frame and alt fallbacks. */
  title: string
}

const { items, title } = Astro.props
const count = items.length
const pad = (n: number) => String(n).padStart(2, '0')

/** Per-plate caption/credit for the client script (counter row + lightbox). */
const metaJson = JSON.stringify(
  items.map((item) => ({ caption: item.caption ?? '', credit: item.credit ?? '' })),
)
---

{
  count === 0 ? (
    <div class="pslide-blank" role="img" aria-label={`${title} — gallery plates in preparation`}>
      <span class="pslide-blank__tick pslide-blank__tick--tl" aria-hidden="true" />
      <span class="pslide-blank__tick pslide-blank__tick--tr" aria-hidden="true" />
      <span class="pslide-blank__tick pslide-blank__tick--bl" aria-hidden="true" />
      <span class="pslide-blank__tick pslide-blank__tick--br" aria-hidden="true" />
      <span class="pslide-blank__key">Frame 00 · Plates in preparation</span>
      <span class="pslide-blank__title">{title}</span>
      <span class="pslide-blank__foot">The stills arrive with the deck. The synopsis is the picture for now.</span>
    </div>
  ) : (
    <div class="pslide" data-pslide data-count={count} data-meta={metaJson}>
      <button
        class="pslide__stage"
        type="button"
        data-pslide-stage
        aria-label={`${title} — open plate viewer`}
      >
        {items.map((item, i) => (
          <img
            class="pslide__frame"
            src={item.src}
            alt={item.alt}
            data-pslide-frame
            data-active={i === 0 ? 'true' : 'false'}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        ))}
        <span class="pslide__enlarge" aria-hidden="true">Click to enlarge</span>
      </button>

      <div class="pslide__meta">
        <span class="pslide__counter" data-pslide-counter>{pad(1)} / {pad(count)}</span>
        <span class="pslide__meta-rule" aria-hidden="true" />
        <span class="pslide__caption" data-pslide-caption>{items[0]?.caption ?? ''}</span>
        <span class="pslide__credit" data-pslide-credit>{items[0]?.credit ?? ''}</span>
      </div>

      {count > 1 && (
        <div
          class="pslide__rail"
          data-pslide-rail
          tabindex="0"
          role="listbox"
          aria-label="Plate filmstrip — drag, click, or use arrow keys"
        >
          {items.map((item, i) => (
            <button
              class="pslide__thumb"
              type="button"
              role="option"
              data-pslide-thumb
              data-idx={i}
              data-active={i === 0 ? 'true' : 'false'}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={item.caption ? `${item.caption} — plate ${i + 1}` : `Plate ${i + 1} of ${count}`}
            >
              <img src={item.src} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )}

      {/* Lightbox — plain fullscreen viewer, one plate at a time. */}
      <div class="pslide-box" data-pslide-box hidden>
        <div class="pslide-box__backdrop" data-pslide-box-close aria-hidden="true" />
        <figure class="pslide-box__figure" role="dialog" aria-modal="true" aria-label={`${title} — plate viewer`}>
          <img class="pslide-box__img" data-pslide-box-img src={items[0]?.src} alt={items[0]?.alt} />
          <figcaption class="pslide-box__meta">
            <span class="pslide__counter" data-pslide-box-counter>{pad(1)} / {pad(count)}</span>
            <span class="pslide__meta-rule" aria-hidden="true" />
            <span class="pslide__caption" data-pslide-box-caption>{items[0]?.caption ?? ''}</span>
            <span class="pslide__credit" data-pslide-box-credit>{items[0]?.credit ?? ''}</span>
          </figcaption>
          <button class="pslide-box__nav pslide-box__nav--prev" type="button" data-pslide-box-prev aria-label="Previous plate">&larr;</button>
          <button class="pslide-box__nav pslide-box__nav--next" type="button" data-pslide-box-next aria-label="Next plate">&rarr;</button>
          <button class="pslide-box__close" type="button" data-pslide-box-close aria-label="Close viewer">Close</button>
        </figure>
      </div>
    </div>
  )
}

<style>
  /* ---------- Stage ---------- */
  .pslide__stage {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 1px solid var(--rule);
    background: var(--bg-1);
    cursor: pointer;
    overflow: hidden;
  }

  .pslide__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .pslide__frame[data-active='true'] {
    opacity: 1;
  }

  .pslide__enlarge {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--fg-1);
    background: var(--bg-0);
    border: 1px solid var(--rule-strong);
    padding: 0.6em 1.2em;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-in);
  }
  .pslide__stage:hover .pslide__enlarge,
  .pslide__stage:focus-visible .pslide__enlarge {
    opacity: 0.92;
  }

  /* ---------- Counter / caption / credit row ---------- */
  .pslide__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--rule);
    min-height: 2.2em;
  }

  .pslide__counter {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: var(--track-wider);
    color: var(--accent);
    white-space: nowrap;
  }

  .pslide__meta-rule {
    width: 1px;
    height: 12px;
    background: var(--rule-strong);
    align-self: center;
    flex-shrink: 0;
  }

  .pslide__caption {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--fg-3);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pslide__credit {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    color: var(--fg-4);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ---------- Thumbnail rail ---------- */
  .pslide__rail {
    display: flex;
    gap: var(--s-2);
    padding: var(--s-3) 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .pslide__rail::-webkit-scrollbar {
    display: none;
  }
  .pslide__rail:focus-visible {
    outline: 1px solid var(--rule-strong);
    outline-offset: 2px;
  }

  .pslide__thumb {
    position: relative;
    flex-shrink: 0;
    width: clamp(84px, 10vw, 120px);
    aspect-ratio: 3 / 2;
    padding: 0;
    border: none;
    border-left: 2px solid transparent;
    background: var(--bg-1);
    opacity: 0.45;
    overflow: hidden;
    cursor: pointer;
    transition: opacity var(--dur-quick) var(--ease-in), border-color var(--dur-quick) var(--ease-in);
  }
  .pslide__thumb[data-active='true'] {
    opacity: 1;
    border-left-color: var(--accent);
  }
  .pslide__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    display: block;
  }

  /* ---------- Lightbox ---------- */
  .pslide-box {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
  }
  .pslide-box[hidden] {
    display: none;
  }

  .pslide-box__backdrop {
    position: absolute;
    inset: 0;
    background: var(--bg-0);
    opacity: 0.96;
  }

  .pslide-box__figure {
    position: relative;
    z-index: 1;
    width: min(1200px, calc(100vw - 2 * var(--pad-x)));
    margin: 0;
  }

  .pslide-box__img {
    display: block;
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border: 1px solid var(--rule);
    background: var(--bg-1);
  }

  .pslide-box__meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--rule);
  }

  .pslide-box__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: var(--type-body-lg);
    line-height: 1;
    color: var(--fg-2);
    background: var(--bg-0);
    border: 1px solid var(--rule-strong);
    padding: 0.5em 0.75em;
    cursor: pointer;
    transition: color var(--dur-quick) var(--ease-in), border-color var(--dur-quick) var(--ease-in);
  }
  .pslide-box__nav:hover {
    color: var(--fg-1);
    border-color: var(--fg-3);
  }
  .pslide-box__nav--prev {
    left: calc(-1 * var(--s-3));
  }
  .pslide-box__nav--next {
    right: calc(-1 * var(--s-3));
  }

  .pslide-box__close {
    position: absolute;
    top: calc(-1 * var(--s-7));
    right: 0;
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--fg-3);
    background: transparent;
    border: 1px solid var(--rule-strong);
    padding: 0.6em 1.2em;
    cursor: pointer;
    transition: color var(--dur-quick) var(--ease-in), border-color var(--dur-quick) var(--ease-in);
  }
  .pslide-box__close:hover {
    color: var(--fg-1);
    border-color: var(--fg-3);
  }

  /* ---------- Placeholder frame (empty gallery) ---------- */
  .pslide-blank {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-5);
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule-strong);
    background: var(--bg-1);
    padding: var(--pad-x);
    text-align: center;
  }

  .pslide-blank__tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--rule-strong);
  }
  .pslide-blank__tick--tl { top: 8px; left: 8px; border-top-width: 1px; border-left-width: 1px; }
  .pslide-blank__tick--tr { top: 8px; right: 8px; border-top-width: 1px; border-right-width: 1px; }
  .pslide-blank__tick--bl { bottom: 8px; left: 8px; border-bottom-width: 1px; border-left-width: 1px; }
  .pslide-blank__tick--br { bottom: 8px; right: 8px; border-bottom-width: 1px; border-right-width: 1px; }

  .pslide-blank__key {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--fg-4);
  }

  .pslide-blank__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 5vw, 3.5rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    color: var(--fg-2);
    text-wrap: balance;
  }

  .pslide-blank__foot {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-small);
    color: var(--fg-3);
    max-width: 38ch;
  }
</style>

<script>
  /* v2 StageFilmstrip behaviors, vanilla: crossfade advance, momentum drag on
     the rail (mouse; touch keeps native scroll), slow auto-advance reel,
     arrow keys, lightbox. */

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const AUTO_MS = 5000
  const RESUME_MS = 12000

  function pad(n: number): string {
    return String(n).padStart(2, '0')
  }

  function initSlideshow(root: HTMLElement): void {
    const frames = Array.from(root.querySelectorAll<HTMLImageElement>('[data-pslide-frame]'))
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pslide-thumb]'))
    const rail = root.querySelector<HTMLElement>('[data-pslide-rail]')
    const stage = root.querySelector<HTMLElement>('[data-pslide-stage]')
    const counter = root.querySelector<HTMLElement>('[data-pslide-counter]')
    const captionEl = root.querySelector<HTMLElement>('[data-pslide-caption]')
    const creditEl = root.querySelector<HTMLElement>('[data-pslide-credit]')
    const box = root.querySelector<HTMLElement>('[data-pslide-box]')
    const boxImg = root.querySelector<HTMLImageElement>('[data-pslide-box-img]')
    const boxCounter = root.querySelector<HTMLElement>('[data-pslide-box-counter]')
    const boxCaption = root.querySelector<HTMLElement>('[data-pslide-box-caption]')
    const boxCredit = root.querySelector<HTMLElement>('[data-pslide-box-credit]')

    const count = frames.length
    if (count === 0) return

    // Per-plate caption/credit, serialized by the component at render time.
    let meta: Array<{ caption: string; credit: string }> = []
    try {
      meta = JSON.parse(root.getAttribute('data-meta') ?? '[]') as Array<{ caption: string; credit: string }>
    } catch {
      meta = []
    }

    let active = 0
    let boxOpen = false
    let autoTimer: number | null = null
    let resumeTimer: number | null = null
    let hovering = false

    function setText(el: HTMLElement | null, text: string): void {
      if (el) el.textContent = text
    }

    function syncMeta(idx: number): void {
      const m = meta[idx] ?? { caption: '', credit: '' }
      setText(counter, `${pad(idx + 1)} / ${pad(count)}`)
      setText(captionEl, m.caption)
      setText(creditEl, m.credit)
      if (boxOpen) {
        const frame = frames[idx]
        if (boxImg && frame) {
          boxImg.src = frame.src
          boxImg.alt = frame.alt
        }
        setText(boxCounter, `${pad(idx + 1)} / ${pad(count)}`)
        setText(boxCaption, m.caption)
        setText(boxCredit, m.credit)
      }
    }

    function centerThumb(idx: number): void {
      const railEl = rail
      const thumb = thumbs[idx]
      if (!railEl || !thumb) return
      railEl.scrollTo({
        left: thumb.offsetLeft - railEl.offsetWidth / 2 + thumb.offsetWidth / 2,
        behavior: REDUCED ? 'auto' : 'smooth',
      })
    }

    function advance(next: number, fromUser: boolean): void {
      const idx = ((next % count) + count) % count
      if (idx === active && fromUser === false) return
      frames.forEach((f, i) => f.setAttribute('data-active', i === idx ? 'true' : 'false'))
      thumbs.forEach((t, i) => {
        t.setAttribute('data-active', i === idx ? 'true' : 'false')
        t.setAttribute('aria-selected', i === idx ? 'true' : 'false')
      })
      active = idx
      syncMeta(idx)
      centerThumb(idx)
      if (fromUser) suspendAuto()
    }

    /* ---- Auto-advance reel ---- */
    function startAuto(): void {
      if (REDUCED || count < 2) return
      stopAuto()
      autoTimer = window.setInterval(() => {
        if (!hovering && !boxOpen && !document.hidden) advance(active + 1, false)
      }, AUTO_MS)
    }
    function stopAuto(): void {
      if (autoTimer !== null) {
        window.clearInterval(autoTimer)
        autoTimer = null
      }
    }
    function suspendAuto(): void {
      stopAuto()
      if (resumeTimer !== null) window.clearTimeout(resumeTimer)
      resumeTimer = window.setTimeout(startAuto, RESUME_MS)
    }

    root.addEventListener('pointerenter', () => {
      hovering = true
    })
    root.addEventListener('pointerleave', () => {
      hovering = false
    })

    /* ---- Momentum drag on the rail (mouse only; touch scrolls natively) ---- */
    if (rail) {
      let dragging = false
      let moved = false
      let startX = 0
      let startScroll = 0
      let vel = 0
      let lastX = 0
      let lastT = 0
      let clickIdx = -1
      let inertia: number | null = null

      const stopInertia = (): void => {
        if (inertia !== null) {
          cancelAnimationFrame(inertia)
          inertia = null
        }
      }

      const startInertia = (v0: number): void => {
        if (REDUCED) return
        stopInertia()
        let v = v0
        const tick = (): void => {
          v *= 0.95
          rail.scrollLeft += v
          const max = rail.scrollWidth - rail.clientWidth
          if (Math.abs(v) < 0.5 || rail.scrollLeft <= 0 || rail.scrollLeft >= max) {
            stopInertia()
            return
          }
          inertia = requestAnimationFrame(tick)
        }
        inertia = requestAnimationFrame(tick)
      }

      rail.addEventListener('pointerdown', (e: PointerEvent) => {
        if (e.pointerType === 'touch') return
        stopInertia()
        rail.setPointerCapture(e.pointerId)
        dragging = true
        moved = false
        startX = e.clientX
        startScroll = rail.scrollLeft
        vel = 0
        lastX = e.clientX
        lastT = performance.now()
        const btn = (e.target as HTMLElement).closest('[data-idx]')
        clickIdx = btn ? Number.parseInt((btn as HTMLElement).dataset.idx ?? '-1', 10) : -1
        rail.style.cursor = 'grabbing'
      })

      rail.addEventListener('pointermove', (e: PointerEvent) => {
        if (!dragging) return
        const dx = startX - e.clientX
        if (Math.abs(dx) > 5) {
          moved = true
          rail.scrollLeft = startScroll + dx
        }
        const now = performance.now()
        const dt = now - lastT
        if (dt > 0) {
          vel = vel * 0.6 + (-(e.clientX - lastX) / dt) * 16 * 0.4
        }
        lastX = e.clientX
        lastT = now
      })

      const endDrag = (): void => {
        if (!dragging) return
        dragging = false
        rail.style.cursor = 'grab'
        if (!moved) {
          if (clickIdx >= 0) advance(clickIdx, true)
        } else if (Math.abs(vel) > 1) {
          startInertia(vel)
        }
      }
      rail.addEventListener('pointerup', endDrag)
      rail.addEventListener('pointercancel', endDrag)

      rail.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault()
          advance(active - 1, true)
        } else if (e.key === 'ArrowRight') {
          e.preventDefault()
          advance(active + 1, true)
        }
      })

      // Touch taps bypass pointer capture — plain click handles them.
      thumbs.forEach((t) => {
        t.addEventListener('click', () => {
          const idx = Number.parseInt(t.dataset.idx ?? '-1', 10)
          if (idx >= 0) advance(idx, true)
        })
      })
    }

    /* ---- Lightbox ---- */
    function openBox(): void {
      if (!box) return
      boxOpen = true
      box.hidden = false
      document.body.style.overflow = 'hidden'
      syncMeta(active)
    }
    function closeBox(): void {
      if (!box) return
      boxOpen = false
      box.hidden = true
      document.body.style.overflow = ''
    }

    stage?.addEventListener('click', () => {
      openBox()
      suspendAuto()
    })
    root.querySelectorAll<HTMLElement>('[data-pslide-box-close]').forEach((el) => {
      el.addEventListener('click', closeBox)
    })
    root.querySelector<HTMLElement>('[data-pslide-box-prev]')?.addEventListener('click', () => advance(active - 1, true))
    root.querySelector<HTMLElement>('[data-pslide-box-next]')?.addEventListener('click', () => advance(active + 1, true))

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!boxOpen) return
      if (e.key === 'Escape') closeBox()
      else if (e.key === 'ArrowLeft') advance(active - 1, true)
      else if (e.key === 'ArrowRight') advance(active + 1, true)
    })

    startAuto()
  }

  document.querySelectorAll<HTMLElement>('[data-pslide]').forEach(initSlideshow)
</script>
