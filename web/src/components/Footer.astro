---
/**
 * Footer.astro — site footer + V4 colophon.
 *
 * Top: 4-column nav (brand / primary / divisions / more) from Payload globals
 * (graceful fallback if Payload is unreachable).
 * Colophon: the six marks of the house at real, fixed scale (--colophon-mark-h
 * — deliberately independent of --logo-h/the control-panel size dial), the
 * quiet investor line, the Draft-3 boilerplate VERBATIM, the division wordlist,
 * and the Long Island City address line.
 */
import type { SiteSettingsData, FooterLinksData } from '../lib/payload'
import { V4_FOOTER } from '../content/v4'

interface Props {
  settings?: SiteSettingsData | null
  footerLinks?: FooterLinksData | null
  footerLogoSrc?: string
  footerLogoAlt?: string
}

const { settings, footerLinks, footerLogoSrc, footerLogoAlt } = Astro.props

const brand      = settings?.brandLabel  ?? 'APR 70 Pictures'
const legal      = settings?.legalEntity ?? 'APR 70 Pictures LLC'
const year       = new Date().getFullYear()

const primaryNav  = footerLinks?.primaryNav  ?? []
const divisionNav = footerLinks?.divisionNav ?? []
const moreNav     = footerLinks?.moreNav     ?? []

/* Six marks of the house — real committed assets. Monochrome marks (wordmark +
   sprocket) render both inks; the [data-theme] toggle (global CSS below) shows
   the correct one with no flash (data-theme is stamped pre-paint). */
const marks = [
  { kind: 'mono', dark: '/logos/apr70_logo_full_white.svg', light: '/logos/apr70_logo_full_black.svg', alt: 'APR 70 Pictures wordmark' },
  { kind: 'color', src: '/brand/apr70-logos/apr70-apr70pictures/monogram/apr70_monogram_orange_v5.svg', alt: 'APR 70 monogram' },
  { kind: 'color', src: '/brand/apr70-logos/212-pictures/212_footer.svg', alt: '(212) Pictures' },
  { kind: 'color', src: '/brand/apr70-logos/310-pictures/310_footer.svg', alt: '(310) Pictures' },
  { kind: 'color', src: '/brand/apr70-logos/new-renaissance-cinema/nrc_footer.svg', alt: 'New Renaissance Cinema' },
  { kind: 'mono', dark: '/brand/apr70-logos/apr70-apr70pictures/monogram/apr70_monogram_white_orange_sprockets_v5.svg', light: '/brand/apr70-logos/apr70-apr70pictures/monogram/apr70_monogram_black_orange_sprockets_v5.svg', alt: 'APR 70 sprocket monogram' },
] as const
---

<footer class="site-footer" role="contentinfo" aria-label="Site footer">
  <!-- Filmstrip top rail -->
  <div class="footer__rail" aria-hidden="true">
    {Array.from({ length: 24 }).map(() => (
      <span class="sprocket" />
    ))}
  </div>

  <div class="footer__inner container">
    <!-- Col 1: Brand -->
    <div class="footer__col footer__col--brand">
      {footerLogoSrc ? (
        <a href="/" class="footer__logo-link" aria-label={footerLogoAlt ?? brand}>
          <img class="footer__logo" src={footerLogoSrc} alt={footerLogoAlt ?? brand} loading="lazy" />
        </a>
      ) : (
        <p class="footer__logotype">{brand}</p>
      )}
      <p class="footer__copy">
        &copy; {year} {legal}<br />All rights reserved.
      </p>
    </div>

    <!-- Col 2: Primary nav -->
    <nav class="footer__col footer__col--nav" aria-label="Footer primary navigation">
      <p class="footer__col-heading">Navigate</p>
      {primaryNav.length > 0 ? (
        <ul class="footer__links" role="list">
          {primaryNav.map((link) => (
            <li>
              <a class="footer__link" href={link.href}
                target={link.openInNewTab ? '_blank' : undefined}
                rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="footer__links" role="list">
          <li><a class="footer__link" href="/work">Slate</a></li>
          <li><a class="footer__link" href="/troupe">Troupe</a></li>
          <li><a class="footer__link" href="/about">About</a></li>
          <li><a class="footer__link" href="/contact">Contact</a></li>
        </ul>
      )}
    </nav>

    <!-- Col 3: Divisions -->
    <nav class="footer__col footer__col--divisions" aria-label="Footer divisions navigation">
      <p class="footer__col-heading">Divisions</p>
      {divisionNav.length > 0 ? (
        <ul class="footer__links" role="list">
          {divisionNav.map((link) => (
            <li>
              <a class="footer__link" href={link.href}
                target={link.openInNewTab ? '_blank' : undefined}
                rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="footer__links" role="list">
          {V4_FOOTER.divisions.map((d) => (
            <li><a class="footer__link" href={d.href}>{d.label}</a></li>
          ))}
        </ul>
      )}
    </nav>

    <!-- Col 4: More + legal -->
    <div class="footer__col footer__col--more">
      <nav aria-label="Footer more links">
        <p class="footer__col-heading">More</p>
        {moreNav.length > 0 ? (
          <ul class="footer__links" role="list">
            {moreNav.map((link) => (
              <li>
                <a class="footer__link" href={link.href}
                  target={link.openInNewTab ? '_blank' : undefined}
                  rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        ) : (
          <ul class="footer__links" role="list">
            <li><a class="footer__link" href="/news">Dispatch</a></li>
            <li><a class="footer__link" href="/pitch">Pitch</a></li>
            <li><a class="footer__link" href="/jobs">Careers</a></li>
          </ul>
        )}
      </nav>

      <!-- Static legal row -->
      <div class="footer__legal">
        <a class="footer__link footer__link--legal" href="/privacy">Privacy</a>
        <span class="footer__legal-sep" aria-hidden="true">/</span>
        <a class="footer__link footer__link--legal" href="/terms">Terms</a>
      </div>
    </div>
  </div>

  <!-- Colophon: the marks of the house, at real scale -->
  <section class="footer__colophon container" aria-label="The marks of the house">
    <p class="footer__colophon-head">The marks of the house</p>
    <div class="footer__marks">
      {marks.map((m) => (
        m.kind === 'mono' ? (
          <Fragment>
            <img class="footer__mark footer-mark--dark" src={m.dark} alt={m.alt} loading="lazy" />
            <img class="footer__mark footer-mark--light" src={m.light} alt={m.alt} loading="lazy" />
          </Fragment>
        ) : (
          <img class="footer__mark" src={m.src} alt={m.alt} loading="lazy" />
        )
      ))}
    </div>
  </section>

  <!-- Quiet investor line (SPEC + Draft 3) -->
  <p class="footer__investor container">Investor conversations happen in person. Write to the offices.</p>

  <!-- V4 boilerplate (VERBATIM) + division wordlist + address -->
  <div class="footer__boilerplate container">
    <p class="footer__boiler">{V4_FOOTER.studioLine}</p>
    <p class="footer__wordlist">
      {V4_FOOTER.divisions.map((d, i) => (
        <Fragment>
          {i > 0 && <span class="footer__wordlist-sep" aria-hidden="true"> | </span>}
          <span>{d.label} &middot; {d.meta}</span>
        </Fragment>
      ))}
    </p>
    <p class="footer__address">{V4_FOOTER.addressLine}</p>
  </div>

  <!-- Filmstrip bottom rail -->
  <div class="footer__rail footer__rail--bottom" aria-hidden="true">
    {Array.from({ length: 24 }).map(() => (
      <span class="sprocket" />
    ))}
  </div>
</footer>

<!-- Mode-aware monochrome marks (global: data-theme lives on <html>). -->
<style is:global>
  [data-theme='dark'] .footer-mark--light { display: none; }
  [data-theme='light'] .footer-mark--dark { display: none; }
</style>

<style>
  /* ── Shell ──────────────────────────────────────────────────────────────── */
  .site-footer {
    margin-top: var(--s-11);
    border-top: 1px solid var(--rule);
  }

  .footer__rail {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 14px;
    height: var(--filmstrip-h);
    background: #050505;
    overflow: hidden;
  }

  .footer__rail--bottom {
    border-top: 1px solid var(--bg-3);
    margin-top: var(--s-9);
  }

  /* ── Grid ───────────────────────────────────────────────────────────────── */
  .footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--s-8) var(--s-7);
    padding-block: var(--s-9);
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 540px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }

  /* ── Brand column ───────────────────────────────────────────────────────── */
  .footer__logotype {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--type-h4);
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    color: var(--fg-1);
    margin: 0 0 var(--s-3);
  }

  .footer__logo-link {
    display: inline-block;
    margin-bottom: var(--s-3);
  }

  .footer__logo {
    display: block;
    max-height: clamp(2rem, 4vw, 3rem);
    width: auto;
  }

  .footer__copy {
    font-family: var(--font-body);
    font-size: var(--type-caption);
    color: var(--fg-5);
    line-height: var(--leading-body);
    margin: 0;
  }

  /* ── Nav columns ────────────────────────────────────────────────────────── */
  .footer__col-heading {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--type-micro);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--fg-4);
    margin: 0 0 var(--s-5);
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .footer__link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--type-small);
    color: var(--fg-3);
    text-decoration: none;
    letter-spacing: var(--track-wide);
    transition: color var(--dur-base) var(--ease-in);
  }

  .footer__link:hover {
    color: var(--fg-1);
  }
  .footer__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ── Legal row ──────────────────────────────────────────────────────────── */
  .footer__legal {
    margin-top: var(--s-7);
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .footer__link--legal {
    font-size: var(--type-caption);
    color: var(--fg-5);
  }

  .footer__link--legal:hover {
    color: var(--fg-3);
  }

  .footer__legal-sep {
    color: var(--fg-6);
    font-size: var(--type-caption);
  }

  /* ── Colophon marks ─────────────────────────────────────────────────────── */
  .footer__colophon {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-8);
    padding-bottom: var(--s-8);
    text-align: center;
  }
  .footer__colophon-head {
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-strip);
    text-transform: uppercase;
    color: var(--fg-5);
    margin: 0 0 var(--s-7);
  }
  .footer__marks {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    flex-wrap: wrap;
  }
  .footer__mark {
    /* Real scale, fixed — INDEPENDENT of the "Logo size" dial (--logo-h),
       which governs the nav/brand mark only. The colophon is the house
       signature and must never read as a chip. Wide lockups (NRC, divisions)
       cap on width to keep the row balanced; aspect is preserved. */
    height: var(--colophon-mark-h);
    width: auto;
    max-width: clamp(120px, 22vw, 260px);
    object-fit: contain;
    opacity: 0.9;
    transition: opacity var(--dur-base) var(--ease-in), transform var(--dur-base) var(--ease-out);
  }
  .footer__mark:hover {
    opacity: 1;
    transform: translateY(-4px);
  }

  /* ── Quiet investor line ────────────────────────────────────────────────── */
  .footer__investor {
    text-align: center;
    padding-top: 0;
    padding-bottom: var(--s-7);
    font-family: var(--font-body);
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    color: var(--fg-4);
    margin: 0;
  }

  /* ── Boilerplate ────────────────────────────────────────────────────────── */
  .footer__boilerplate {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-7);
    padding-bottom: var(--s-5);
    text-align: center;
  }
  .footer__boiler {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1rem, 2.2vw, 1.4rem);
    letter-spacing: 0.02em;
    color: var(--fg-1);
    margin: 0;
  }
  .footer__wordlist {
    margin: var(--s-5) 0 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-4);
  }
  .footer__wordlist-sep {
    color: var(--fg-6);
    padding: 0 var(--s-1);
  }
  .footer__address {
    margin: var(--s-4) 0 0;
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--fg-5);
  }
</style>
