---
/**
 * foundingRoll — the Founding Roll enrollment fold (v10, catalog 1.3).
 * The site's first public transaction: a numbered, free, never-reissued
 * roll (v5 business-design lineage). Copy comes from the CMS block; the
 * count renders server-side when showCount is on; the form is an island.
 */
import type { V9Section } from '../../../lib/payload'
import { fetchRollCount } from '../../../lib/payload'
import RollFormIsland from '../../islands/RollFormIsland'

type FoundingRollData = Extract<V9Section, { blockType: 'foundingRoll' }>
const section = Astro.props.section as FoundingRollData

const heading = section.heading ?? 'The Founding Roll.'
const body = section.body ?? ''
const submitLabel = section.submitLabel ?? 'Take a number'
const successNote = section.successNote ?? 'You are on the roll.'
const showCount = section.showCount ?? true

/* ── THE FLOOR (v11, Marco 2026-07-13) ───────────────────────────────────────
   The site shipped a counter reading "1 NAME ON THE ROLL". It was the only
   number published anywhere on the site, and it said nobody was here. All five
   investors on the panel called for its head, unanimously and independently.

     Selznick: "A public counter reading 1 is not a low number, it is an empty
                room. Scarcity reads as design. Emptiness reads as failure."

   A CMS checkbox alone would not have saved us, because the checkbox was ON and
   the number still shipped. So the floor lives in code: below it, the count is
   not rendered at all, whatever the switch says. The roll, the numbering and the
   copy are untouched ... "the numbers start low, stay yours, and are never
   reissued" was the line every investor praised. Only the scoreboard goes. */
const ROLL_COUNT_FLOOR = 100

const rawCount = showCount ? await fetchRollCount() : null
const count = rawCount !== null && rawCount >= ROLL_COUNT_FLOOR ? rawCount : null
const source = Astro.url.pathname || '/'

/* body: plain paragraphs on blank lines; **bold** and ==highlight== */
const paragraphs = body
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean)
const renderInline = (t: string) =>
  t
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/==([^=]+)==/g, '<mark>$1</mark>')
---

<section class="v9-section v9-roll" aria-label="The Founding Roll">
  <div class="v9-col">
    {
      (section.scene || section.sceneSlug) && (
        <div class="v9-scene">
          {section.scene && <span class="v9-scene__num">{section.scene}</span>}
          {section.sceneSlug && <span class="v9-scene__slug">{section.sceneSlug}</span>}
        </div>
      )
    }
    <h2 class="v9-textfold__heading">{heading}</h2>
    {count !== null && (
      <p class="v9-roll__count">{count} names on the roll</p>
    )}
    {paragraphs.map((p) => (
      <p class="v9-prose" set:html={renderInline(p)} />
    ))}
    <RollFormIsland client:visible submitLabel={submitLabel} successNote={successNote} source={source} />
  </div>
</section>
