  "projectQuotes": [
    {
      "id": "69fea1c41bb910d5d8a36aa6",
      "quote": "You fight for the truth in a newspaper. I fight for it in the history books. Guess which one lasts longer.",
      "author": "Mario Chigi"
    },
    {
      "id": "69fea1c41bb910d5d8a36aa7",
      "quote": "The difference between an heir and a victim is knowing which curse to break.",
      "author": "Aimee Pearl Chigi"
    },
    {
      "id": "69fea1c41bb910d5d8a36aa8",
      "quote": "In the age of live streams, a lie is just a moment. But a typewriter leaves a receipt.",
      "author": "Marcello di Bari"
    },
    {
      "id": "69fea1c41bb910d5d8a36aa9",
      "quote": "A mother's guilt isn't an emotion. It's a habit. And I'm trying to break it.",
      "author": "Elizabeth Hartly"
    },
    {
      "id": "69fea1c41bb910d5d8a36aaa",
      "quote": "You see a fire-ravaged city. I see a network that needs rebooting. Either way, something gets cleared out.",
      "author": "Koko Yi-Kim"
    },
    {
      "id": "69fea1c41bb910d5d8a36aab",
      "quote": "There is no ruin. There is only a pivot. And my next act will be flawless.",
      "author": "Senator Jamie Thomson"
    },
    {
      "id": "69fea1c41bb910d5d8a36aac",
      "quote": "Silence says more than words in this town. You just have to know which silence to listen to.",
      "author": "General Noir"
    }
  ],
