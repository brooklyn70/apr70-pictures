---
/**
 * V9Layout — the v9 public front door chrome, wearing the v8 design
 * (Marco's reversal, 2026-07-11). ONE visual design; the mode is v8's
 * three-way switch on <html> data-theme:
 *   absent            = System (follows prefers-color-scheme)
 *   data-theme="dark" = Marquee Night (default look)
 *   data-theme="light"= House Lights
 * Persisted as localStorage apr70-theme (dark | light | system), stamped
 * pre-paint below so nothing flashes. Type size (v8 steps, html[data-scale])
 * and logo size (--logo-h px) ride the same stamp. Header nav and footer
 * come from site-settings.v9Chrome; page metadata + JSON-LD arrive as props.
 * Plain MPA (no ClientRouter): every v9 page stands alone.
 */
import '../styles/global.css'
import '../styles/v9.css'
import '../styles/themes/index.css'
import ThemeControlIsland from '../components/islands/ThemeControlIsland'
import ScrollTopIsland from '../components/islands/ScrollTopIsland'
import { fetchV9Chrome } from '../lib/payload'
import { LOGO_SIZE } from '../designs/manifest'
import { organizationJsonLd, webSiteJsonLd, canonical, V9_PAGES, NAP } from '../lib/v9/site'

interface Props {
  title: string
  description?: string
  /** Page-specific JSON-LD blocks (Organization + WebSite are always injected). */
  jsonLd?: Record<string, unknown>[]
}

const { title, description = NAP.description, jsonLd = [] } = Astro.props

const { chrome } = await fetchV9Chrome()
const navLinks =
  chrome.navLinks && chrome.navLinks.length > 0
    ? chrome.navLinks
    : V9_PAGES.map((p) => ({ href: p.path, label: p.label }))

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const canonicalUrl = canonical(path)

const logoDefaults = { min: LOGO_SIZE.min, max: LOGO_SIZE.max, def: LOGO_SIZE.default }

const jsonLdAll = [organizationJsonLd(), webSiteJsonLd(), ...jsonLd]

/* The Display panel's three theme choices are v8's MODES. The CMS fields
   carry the labels (re-seeded 2026-07-11): themePremiere = "Marquee night"
   (dark), themeMatinee = "House lights" (light), themeLateshow = "System". */
const panelLabels = {
  displayLabel: chrome.displayLabel,
  panelTitle: chrome.panelTitle,
  themeLabel: chrome.themeLabel,
  scaleLabel: chrome.scaleLabel,
  logoLabel: chrome.logoLabel,
  themeNames: {
    dark: chrome.themePremiere,
    light: chrome.themeMatinee,
    system: chrome.themeLateshow,
  },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ logoDefaults }}>
      /* v8 pre-paint stamp — runs before first paint, no FOUC.
         apr70-theme: dark | light | system (anything else = system, which
         means NO data-theme attribute so prefers-color-scheme decides). */
      ;(function () {
        var doc = document.documentElement
        doc.classList.add('js')
        function read(key) {
          try { return localStorage.getItem(key) } catch (e) { return null }
        }
        var theme = read('apr70-theme')
        if (theme === 'dark' || theme === 'light') doc.setAttribute('data-theme', theme)
        else doc.removeAttribute('data-theme')

        var scales = { s: 1, m: 1, l: 1, xl: 1 }
        var scale = read('apr70:font-scale')
        if (!scale || !scales[scale]) scale = 'm'
        doc.setAttribute('data-scale', scale)

        var size = parseInt(read('apr70:logo-size'), 10)
        if (!isFinite(size)) size = logoDefaults.def
        if (size < logoDefaults.min) size = logoDefaults.min
        if (size > logoDefaults.max) size = logoDefaults.max
        doc.setAttribute('data-logo-size', String(size))
        doc.style.setProperty('--logo-h', size + 'px')
      })()
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site summary" />
    <link
      rel="preload"
      href="/fonts/Fraunces-normal-300-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Fraunces-italic-300-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={NAP.name} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0604" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f1e9" />
    {jsonLdAll.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="v9">
    <header class="v9-header">
      <div class="v9-col v9-header__row">
        <a class="v9-brand" href="/" aria-label={NAP.name}>
          <img
            class="v9-brand__mark"
            data-mark-ink="light"
            src="/logos/apr70_logo_full_white.svg"
            alt={NAP.name}
          />
          <img
            class="v9-brand__mark"
            data-mark-ink="dark"
            src="/logos/apr70_logo_full_black.svg"
            alt=""
            aria-hidden="true"
          />
        </a>
        <nav class="v9-nav" aria-label="Primary">
          {navLinks.map((link) => (
            <a
              class="v9-nav__link"
              href={link.href}
              aria-current={(link.href === '/' ? path === '/' : path.startsWith(link.href)) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="v9-footer">
      <div class="v9-col">
        <nav class="v9-footer__nav" aria-label="Footer">
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        {chrome.colophon && <p class="v9-footer__colophon">{chrome.colophon}</p>}
        <p class="v9-footer__copy">{chrome.copyright}</p>
      </div>
    </footer>

    <ThemeControlIsland client:load labels={panelLabels} />
    <ScrollTopIsland client:load label={chrome.topLabel} />

    <script is:inline>
      /* v8 reveal-once-on-scroll, applied to the v9 folds. Progressive
         enhancement: without JS nothing is ever hidden (the .reveal class is
         only added here, and the hiding CSS is gated on html.js). */
      ;(function () {
        var els = document.querySelectorAll('main .v9-section, main .v9-photofold, main .v9-prophead')
        els.forEach(function (el, i) {
          el.classList.add('reveal')
          el.style.setProperty('--i', String(i % 3))
        })
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in') })
          return
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in')
                io.unobserve(e.target)
              }
            })
          },
          { rootMargin: '0px 0px -8% 0px' },
        )
        els.forEach(function (el) { io.observe(el) })
      })()
    </script>
  </body>
</html>
