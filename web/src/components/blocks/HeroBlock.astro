---
import type { Home } from 'payload-types'

import { resolveMediaUrl } from '../../lib/payload'
import HeroSliderIsland from '../islands/HeroSliderIsland'

type HeroBlockData = Extract<
  NonNullable<NonNullable<Home['layout']>[number]>,
  { blockType: 'hero' }
>

interface Props {
  block: HeroBlockData
}

const { block } = Astro.props

const media = typeof block.media === 'object' && block.media ? block.media : null
const mediaSrc = resolveMediaUrl(media ?? undefined)
const isVideo = Boolean(media?.mimeType?.startsWith('video/'))

const divisionClass =
  block.division === 'pictures-212'
    ? 'hero--212'
    : block.division === 'pictures-310'
      ? 'hero--310'
      : 'hero--corporate'

const variantClass =
  block.variant === 'split'
    ? 'hero--split'
    : block.variant === 'fullscreen'
      ? 'hero--fullscreen'
      : block.variant === 'slider-auto' || block.variant === 'slider-curated'
        ? `hero--${block.variant}`
        : 'hero--default'

const isSlider = block.variant === 'slider-auto' || block.variant === 'slider-curated'

let slides: any[] = []

if (isSlider) {
  if (block.variant === 'slider-curated') {
    // We added sliderItems in payload schema
    const curatedItems = (block as any).sliderItems || []
    slides = curatedItems.map((item: any) => ({
      id: item.id || Math.random().toString(),
      title: item.title || '',
      subtext: item.subtext || '',
      mediaSrc: typeof item.media === 'object' ? resolveMediaUrl(item.media) : undefined,
      mediaAlt: typeof item.media === 'object' ? item.media?.alt : '',
    }))
  } else if (block.variant === 'slider-auto') {
    const { fetchProjects } = await import('../../lib/payload')
    const { projects } = await fetchProjects()
    slides = projects.filter(p => p.heroImage).slice(0, 4).map(p => ({
      id: String(p.id),
      title: p.title,
      subtext: p.subtitle ?? '',
      mediaSrc: resolveMediaUrl(p.heroImage as any),
      mediaAlt: typeof p.heroImage === 'object' && p.heroImage ? (p.heroImage as any).alt : '',
    }))
  }
}
---

<section
  class:list={['hero', divisionClass, variantClass]}
  aria-labelledby={`hero-heading-${block.id ?? 'x'}`}
>
  {isSlider ? (
    <HeroSliderIsland
      client:idle
      slides={slides}
      fadeDuration={block.fadeDuration ?? 700}
      autoplayDelay={block.autoplayDelay ?? 5000}
      showIndicator={block.showIndicator ?? true}
      baseHeading={block.heading}
      baseSubtext={block.subtext}
    />
  ) : (
    <div class="hero__inner">
      <div class="hero__copy">
        <h1 id={`hero-heading-${block.id ?? 'x'}`} class="hero__heading">{block.heading}</h1>
        {block.subtext ? <p class="hero__subtext">{block.subtext}</p> : null}
      </div>
      {
        mediaSrc ? (
          <div class="hero__media">
            {isVideo ? (
              <video class="hero__video" controls preload="metadata" src={mediaSrc} />
            ) : (
              <img
                class="hero__img"
                src={mediaSrc}
                alt={media?.alt ?? ''}
                width={media?.width ?? undefined}
                height={media?.height ?? undefined}
              />
            )}
          </div>
        ) : null
      }
    </div>
  )}
</section>

<style>
  .hero {
    font-family: var(--font-body);
    padding: var(--s-8) var(--s-3);
    box-sizing: border-box;
    width: 100%;
  }

  .hero__inner {
    max-width: var(--max-content);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .hero--split .hero__inner {
    display: grid;
    gap: var(--s-6);
  }

  @media (min-width: 768px) {
    .hero--split .hero__inner {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--s-8);
    }
  }

  .hero--fullscreen {
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .hero--fullscreen .hero__inner {
    width: 100%;
  }

  .hero--slider-auto,
  .hero--slider-curated {
    padding: 0;
  }

  .hero__heading {
    font-family: var(--font-display);
    font-size: var(--type-h1);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-tight);
    margin: 0;
    text-transform: uppercase;
    color: var(--hero-heading, var(--fg-1));
  }

  .hero__subtext {
    margin: var(--s-3) 0 0;
    font-size: var(--type-body-lg);
    font-weight: 300;
    line-height: var(--leading-loose);
    color: var(--hero-sub, var(--fg-3));
    max-width: 36rem;
  }

  .hero__media {
    width: 100%;
  }

  .hero__img,
  .hero__video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-none);
  }

  .hero--212 {
    --hero-heading: var(--apr-amber);
    --hero-sub: var(--fg-3);
  }

  .hero--310 {
    --hero-heading: var(--apr-imax);
    --hero-sub: var(--fg-3);
  }

  .hero--corporate {
    --hero-heading: var(--fg-1);
    --hero-sub: var(--fg-3);
  }
</style>
