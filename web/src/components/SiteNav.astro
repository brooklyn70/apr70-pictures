---
/**
 * SiteNav.astro — global chrome navigation (T1 house treatment).
 *
 * Numbered links, mono numerals, underline-draw hover, orange (accent) active.
 * The brand mark renders at var(--logo-h) (visitor "Logo size" dial) and is the
 * swappable global wordmark (data-brand-wordmark) — the pre-paint stamp + the
 * control panel keep its src in sync with the picked mark + effective mode.
 *
 * Styles are `is:global` on purpose: Wave C themes restyle the nav via
 * `[data-design="<slug>"] .site-nav*` overrides (higher specificity than the
 * base class) without touching this structure. Zero JS — the one-time nav
 * settle is added by src/lib/motion/screening-room.ts; hover/active are CSS.
 */
interface Props {
  logoSrc: string
  logoAlt?: string
  brandSwappable?: boolean
}

const { logoSrc, logoAlt = 'APR 70 Pictures', brandSwappable = true } = Astro.props

const pathname = Astro.url.pathname

type NavItem = { num: string; label: string; href: string; active: boolean }

const raw: Array<Omit<NavItem, 'active'> & { match: (p: string) => boolean }> = [
  { num: '01', label: 'Front Door', href: '/', match: (p) => p === '/' },
  { num: '02', label: 'Divisions', href: '/#divisions', match: (p) => ['/212', '/310', '/nrc'].includes(p) },
  { num: '03', label: 'Slate', href: '/work', match: (p) => p === '/work' || p.startsWith('/work/') },
  { num: '04', label: 'Troupe', href: '/troupe', match: (p) => p.startsWith('/troupe') },
  { num: '05', label: 'Dispatch', href: '/news', match: (p) => p.startsWith('/news') },
  { num: '06', label: 'Contact', href: '/contact', match: (p) => p.startsWith('/contact') },
]

const items: NavItem[] = raw.map(({ match, ...rest }) => ({ ...rest, active: match(pathname) }))
---

<nav class="site-nav" aria-label="Primary">
  <a class="site-nav__brand" href="/" aria-label={logoAlt}>
    <img
      class="site-nav__mark"
      src={logoSrc}
      alt={logoAlt}
      {...(brandSwappable ? { 'data-brand-wordmark': 'true' } : {})}
    />
  </a>

  <ul class="site-nav__links" role="list">
    {items.map((item) => (
      <li class="site-nav__item">
        <a
          class="site-nav__link"
          href={item.href}
          {...(item.active ? { 'aria-current': 'page' } : {})}
        >
          <span class="site-nav__num">{item.num}</span>
          <span class="site-nav__label">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="site-nav__end">
    <button
      id="site-mode-toggle"
      type="button"
      class="site-nav__mode"
      aria-label="Toggle light or dark mode"
      aria-pressed="false"
    >
      <span class="site-nav__mode-icon" aria-hidden="true">
        <svg class="site-nav__mode-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.2v2.4M12 19.4v2.4M2.2 12h2.4M19.4 12h2.4M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7" />
        </svg>
        <svg class="site-nav__mode-moon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.5 14.3a8.2 8.2 0 0 1-10.8-10 .7.7 0 0 0-.9-.9 9.6 9.6 0 1 0 12.6 12.6.7.7 0 0 0-.9-.9 8.2 8.2 0 0 1-.0.2z" />
        </svg>
      </span>
      <span class="site-nav__mode-label" aria-hidden="true">
        <span class="site-nav__mode-label--light">Light</span>
        <span class="site-nav__mode-label--dark">Dark</span>
      </span>
    </button>

    <span class="site-nav__folio" aria-hidden="true">LIC <b>·</b> NY</span>
  </div>
</nav>

<script>
  /* Settle-safety net (defect fix, 2026-07-06): the per-theme "nav settle"
   * entrance tween (owned by src/lib/motion/<slug>.ts, run via the shared
   * dispatcher) was observed — reproducibly, across fresh builds, with and
   * without the splash overlay, over long-poll waits well past its ~0.8s
   * designed duration — to sometimes stall partway through its GSAP stagger,
   * leaving inline opacity permanently fractional (e.g. link 06 at ~0.001)
   * instead of settling to fully legible. Root cause lives outside this
   * component (the theme motion module / shared dispatcher); this is a
   * narrowly-scoped, harmless-if-unneeded safety net owned entirely by the
   * nav itself: after a ceiling comfortably past any legitimate settle
   * duration, force-clear any leftover inline opacity/transform so the nav
   * can never render stuck dim "at rest". No-op (and invisible) if the
   * settle already completed cleanly — clearing already-correct inline
   * styles changes nothing on screen.
   */
  window.setTimeout(() => {
    const nav = document.querySelector<HTMLElement>('.site-nav')
    if (!nav) return
    const clear = (el: HTMLElement) => {
      el.style.removeProperty('opacity')
      el.style.removeProperty('transform')
    }
    clear(nav)
    nav.querySelectorAll<HTMLElement>('.site-nav__link').forEach(clear)
  }, 2000)
</script>

<script>
  /* Light/dark MODE toggle (VMS pattern, moved here from the Display panel).
   * Independent of the theme: flips data-theme on <html>, pins it as a user
   * choice (data-mode-source="user"), persists apr70:mode — the exact same
   * contract the panel used, so the pre-paint stamp + resolveMode logic all
   * still apply. The sun/moon glyph + LIGHT/DARK word swap purely in CSS off
   * html[data-theme], so they stay correct even before this script runs and
   * whenever the theme changes elsewhere. The brand-mark ink re-sync (which
   * needs the full logo map) is handled by the Display panel island's
   * MutationObserver on data-theme — kept in one place, not duplicated here. */
  ;(function () {
    const doc = document.documentElement
    const btn = document.getElementById('site-mode-toggle')
    if (!btn) return
    const sync = () => {
      const dark = doc.getAttribute('data-theme') === 'dark'
      btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode')
      btn.setAttribute('aria-pressed', dark ? 'true' : 'false')
    }
    sync()
    btn.addEventListener('click', () => {
      const next = doc.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
      doc.setAttribute('data-theme', next)
      doc.setAttribute('data-mode-source', 'user')
      try {
        localStorage.setItem('apr70:mode', next)
      } catch {
        /* private mode — selection still applies for this page view */
      }
      sync()
    })
    /* Keep the button's a11y state correct when a theme switch changes the
       mode elsewhere (e.g. following a theme's default). */
    const obs = new MutationObserver(sync)
    obs.observe(doc, { attributes: true, attributeFilter: ['data-theme'] })
  })()
</script>

<style is:global>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.75rem, 2vw, 2rem);
    min-height: var(--nav-h);
    padding: 0.35rem var(--pad-x);
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .site-nav__mark {
    height: var(--logo-h);
    width: auto;
    display: block;
  }

  .site-nav__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 2.5vw, 34px);
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .site-nav__links::-webkit-scrollbar { display: none; }

  .site-nav__item { flex-shrink: 0; }

  .site-nav__link {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 6px 2px;
    text-decoration: none;
  }
  .site-nav__num {
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    color: var(--fg-5);
    letter-spacing: 0.15em;
    transition: color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .site-nav__label {
    font-family: var(--font-body);
    font-size: var(--type-micro);
    font-weight: 500;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--fg-3);
    white-space: nowrap;
    transition: color var(--dur-base) var(--ease-out);
  }
  /* underline draw */
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .site-nav__link:hover .site-nav__num,
  .site-nav__link:focus-visible .site-nav__num,
  .site-nav__link:hover .site-nav__label,
  .site-nav__link:focus-visible .site-nav__label {
    color: var(--fg-1);
  }
  .site-nav__link:hover .site-nav__num,
  .site-nav__link:focus-visible .site-nav__num {
    transform: translateY(-2px);
  }
  .site-nav__link:hover::after,
  .site-nav__link:focus-visible::after {
    transform: scaleX(1);
  }
  .site-nav__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* active — orange (accent) numeral, drawn underline */
  .site-nav__link[aria-current='page'] .site-nav__num { color: var(--accent); }
  .site-nav__link[aria-current='page'] .site-nav__label { color: var(--fg-1); }
  .site-nav__link[aria-current='page']::after { transform: scaleX(1); }

  /* right cluster: mode toggle + folio (folio drops on mobile, toggle stays) */
  .site-nav__end {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.6vw, 18px);
    flex-shrink: 0;
  }

  /* light/dark mode toggle — crafted for the numbered-nav aesthetic:
     mono word + sun/moon glyph, holds up in both themes/modes. */
  .site-nav__mode {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 5px 10px;
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-xs);
    color: var(--fg-3);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .site-nav__mode:hover {
    color: var(--fg-1);
    border-color: var(--fg-4);
  }
  .site-nav__mode:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .site-nav__mode-icon {
    display: inline-flex;
    width: 15px;
    height: 15px;
    color: var(--accent);
  }
  .site-nav__mode-icon svg {
    width: 15px;
    height: 15px;
    display: block;
  }
  .site-nav__mode-label {
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  /* Glyph + word swap purely off html[data-theme] — no JS needed, correct
     even before the toggle script runs. Show the CURRENT mode. */
  .site-nav__mode-sun,
  .site-nav__mode-moon,
  .site-nav__mode-label--light,
  .site-nav__mode-label--dark {
    display: none;
  }
  :root[data-theme='light'] .site-nav__mode-sun,
  :root[data-theme='light'] .site-nav__mode-label--light {
    display: block;
  }
  :root[data-theme='dark'] .site-nav__mode-moon,
  :root[data-theme='dark'] .site-nav__mode-label--dark {
    display: block;
  }

  .site-nav__folio {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.2em;
    color: var(--fg-4);
  }
  .site-nav__folio b { color: var(--accent); font-weight: 400; }

  @media (max-width: 720px) {
    .site-nav__folio { display: none; }
  }
  /* Very tight bars: keep the toggle icon, shed its word to save room. */
  @media (max-width: 460px) {
    .site-nav__mode-label { display: none; }
    .site-nav__mode { padding: 5px 8px; }
  }

  /* Coarse pointers: no hover surprises (targets stay reachable). */
  @media (hover: none) {
    .site-nav__link:hover .site-nav__num { transform: none; }
  }
</style>
