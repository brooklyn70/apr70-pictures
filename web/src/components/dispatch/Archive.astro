---
import type { DispatchIssueDoc } from '../../lib/payload'

interface Props {
  issues: DispatchIssueDoc['archive']
}

const { issues } = Astro.props
const list = issues ?? []
---

<section class="archive" aria-label="Past issues">
  <div class="archive-strip">
    {list.map((it) => (
      <a class={`archive-card ${it.isCurrent ? 'is-current' : ''}`}>
        {/* Numbered, never dated: archive cards render the issue NUMBER only —
            no Vol., no season. */}
        <div class="archive-card-head">
          <span>{it.no}</span>
        </div>
        <div>
          <div class="archive-card-mast">{it.mast}</div>
          <div class="archive-card-line">{it.line}</div>
        </div>
        <div class="archive-card-foot">
          <span><b>{it.state}</b></span>
          <span>OPEN →</span>
        </div>
      </a>
    ))}
  </div>
</section>
