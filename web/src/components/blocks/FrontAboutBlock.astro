---
/**
 * FrontAboutBlock.astro — the 2 a.m. window. The window line develops word by
 * word on scroll (screening-room.ts, [data-motion="about-window"], trigger
 * [data-motion="about"]); the body + rule line reveal ([data-motion="about-reveal"]).
 * A subtle radial glow sits behind. SSR default is fully visible.
 * Footer chrome (colophon, investor line, boilerplate) lives in Footer.astro
 * and is deliberately NOT repeated here.
 */
import type { FrontAboutData } from '../../content/v4'

interface Props {
  block: FrontAboutData
}

const { block } = Astro.props
---

<section class="front-about" data-motion="about" aria-label="About">
  <div class="container front-about__inner">
    <p class="front-about__window" data-motion="about-window">{block.window}</p>
    <p class="front-about__body" data-motion="about-reveal">{block.body}</p>
    <p class="front-about__rule" data-motion="about-reveal">{block.rule}</p>
  </div>
</section>

<style>
  .front-about {
    padding: clamp(3.5rem, 8vw, 7rem) 0;
    position: relative;
    overflow: hidden;
  }
  .front-about::before {
    content: '';
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: min(480px, 80vw);
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      color-mix(in srgb, var(--accent) 12%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .front-about__inner {
    text-align: center;
    position: relative;
  }

  .front-about__window {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(1.3rem, 3vw, 2rem);
    line-height: 1.5;
    color: var(--fg-1);
    max-width: 30ch;
    margin: 0 auto;
  }

  .front-about__body {
    margin: clamp(1.5rem, 3vw, 1.75rem) auto 0;
    max-width: 52ch;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-body-lg);
    line-height: var(--leading-body);
    color: var(--fg-3);
  }

  .front-about__rule {
    margin: clamp(2rem, 4vw, 2.5rem) auto 0;
    font-family: var(--font-body);
    font-size: var(--type-caption);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
