---
/**
 * /work/[slug] — the v9 property template (2026-07-10).
 *
 * Order on the page:
 *   hero photo-fold  — heroImage + heroCaption/heroCredit (skips when pending)
 *   property head    — metaLine · title · logline · provenance · bodyProse
 *   quote feature    — pageQuote {quote, cite, note}
 *   gallery          — FilmstripSlideshow island (plain grid without JS)
 *   request          — requestBody + mailto CTA (v9Chrome.cta) + /contact?re=<slug>
 *   prev/next ring   — slateOrder order, wrap-around 9 -> 1, + slateReturn
 *
 * GEO: CreativeWork JSON-LD typed Movie/TVSeries from the metaLine, plus
 * BreadcrumbList. Non-public slugs bounce to /slate.
 */
import V9Layout from '../../layouts/V9Layout.astro'
import FilmstripSlideshow, { type FilmstripItem } from '../../components/islands/FilmstripSlideshow'
import { fetchV9Project, fetchV9SlateProjects, fetchV9Chrome } from '../../lib/payload'
import { renderInline, renderParagraphs, plainText } from '../../lib/v9/inline'
import { frameFromMedia, focalPosition, SIZES_FULLBLEED } from '../../components/v9/media'
import { propertyJsonLd, breadcrumbJsonLd, NAP } from '../../lib/v9/site'

const { slug } = Astro.params
if (!slug) return Astro.redirect('/slate')

const [{ project }, { slate }, { chrome }] = await Promise.all([
  fetchV9Project(slug),
  fetchV9SlateProjects(),
  fetchV9Chrome(),
])

if (!project || !project.publicSlate) return Astro.redirect('/slate')

const title = project.title
const description = plainText(project.logline) || `${title} · ${NAP.name}`

// ── Hero fold ────────────────────────────────────────────────────────────────
const hero = frameFromMedia(project.heroImage)

// ── Gallery ──────────────────────────────────────────────────────────────────
const galleryItems: FilmstripItem[] = (project.gallery ?? []).flatMap((item) => {
  const frame = frameFromMedia(item.image)
  if (!frame) return []
  return [
    {
      src: frame.src,
      srcset: frame.srcset,
      width: frame.width,
      height: frame.height,
      alt: frame.alt || item.caption || `${title} development frame`,
      caption: item.caption ?? null,
      captionHtml: item.caption ? renderInline(item.caption) : null,
      credit: item.credit ?? null,
      wide: (item as { wide?: boolean | null }).wide ?? false,
      focalX: frame.focalX,
      focalY: frame.focalY,
    },
  ]
})

// ── Request ──────────────────────────────────────────────────────────────────
const ctaLabel = chrome.cta || 'Request materials'
const mailto = `mailto:${NAP.email}?subject=${encodeURIComponent(`APR 70 materials request · ${title}`)}`
const requestHtml = renderParagraphs(project.requestBody)

// ── Prev / next ring (slateOrder order, wrap-around) ─────────────────────────
const idx = slate.findIndex((p) => p.slug === slug)
const ring = slate.length > 1 && idx >= 0
const prev = ring ? slate[(idx - 1 + slate.length) % slate.length] : null
const next = ring ? slate[(idx + 1) % slate.length] : null

// ── Story setting meta (v13 deferred touch) ──────────────────────────────────
// "1977 · Brooklyn" — small mono line under the title. Either half may be
// blank; the line renders only when at least one is present.
const storySetting = [project.storyYear, project.storyPlace]
  .map((s) => (typeof s === 'string' ? s.trim() : ''))
  .filter(Boolean)
  .join(' · ')

// ── Quote ────────────────────────────────────────────────────────────────────
const quote = project.pageQuote?.quote ?? null
const quoteCite = project.pageQuote?.cite ?? null
const quoteNote = project.pageQuote?.note ?? null

const bodyHtml = renderParagraphs(project.bodyProse)

const jsonLd = [propertyJsonLd(project), breadcrumbJsonLd(project)]
---

<V9Layout title={`${title} · ${NAP.name}`} description={description} jsonLd={jsonLd}>
  {
    hero && (
      <section class="v9-photofold" aria-label={`${title} hero`}>
        <div class="v9-photofold__frame">
          <img
            src={hero.src}
            srcset={hero.srcset}
            sizes={SIZES_FULLBLEED}
            width={hero.width}
            height={hero.height}
            alt={hero.alt}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            style={`object-position: ${focalPosition(hero)}`}
          />
          <div class="v9-scrim" aria-hidden="true" />
          {project.heroLine && (
            <div class="v9-photofold__overlay">
              <div class="v9-photofold__overlay-inner">
                <p class="v9-photofold__heading">{project.heroLine}</p>
              </div>
            </div>
          )}
        </div>
        {(project.heroCaption || project.heroCredit) && (
          <div class="v9-col">
            <span class="v9-capline">
              {project.heroCaption && <span set:html={renderInline(project.heroCaption)} />}
              {project.heroCredit && <span class="v9-capline__credit">{project.heroCredit}</span>}
            </span>
          </div>
        )}
      </section>
    )
  }

  <header class="v9-col v9-prophead">
    {project.metaLine && <p class="v9-prophead__meta" set:html={renderInline(project.metaLine)} />}
    <h1 class="v9-prophead__title">{title}</h1>
    {storySetting && <p class="v9-prophead__setting">{storySetting}</p>}
    {project.logline && <p class="v9-prophead__logline" set:html={renderInline(project.logline)} />}
    {
      project.provenance && (
        <p class="v9-prophead__provenance" set:html={renderInline(project.provenance)} />
      )
    }
    {bodyHtml && <div class="v9-prose" set:html={bodyHtml} />}
  </header>

  {
    quote && (
      <section class="v9-section v9-quotefeature" aria-label={quoteCite ? `Quotation from ${quoteCite}` : 'Quotation'}>
        <div class="v9-col">
          <blockquote>
            <p>{quote}</p>
            {quoteCite && <cite>{quoteCite}</cite>}
          </blockquote>
          {quoteNote && <span class="v9-quotefeature__note">{quoteNote}</span>}
        </div>
      </section>
    )
  }

  {
    galleryItems.length > 0 && (
      <section class="v9-section" aria-label={`Development frames · ${title}`}>
        <div class="v9-col">
          <div class="v9-scene">
            <span class="v9-scene__slug">The world of the picture</span>
          </div>
          <FilmstripSlideshow client:visible items={galleryItems} label={`Development frames · ${title}`} />
        </div>
      </section>
    )
  }

  <section class="v9-section" aria-label={`Request materials · ${title}`}>
    <div class="v9-col">
      <div class="v9-request">
        <h2 class="v9-request__heading">Read the pages.</h2>
        {requestHtml && <div class="v9-prose" set:html={requestHtml} />}
        <p class="v9-prose">
          <a class="v9-btn" href={mailto}>{ctaLabel}</a>
        </p>
        <a class="v9-ring__return" href={`/contact?re=${encodeURIComponent(slug)}`}>
          Or go through the contact desk
        </a>
      </div>
    </div>
  </section>

  {
    ring && prev && next && (
      <footer class="v9-section v9-section--tight" aria-label="More of the slate">
        <div class="v9-col">
          <nav class="v9-ring" aria-label="Slate navigation">
            <a class="v9-ring__link" href={`/work/${prev.slug}`} rel="prev">
              <span class="v9-ring__dir">{chrome.prevLabel}</span>
              <span class="v9-ring__title">{prev.title}</span>
            </a>
            <a class="v9-ring__link v9-ring__link--next" href={`/work/${next.slug}`} rel="next">
              <span class="v9-ring__dir">{chrome.nextLabel}</span>
              <span class="v9-ring__title">{next.title}</span>
            </a>
          </nav>
          <a class="v9-ring__return" href="/slate">{chrome.slateReturn}</a>
        </div>
      </footer>
    )
  }
</V9Layout>
