---
import type { Home } from 'payload-types'

type CTABlockType = Extract<
  NonNullable<NonNullable<Home['layout']>[number]>,
  { blockType: 'cta' }
>

interface Props {
  block: CTABlockType
}

const { block } = Astro.props
---

<section class="cta-block" aria-label={block.heading}>
  <div class="cta-block__inner">
    <h2 class="cta-block__heading">{block.heading}</h2>
    {block.subtext && <p class="cta-block__subtext">{block.subtext}</p>}
    
    <div class="cta-block__actions">
      {block.buttons?.map((btn) => {
        const btnClass = btn.variant === 'solid' 
          ? 'btn-solid' 
          : btn.variant === 'ghost' 
            ? 'btn-ghost' 
            : 'link-cta'
            
        return (
          <a href={btn.url} class={btnClass}>
            {btn.label}
          </a>
        )
      })}
    </div>
  </div>
</section>

<style>
  .cta-block {
    width: 100%;
    padding: var(--s-9) var(--s-3);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }

  .cta-block__inner {
    max-width: 48rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-5);
  }

  .cta-block__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h2);
    line-height: var(--leading-snug);
    letter-spacing: var(--track-tight);
    color: var(--fg-1);
    text-transform: uppercase;
  }

  .cta-block__subtext {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-body-lg);
    line-height: var(--leading-loose);
    color: var(--fg-3);
    max-width: 36rem;
  }

  .cta-block__actions {
    margin-top: var(--s-2);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-4);
  }
</style>
