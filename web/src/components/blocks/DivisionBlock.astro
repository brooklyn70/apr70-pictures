---
/**
 * DivisionBlock.astro — Division Showcase renderer.
 * Supports v0-baseline, v3-baseline-filmstrip, and v4-animated-filmstrip.
 */
import FilmstripBlock from './FilmstripBlock.astro'
import DivisionFilmstripV5 from './DivisionFilmstripV5.astro'
import { resolveMediaUrl } from '../../lib/payload'

interface Division {
  name: string
  colorToken: string
  subtitle?: string
  description?: string
  media?: any
  number?: string
  taglineLines?: string[]
  projects?: { title: string; badge: string }[]
}

interface Props {
  block: {
    variant: string
    heading?: string
    subtext?: string
    divisions: Division[]
  }
}

const { block } = Astro.props
const variant = block.variant ?? 'v0-baseline'
const divisions = block.divisions ?? []

function tokenToVar(token: string): string {
  return `var(--color-${token})`
}

function getProjectFilter(name: string): 'all' | '212' | '310' | 'nrc' {
  const n = name.toLowerCase()
  if (n.includes('212')) return '212'
  if (n.includes('310')) return '310'
  if (n.includes('nrc')) return 'nrc'
  return 'all'
}

function getFormat(name: string): 'super35' | 'widescreen200' | 'academy' {
  const n = name.toLowerCase()
  if (n.includes('310')) return 'widescreen200'
  if (n.includes('nrc')) return 'academy'
  return 'super35'
}

function getDivisionCode(name: string): '212' | '310' | 'NRC' {
  const n = name.toLowerCase()
  if (n.includes('212')) return '212'
  if (n.includes('310')) return '310'
  if (n.includes('nrc') || n.includes('renaissance')) return 'NRC'
  return '212'
}

function getDivisionId(name: string): '212' | '310' | 'nrc' {
  const n = name.toLowerCase()
  if (n.includes('212')) return '212'
  if (n.includes('310')) return '310'
  if (n.includes('nrc') || n.includes('renaissance')) return 'nrc'
  return '212'
}

function getDivisionLogo(name: string): string {
  const n = name.toLowerCase()
  if (n.includes('212')) return '/brand/apr70-logos/212-pictures/212_footer.svg'
  if (n.includes('310')) return '/brand/apr70-logos/310-pictures/310_footer.svg'
  return '/brand/apr70-logos/new-renaissance-cinema/nrc_v1.svg'
}

/* Y offset crops the SVG's own internal top padding so content bleeds to the element edge */
function getLogoOffsetY(name: string): string {
  const n = name.toLowerCase()
  if (n.includes('nrc') || n.includes('renaissance')) return '17%'
  return '9%' // 212_footer + 310_footer: content starts at ~y=20/230
}
---

{variant === 'v0-baseline' && (
  <section class="division-showcase v0-baseline dark-mode-enforcer" data-theme="dark">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="division-rows container">
      {divisions.map((div, i) => {
        const divCode = getDivisionCode(div.name)
        const color = tokenToVar(div.colorToken)
        return (
          <div class="v0-editorial-grid" style={`--div-color: ${color}`}>
            <div class="v0-grid-left">
              <span class="v0-meta-label">DIVISION CODE</span>
              <span class="v0-division-code" aria-hidden="true" style={`color: ${color}`}>{divCode}</span>
              <div class="v0-meta-footer">
                <span class="v0-meta-item">FORMAT: {getFormat(div.name).toUpperCase()}</span>
                <span class="v0-meta-item">APR70 SYSTEM</span>
              </div>
            </div>
            
            <div class="v0-grid-right">
              <span class="v0-eyebrow">APR 70 / {divCode}</span>
              <h3 class="v0-division-name">{div.name}</h3>
              {div.subtitle && <span class="v0-division-subtitle" style={`color: ${color}; border-color: ${color}`}>{div.subtitle}</span>}
              {div.description && (
                <p class="v0-division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
              )}
            </div>
            <span class="v0-ghost" aria-hidden="true">{divCode}</span>
          </div>
        )
      })}
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('v0-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });

        const cards = document.querySelectorAll('.v0-editorial-grid');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        cards.forEach((card, index) => {
          if (prefersReducedMotion) {
            card.classList.add('v0-revealed');
          } else {
            (card as HTMLElement).style.setProperty('--reveal-delay', `${index * 80}ms`);
            observer.observe(card);
          }
        });
      });
    </script>
  </section>
)}

{variant === 'v0.1' && (
  <section class="division-showcase v01-showcase" data-theme="dark">
    {block.heading && (
      <div class="v01-header container">
        <span class="v01-header-eyebrow">APR 70 PICTURES · EST. 2026</span>
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && <p class="body-lg">{block.subtext}</p>}
      </div>
    )}
    <div class="v01-rows container">
      {divisions.map((div, i) => {
        const num = String(i + 1).padStart(2, '0')
        const divCode = getDivisionCode(div.name)
        const color = tokenToVar(div.colorToken)
        return (
          <div class="v01-card" style={`--div-color: ${color}`}>
            {/* Stroke: draws top→bottom on hover, height 0→100%, 1.5s — v2 slate-card pattern */}
            <span class="v01-stroke" style={`background: ${color}`} aria-hidden="true"></span>
            <div class="reg-marks" aria-hidden="true">
              <span class="rm-tl"></span><span class="rm-tr"></span>
              <span class="rm-bl"></span><span class="rm-br"></span>
            </div>
            <div class="v01-left">
              <span class="v01-seq" style={`color: ${color}`}>{num}</span>
              <div class="v01-meta-foot">
                <span class="v01-meta-item">FORMAT: {getFormat(div.name).toUpperCase()}</span>
                <span class="v01-meta-item">APR 70 SYSTEM</span>
              </div>
            </div>
            <div class="v01-right">
              <span class="v01-eyebrow">APR 70 · {div.subtitle ?? ''}</span>
              <h3 class="v01-name">{div.name}</h3>
              {(div.taglineLines ?? []).length > 0 && (
                <div class="v01-taglines">
                  {(div.taglineLines ?? []).map(line => (
                    <span class="v01-tagline-line" style={`color: ${color}`}>{line}</span>
                  ))}
                </div>
              )}
              {div.description && <p class="v01-desc">{div.description}</p>}
              <a class="v01-cta link-cta" href="#">Enter division &rarr;</a>
            </div>
            <span class="v01-ghost" aria-hidden="true">{divCode}</span>
          </div>
        )
      })}
    </div>
  </section>
)}


{variant === 'v0.3' && (
  <section class="division-showcase v03-showcase" data-theme="dark">
    {block.heading && (
      <div class="v03-header container">
        <span class="v03-header-eyebrow">APR 70 PICTURES · EST. 2026</span>
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && <p class="body-lg">{block.subtext}</p>}
      </div>
    )}
    <div class="v03-rows container">
      {divisions.map((div, i) => {
        const num = String(i + 1).padStart(2, '0')
        const color = tokenToVar(div.colorToken)
        const logoSrc = getDivisionLogo(div.name)
        const logoOffsetY = getLogoOffsetY(div.name)
        return (
          <div class="v03-row" style={`--div-color: ${color}`}>
            {/* Stroke: same v2 height-transition pattern */}
            <span class="v03-stroke" style={`background: ${color}`} aria-hidden="true"></span>
            <div class="reg-marks" aria-hidden="true">
              <span class="rm-tl"></span><span class="rm-tr"></span>
              <span class="rm-bl"></span><span class="rm-br"></span>
            </div>
            <div class="v03-row-top">
              <span class="v03-index">
                <span class="v03-num">{num}</span>
              </span>
              <img class="v03-logo" src={logoSrc} alt={div.name} style={`object-position: left ${logoOffsetY}`} />
              <a class="v03-cta" href="#">
                <span class="v03-cta-label">Enter</span>
                <span class="v03-cta-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
            <div class="v03-row-body">
              <div class="v03-taglines">
                {(div.taglineLines ?? []).map(line => (
                  <span class="v03-tagline">{line}</span>
                ))}
              </div>
              <div class="v03-content">
                {div.description && <p class="v03-desc">{div.description}</p>}
                {(div.projects ?? []).length > 0 && (
                  <ul class="v03-projects" role="list">
                    {(div.projects ?? []).map(p => (
                      <li class="v03-project">
                        <span class="v03-project-title">{p.title}</span>
                        <span class="v03-project-badge">{p.badge}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        )
      })}
    </div>
  </section>
)}


{variant === 'v3-baseline-filmstrip' && (
  <section class="division-showcase v3-baseline dark-mode-enforcer" data-theme="dark">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="division-rows">
      {divisions.map((div, i) => {
        const num = String(i + 1).padStart(2, '0')
        const color = tokenToVar(div.colorToken)
        const format = getFormat(div.name)
        const filter = getProjectFilter(div.name)
        return (
          <div class="division-row" style={`--div-color: ${color}`}>
            <div class="container position-relative">
              <span class="ghost-num" aria-hidden="true">{num}</span>
              <div class="division-content">
                <span class="eyebrow">{num}</span>
                <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
                {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
                {div.description && (
                  <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
                )}
              </div>
            </div>
            <div class="filmstrip-wrapper">
               <FilmstripBlock block={{ 
                 source: 'from-projects', 
                 projectFilter: filter, 
                 format: format, 
                 showPerforations: true,
                 tiles: div.media ? [{ media: div.media, caption: div.name, division: filter }] : []
               }} />
            </div>
          </div>
        )
      })}
    </div>
  </section>
)}

{variant === 'v4-animated-filmstrip' && (
  <section class="division-showcase v4-animated dark-mode-enforcer" data-theme="dark">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="division-rows">
      {divisions.map((div, i) => {
        const num = String(i + 1).padStart(2, '0')
        const color = tokenToVar(div.colorToken)
        const format = getFormat(div.name)
        const filter = getProjectFilter(div.name)
        return (
          <div class="division-row" style={`--div-color: ${color}`}>
            <div class="container position-relative">
              <span class="ghost-num" aria-hidden="true">{num}</span>
              <div class="division-content">
                <span class="eyebrow">{num}</span>
                <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
                {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
                {div.description && (
                  <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
                )}
              </div>
            </div>
            <div class="filmstrip-wrapper animated-filmstrip-track">
               <FilmstripBlock block={{ 
                 source: 'custom-media', 
                 format: format, 
                 showPerforations: true,
                 tiles: div.media ? Array(16).fill({ media: div.media, caption: div.name, division: filter }) : []
               }} />
            </div>
          </div>
        )
      })}
    </div>
  </section>
)}

{variant === 'v5-animated-filmstrip' && (
  <section class="division-showcase v5-animated dark-mode-enforcer" data-theme="dark">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="division-rows">
      {divisions.map((div, i) => {
        const divCode = getDivisionCode(div.name)
        const color = tokenToVar(div.colorToken)
        const format = getFormat(div.name)
        const filter = getProjectFilter(div.name)
        return (
          <div class="division-row v5-row v5-editorial-layout" style={`--div-color: ${color}`}>
            <div class="container v5-editorial-header">
              <div class="v5-header-left">
                <span class="v5-meta-label">DIVISION {divCode}</span>
                <h3 class="v5-division-name">{div.name}</h3>
              </div>
              <div class="v5-header-right">
                {div.subtitle && <span class="v5-division-subtitle" style={`color: ${color}; border-color: ${color}`}>{div.subtitle}</span>}
                {div.description && (
                  <p class="v5-division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
                )}
              </div>
            </div>
            <div class="filmstrip-wrapper v5-filmstrip-track" data-division={filter}>
               <DivisionFilmstripV5 
                 division={getDivisionId(div.name)}
                 format={format}
                 colorToken={div.colorToken}
               />
            </div>
          </div>
        )
      })}
    </div>
  </section>
)}

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // V4 animation
    const tracks = document.querySelectorAll('.animated-filmstrip-track .scroll-window');
    
    tracks.forEach((track) => {
      const segments = track.querySelectorAll('.film-segment');
      const firstTileIndex = Array.from(segments).findIndex(s => s.classList.contains('filmstrip-tile'));
      
      if (firstTileIndex > 0) {
        const targetElement = segments[firstTileIndex] as HTMLElement;
        
        ScrollTrigger.create({
          trigger: track,
          start: 'top 80%',
          once: true,
          onEnter: () => {
             const paddingLeft = parseInt(window.getComputedStyle(track).paddingLeft || '0');
             const targetScroll = targetElement.offsetLeft - paddingLeft;
             
             // Temporarily disable scroll snapping so GSAP doesn't fight the browser
             const originalSnap = (track as HTMLElement).style.scrollSnapType;
             (track as HTMLElement).style.scrollSnapType = 'none';

             gsap.to(track, {
               scrollLeft: targetScroll,
               duration: 2.5,
               ease: 'power2.inOut',
               onComplete: () => {
                 (track as HTMLElement).style.scrollSnapType = originalSnap;
               }
             });
          }
        });
      }
    });

    // V5 animation
    // Check user preference for reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const v5Rows = document.querySelectorAll('.v5-row');
    v5Rows.forEach((row) => {
      const track = row.querySelector('.v5-filmstrip-track .scroll-window') as HTMLElement;
      if (!track) return;
      
      const segments = track.querySelectorAll('.film-segment');
      const parkFrame = Array.from(segments).find(s => s.classList.contains('logo-park-frame')) as HTMLElement;
      if (!parkFrame) return;

      const paddingLeft = parseInt(window.getComputedStyle(track).paddingLeft || '0');
      const viewportWidth = track.clientWidth;
      const parkOffset = Math.max(0, parkFrame.offsetLeft - paddingLeft - (viewportWidth / 2) + (parkFrame.clientWidth / 2));

      if (prefersReducedMotion) {
        // Pre-park for accessibility
        track.scrollLeft = parkOffset;
        parkFrame.setAttribute('data-parked', 'true');
        return;
      }

      // Hybrid scrub implementation
      ScrollTrigger.create({
        trigger: row,
        start: 'top top',
        end: '+=120%', // pin duration
        pin: true,
        scrub: 1, // 1 second smoothing
        invalidateOnRefresh: true,
        animation: gsap.to(track, {
          scrollLeft: parkOffset,
          ease: 'none',
        }),
        onEnter: () => {
          track.style.scrollSnapType = 'none';
        },
        onLeave: () => {
          track.style.scrollSnapType = '';
          parkFrame.setAttribute('data-parked', 'true');
        },
        onLeaveBack: () => {
          track.style.scrollSnapType = '';
          parkFrame.setAttribute('data-parked', 'false');
        },
        onEnterBack: () => {
          track.style.scrollSnapType = 'none';
          parkFrame.setAttribute('data-parked', 'false');
        }
      });
      
      // Intersection Observer for countdown animation and park triggers
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-active');
            if (entry.target.classList.contains('logo-park-frame')) {
               entry.target.setAttribute('data-parked', 'true');
            }
          } else {
            entry.target.classList.remove('is-active');
            if (entry.target.classList.contains('logo-park-frame')) {
               entry.target.setAttribute('data-parked', 'false');
            }
          }
        });
      }, {
        root: track,
        threshold: 0.6
      });

      segments.forEach(seg => observer.observe(seg));
    });
  });
</script>

<style>
  /* Base styles */
  .division-showcase {
    padding: var(--s-9) 0;
  }
  .division-header {
    text-align: center;
    margin-bottom: var(--s-9);
  }
  .division-header .body-lg {
    max-width: 640px;
    margin: var(--s-5) auto 0;
    color: var(--fg-3);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-4);
    display: block;
    margin-bottom: var(--s-3);
  }
  .division-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: var(--track-tight);
    margin-bottom: var(--s-4);
    text-transform: uppercase;
  }
  .division-subtitle {
    display: block;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(0.8125rem, 1vw, 0.875rem);
    color: var(--fg-4);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    margin-bottom: var(--s-5);
  }
  .division-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--fg-2);
    line-height: 1.72;
    max-width: 620px;
    margin: 0;
  }

  /* Baseline layout */
  .division-rows {
    display: flex;
    flex-direction: column;
  }
  .division-row {
    position: relative;
    border-top: 1px solid var(--rule);
    padding: var(--s-9) 0;
    overflow: hidden;
  }
  .position-relative {
    position: relative;
  }
  .ghost-num {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 16vw, 14rem);
    color: var(--fg-6);
    line-height: 1;
    letter-spacing: var(--track-tight);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .division-content {
    position: relative;
    max-width: 780px;
    z-index: 1;
  }

  /* Dark mode enforcer (Filmstrips) */
  .dark-mode-enforcer {
    background: transparent;
    color: var(--fg-1);
  }

  .filmstrip-wrapper {
    margin-top: var(--s-7);
    width: 100%;
  }

  /* V0 REDESIGN - Sight & Sound Editorial */
  .v0-baseline {
    background: var(--bg-1);
    color: var(--fg-1);
    border-top: 1px solid var(--rule);
  }
  .v0-baseline .division-header {
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--s-8);
  }
  .v0-editorial-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    border-bottom: 1px solid var(--rule);
    padding: var(--s-9) 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .v0-editorial-grid.v0-revealed {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0ms;
  }
  .v0-editorial-grid::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--div-color);
    transition: width var(--dur-quick) var(--ease-out);
  }
  .v0-editorial-grid:hover::before {
    width: 4px;
  }
  @media (min-width: 768px) {
    .v0-editorial-grid {
      grid-template-columns: 1fr 2fr;
    }
  }
  .v0-grid-left {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--s-6);
  }
  .v0-grid-right {
    position: relative;
    z-index: 1;
  }
  @media (min-width: 768px) {
    .v0-grid-left {
      border-right: 1px solid var(--rule);
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 0;
      padding-right: var(--s-8);
    }
    .v0-grid-right {
      padding-left: var(--s-8);
    }
  }
  .v0-meta-label, .v0-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    color: var(--fg-4);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }
  .v0-meta-item {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    color: var(--fg-4);
