---
/**
 * /310 - the (310) Pictures division page (v9 chrome, marquee design).
 * Rebuilt 2026-07-12 to the v10 Divisions panel ruling: full-size typographic
 * lockup, discipline line, investor paragraph, and the division's own slate.
 * Staging note (Selznick): the flagship L.A. Dolce Vita sits on top of the slate.
 */
import V9Layout from '../layouts/V9Layout.astro'
import DivisionPage from '../components/v9/DivisionPage.astro'
import { fetchDivisionSlate, fetchV9SlateProjects } from '../lib/payload'
import { plainText } from '../lib/v9/inline'
import { NAP } from '../lib/v9/site'

const [{ slate }, { slate: whole }] = await Promise.all([
  fetchDivisionSlate('310'),
  fetchV9SlateProjects(),
])
// v15 (N-036): the NRC features this house co-produces, read from the one
// billing source, Project.metaLine ("... with (310) Pictures ..."). No new field.
const coProductions = whole.filter((p) =>
  plainText(p.metaLine).toLowerCase().includes('with (310) pictures'),
)

const lockup = '(310) Pictures'
const discipline = 'Television for audiences who travel, staged out of Los Angeles.'
const paragraph =
  // v15: Neon's text (N-035), copied from the review / round 1 answers.
  'Political thrillers and grounded science fiction built in Los Angeles for international audiences. L.A. Dolce Vita anchors the house alongside Cleopatra. When a West Coast story belongs in theaters, New Renaissance Cinema leads and (310) Pictures co-produces.'
const title = `${lockup} · ${NAP.name}`
---

<V9Layout title={title} description={discipline} division="310">
  <DivisionPage
    division="310"
    lockup={lockup}
    discipline={discipline}
    paragraph={paragraph}
    slate={slate}
    coProductions={coProductions}
    slateCount={whole.length}
  />
</V9Layout>
