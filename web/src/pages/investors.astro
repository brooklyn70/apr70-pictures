---
/**
 * /investors — retired as a public page (v10 catalog, room-only doctrine).
 * There is no public deck or data room; investor materials move only by a
 * person-to-person request. Serves a real 410 (Gone) since output: 'server'
 * gives us a live status code, and renders in v9 chrome so the retirement
 * itself still reads as APR 70, not a broken link.
 */
import V9Layout from '../layouts/V9Layout.astro'
import { NAP } from '../lib/v9/site'

const title = `Investors · ${NAP.name}`
const description = 'Investor materials at APR 70 Pictures move by personal request, not a public page.'

Astro.response.status = 410
Astro.response.statusText = 'Gone'
---

<V9Layout title={title} description={description}>
  <section class="v9-section" aria-label="Investors">
    <div class="v9-col">
      <h1 class="v9-textfold__heading">Investors</h1>
      <p class="v9-prose">
        This page is retired. APR 70 doesn't run a public deck or an open data room —
        investor materials move person to person, on request.
      </p>
      <a class="v9-more" href="/contact">Request a conversation →</a>
    </div>
  </section>
</V9Layout>
