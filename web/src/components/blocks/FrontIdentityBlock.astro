---
/**
 * FrontIdentityBlock.astro — the standing identity strip.
 * Draft 3 dek; first sentence in the accent (orange). The whole passage
 * develops word-by-word on scroll (screening-room.ts, [data-motion="identity-read"]);
 * SSR default is the fully-legible static paragraph.
 */
import type { FrontIdentityData } from '../../content/v4'

interface Props {
  block: FrontIdentityData
}

const { block } = Astro.props
---

<section class="front-identity">
  <div class="container">
    <p class="front-identity__read" data-motion="identity-read">
      <span class="first-words">{block.firstSentence}</span> {block.rest}
    </p>
  </div>
</section>

<style>
  .front-identity {
    padding: clamp(2rem, 5vw, 4rem) 0;
    border-bottom: 1px solid var(--rule);
  }

  .front-identity__read {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-body-lg);
    line-height: 1.8;
    color: var(--fg-2);
    max-width: 62ch;
    margin: 0 auto;
    text-align: center;
  }

  /* Accent opening sentence (theme layer also defines .first-words; kept here so
     the block reads correctly even outside the T1 skin). */
  .front-identity__read .first-words {
    color: var(--accent);
    font-weight: 500;
  }
</style>
