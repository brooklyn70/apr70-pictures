---
import Layout from '../../layouts/Layout.astro'
import FilmstripBlock from '../../components/blocks/FilmstripBlock.astro'

const mockTiles = Array.from({ length: 30 }).map((_, i) => ({
  caption: `FRAME ${String(i + 1).padStart(2, '0')}`,
  division: ['212', '310', 'nrc', 'none'][i % 4],
}))

// Mock the block props
function createBlock(format: string) {
  return {
    source: 'custom-media' as const,
    format: format as any,
    tiles: mockTiles.map(t => ({
      media: { url: 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7', alt: 'Wireframe' },
      caption: t.caption,
      division: t.division,
    }))
  }
}
---

<Layout title="Dev: Filmstrip Variants">
  <div style="padding: 40px 0; background: #111;">
    <h3 style="text-align: center; margin: 2rem 0 1rem; color: #fff; font-family: var(--font-mono); text-transform: uppercase;">Academy (1.37:1) - 310</h3>
    <FilmstripBlock block={createBlock('academy')} />

    <h3 style="text-align: center; margin: 4rem 0 1rem; color: #fff; font-family: var(--font-mono); text-transform: uppercase;">Super 35 (2.39:1) - 212</h3>
    <FilmstripBlock block={createBlock('super35')} />

    <h3 style="text-align: center; margin: 4rem 0 1rem; color: #fff; font-family: var(--font-mono); text-transform: uppercase;">2:1 Widescreen - NRC</h3>
    <FilmstripBlock block={createBlock('widescreen200')} />

    <h3 style="text-align: center; margin: 4rem 0 1rem; color: #fff; font-family: var(--font-mono); text-transform: uppercase;">IMAX (1.43:1)</h3>
    <FilmstripBlock block={createBlock('imax')} />

    <h3 style="text-align: center; margin: 4rem 0 1rem; color: #fff; font-family: var(--font-mono); text-transform: uppercase;">V2 Header</h3>
    <FilmstripBlock block={createBlock('v2-header')} />

    <h3 style="text-align: center; margin: 4rem 0 1rem; color: #fff; font-family: var(--font-mono); text-transform: uppercase;">V2 Footer</h3>
    <FilmstripBlock block={createBlock('v2-footer')} />
  </div>
</Layout>
