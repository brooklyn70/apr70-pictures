---
import BlockRenderer from '../components/blocks/BlockRenderer.astro'
import Layout from '../layouts/Layout.astro'
import { fetchHomeGlobal } from '../lib/payload'

const { home, error } = await fetchHomeGlobal()
---

<Layout>
  <main class="test-page">
    <header class="test-page__banner">
      <p class="test-page__label">Phase 2 — Home layout blocks (Hero, Rich text + D-7)</p>
      {error ? <p class="test-page__error" role="status">{error}</p> : null}
    </header>
    {home?.layout?.length ? <BlockRenderer blocks={home.layout} /> : null}
    {
      !error && home && !home.layout?.length ? (
        <p class="test-page__empty">
          Home global has no layout blocks yet. Add a Hero block in Payload Admin (/admin) under
          Globals &rarr; Home.
        </p>
      ) : null
    }
  </main>
</Layout>

<style>
  .test-page {
    min-height: 100vh;
  }

  .test-page__banner {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--offwhite);
    background: color-mix(in srgb, var(--apr-near-black) 4%, transparent);
  }

  .test-page__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--apr-mid-dark);
  }

  .test-page__error {
    margin: var(--space-2) 0 0;
    color: var(--orange);
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .test-page__empty {
    padding: var(--space-4) var(--space-3);
    font-family: var(--font-body);
    color: var(--apr-mid-dark);
    max-width: 40rem;
  }
</style>
