---
/**
 * / — the v9 front door (2026-07-10). The v9 IA replaces the zine front door
 * on this branch: the page is the "Site v9 · Home" global rendered through
 * the shared SectionRenderer, in the V9Layout chrome, plus the LogoReveal
 * island (sprocket elevator, once per session, home only).
 */
import V9Layout from '../layouts/V9Layout.astro'
import SectionRenderer from '../components/v9/SectionRenderer.astro'
import LogoRevealIsland from '../components/islands/LogoRevealIsland'
import { fetchV9Page } from '../lib/payload'
import { NAP } from '../lib/v9/site'

const { page } = await fetchV9Page('v9-home')
const title = page?.seoTitle ?? `${NAP.name} · The classics never go out of style`
const description = page?.seoDescription ?? NAP.description
---

<V9Layout title={title} description={description}>
  <LogoRevealIsland client:load />
  <SectionRenderer sections={page?.sections} />
</V9Layout>
