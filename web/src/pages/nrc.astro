---
import Layout from '../layouts/Layout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { fetchDivisionNRCGlobal } from '../lib/payload';
import { V4_DIVISION_BLOCKS } from '../content/v4';

const { divisionNRC, error } = await fetchDivisionNRCGlobal();
const dbBlocks = divisionNRC?.layout || [];
// V4 division pages: the built-out division block stack leads (masthead,
// section copy, slate, cross-doors). Once the Payload layout is re-arranged to
// carry a `divisionMasthead` block, the DB version takes over wholesale.
const hasDivisionLayout = dbBlocks.some(
  (b) => (b as { blockType?: string }).blockType === 'divisionMasthead',
);
const blocks = hasDivisionLayout ? dbBlocks : V4_DIVISION_BLOCKS.nrc;

// ── Logo overrides — CMS-down-safe (Wave F; see 212.astro for the rationale) ──
const localBrand = (p: string) => ({ url: new URL(p, Astro.url).href });
const pickLogo = (media: unknown, localPath: string) => {
  const url =
    media && typeof media === 'object' && 'url' in media
      ? (media as { url?: unknown }).url
      : undefined;
  if (!error && typeof url === 'string' && /^https?:\/\//.test(url)) return media;
  return localBrand(localPath);
};

const navLogoOverride = pickLogo(divisionNRC?.headerLogo, '/brand/apr70-logos/new-renaissance-cinema/nrc_v3.svg');
const footerLogoOverride = pickLogo(divisionNRC?.footerLogo, '/brand/apr70-logos/new-renaissance-cinema/nrc_footer.svg');
const faviconOverride = pickLogo(divisionNRC?.faviconOverride, '/brand/apr70-logos/new-renaissance-cinema/nrc_favicon.svg');
---

<Layout title="NRC Division" faviconOverride={faviconOverride} navLogoOverride={navLogoOverride} navLogoAltOverride="New Renaissance Cinema" footerLogoOverride={footerLogoOverride} footerLogoAltOverride="New Renaissance Cinema">
  <main>
    {import.meta.env.DEV && error && (
      <div style="padding: 1rem; margin: 2rem auto; max-width: 600px; background: rgba(255,0,0,0.1); border: 1px solid red; border-radius: 4px; font-family: var(--font-body); color: #cc0000;">
        <strong>Fetch Error:</strong> {error}
      </div>
    )}
    <BlockRenderer blocks={blocks} />
  </main>
</Layout>
