---
/**
 * DivisionPage - the shared body of the three public division pages
 * (/212 · /310 · /nrc), rendered inside V9Layout (v9 chrome, marquee design).
 *
 * Per the v10 Divisions panel ruling (2026-07-12), the division page is the ONE
 * surface where the division mark LEADS (condition 2): a full-size typographic
 * display-face lockup, its discipline line locked to it (condition 4), a short
 * investor-readable paragraph, and the division's slate directly beneath, a
 * mark only ever appears with real properties under it (condition 5). No new
 * pictorial marks: the lockup is the house display face, one system across all
 * three (condition 6).
 *
 * v15 (Neon review N-036): every row carries its key frame (the same frame
 * markup as /slate), a territory division also lists the New Renaissance
 * Cinema features it co-produces (derived from Project.metaLine, "with (212)
 * Pictures"), and the page ends on two routes: the whole slate (count from the
 * public slate) and the contact desk. Provenance comes from Project.provenance
 * only (N-030).
 */
import type { V9SlateItem } from '../../lib/payload'
import { resolveMediaUrl, resolveMediaSrcset } from '../../lib/payload'
import { renderInline } from '../../lib/v9/inline'
import { countWord } from '../../lib/v9/site'

interface Props {
  division: '212' | '310' | 'nrc'
  /** The typographic lockup text, e.g. "(212) Pictures". */
  lockup: string
  /** One sentence: what the house makes, for whom (no em dashes). */
  discipline: string
  /** Short investor-readable paragraph (adapted from the panel copy draft). */
  paragraph: string
  /** The public properties this division owns, ordered. */
  slate: V9SlateItem[]
  /** NRC features this division co-produces (212 / 310 only), ordered. */
  coProductions?: V9SlateItem[]
  /** How many properties are on the whole public slate. */
  slateCount: number
}

const { division, lockup, discipline, paragraph, slate, coProductions = [], slateCount } = Astro.props

type Group = { label: string; aria: string; items: V9SlateItem[]; compact: boolean }
const groups: Group[] = [
  { label: 'The slate', aria: `${lockup} slate`, items: slate, compact: false },
  {
    label: 'Co-productions with New Renaissance Cinema',
    aria: `${lockup} co-productions with New Renaissance Cinema`,
    items: coProductions,
    compact: true,
  },
].filter((g) => g.items.length > 0)

const frameOf = (p: V9SlateItem) => ({
  src: resolveMediaUrl(p.heroImage as never) ?? null,
  srcset: resolveMediaSrcset(p.heroImage as never),
})
---

<header class="v9-col v9-divhead">
  <p class="v9-divhead__eyebrow">A division of APR 70 Pictures</p>
  <h1 class="v9-divhead__lockup" data-division={division}>{lockup}</h1>
  <p class="v9-divhead__discipline">{discipline}</p>
  <div class="v9-prose v9-divhead__prose"><p>{paragraph}</p></div>
</header>

{
  groups.map((g) => (
    <section class="v9-section v9-section--tight" aria-label={g.aria}>
      <div class="v9-col">
        <p class="v9-scene__slug v9-divhead__slatelabel">{g.label}</p>
        <ol class="v9-slatelist">
          {g.items.map((p) => {
            const frame = frameOf(p)
            const log = g.compact ? null : p.shortLogline || p.logline || null
            return (
              <li class="v9-slaterow">
                <a class="v9-slaterow__link" href={`/work/${p.slug}`}>
                  <span class="v9-slaterow__num" aria-hidden="true" />
                  <span class="v9-slaterow__body">
                    <p class="v9-slaterow__title">{p.title}</p>
                    {log && <p class="v9-slaterow__logline" set:html={renderInline(log)} />}
                    {!g.compact && p.provenance && (
                      <p class="v9-slaterow__provenance" set:html={renderInline(p.provenance)} />
                    )}
                    {p.metaLine && <p class="v9-slaterow__meta" set:html={renderInline(p.metaLine)} />}
                  </span>
                  {frame.src && (
                    <span class="v9-slaterow__frame" aria-hidden="true">
                      <img
                        src={frame.src}
                        srcset={frame.srcset}
                        sizes="(max-width: 900px) 0px, 33vw"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  )}
                </a>
              </li>
            )
          })}
        </ol>
      </div>
    </section>
  ))
}

<nav class="v9-section v9-section--tight v9-divroutes" aria-label="Next steps">
  <div class="v9-col v9-divroutes__row">
    <a class="v9-more" href="/slate">See all {countWord(slateCount)} titles on the slate →</a>
    <a class="v9-more" href="/contact">Request reading copies →</a>
  </div>
</nav>

<style>
  /* The division head: the one surface where the division mark leads (ruling
     condition 2). Full-size typographic lockup in the house display face. */
  .v9-divhead {
    padding-top: clamp(2rem, 6vw, 4.5rem);
  }
  .v9-divhead__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral);
    margin: 0 0 var(--space-md);
  }
  .v9-divhead__lockup {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-display);
    line-height: 1.0;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }
  .v9-divhead__discipline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.28;
    color: var(--color-muted);
    max-width: 34ch;
    margin: clamp(0.75rem, 2vw, 1.25rem) 0 0;
  }
  .v9-divhead__prose {
    margin-top: clamp(1.5rem, 3.5vw, 2.5rem);
    max-width: 60ch;
  }
  .v9-divhead__prose :global(p) {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink);
    margin: 0;
  }
  .v9-divhead__slatelabel {
    margin: 0 0 var(--space-md);
  }
  /* v15: the two closing routes (N-036), side by side, wrapping on phones. */
  .v9-divroutes__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) clamp(1.5rem, 4vw, 3rem);
  }
</style>
