---
/**
 * DividerBlock.astro — Structure Divider as a page-level block.
 * Clean horizontal rule with optional mono-spaced centered label.
 */
interface Props {
  block: {
    label?: string
    spacing?: 'compact' | 'normal' | 'wide'
  }
}

const { block } = Astro.props
const spacing = block.spacing || 'normal'
const spacingMap = {
  compact: 'var(--s-5)',
  normal: 'var(--s-7)',
  wide: 'var(--s-9)',
}
const pad = spacingMap[spacing]
---

<div class="divider-block" style={`padding: ${pad} 0`}>
  <div class="container divider-inner">
    <span class="divider-line" />
    {block.label && <span class="divider-label keycode">{block.label}</span>}
    <span class="divider-line" />
  </div>
</div>

<style>
  .divider-inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .divider-label {
    flex-shrink: 0;
    white-space: nowrap;
  }
</style>
