---
import Layout from '../layouts/Layout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { fetchDivisionNRCGlobal } from '../lib/payload';
import { V4_DIVISION_PASSAGES } from '../content/v4';

const { divisionNRC, error } = await fetchDivisionNRCGlobal();
const dbBlocks = divisionNRC?.layout || [];
// V4 zine: the bundle's division copy leads. Once the Payload layout carries
// a zinePassage block (apply-v4-content.ts), the DB version takes over.
const hasZine = dbBlocks.some((b) => (b as { blockType?: string }).blockType === 'zinePassage');
const blocks = hasZine ? dbBlocks : [V4_DIVISION_PASSAGES.nrc, ...dbBlocks];
// Themes are global + visitor-selected: the Payload `theme` field is dormant
// and divisions no longer force a skin (division logo/favicon still apply).
const faviconOverride = typeof divisionNRC?.faviconOverride === 'object' ? divisionNRC.faviconOverride : undefined;
const headerLogo = typeof divisionNRC?.headerLogo === 'object' ? divisionNRC.headerLogo : undefined;
const footerLogo = typeof divisionNRC?.footerLogo === 'object' ? divisionNRC.footerLogo : undefined;
---

<Layout title="NRC Division" faviconOverride={faviconOverride} navLogoOverride={headerLogo} navLogoAltOverride="New Renaissance Cinema" footerLogoOverride={footerLogo} footerLogoAltOverride="New Renaissance Cinema">
  <main>
    {error && (
      <div style="padding: 1rem; margin: 2rem auto; max-width: 600px; background: rgba(255,0,0,0.1); border: 1px solid red; border-radius: 4px; font-family: var(--font-body); color: #cc0000;">
        <strong>Fetch Error:</strong> {error}
      </div>
    )}
    <BlockRenderer blocks={blocks} />
  </main>
</Layout>
