---
/**
 * FilmstripBlock.astro — Cinematic horizontal image track with perforation bands.
 * Uses native CSS scroll-snap for zero-jank mobile performance.
 */
import { fetchProjects, resolveMediaUrl } from '../../lib/payload'

interface Props {
  block: {
    source: 'custom-media' | 'from-projects'
    format?: 'academy' | 'super35' | 'widescreen200' | 'imax' | 'v2-header' | 'v2-footer'
    projectFilter?: 'all' | '212' | '310' | 'nrc'
    tiles?: Array<{
      media: any
      caption?: string
      division?: string
    }>
    showPerforations?: boolean
  }
}

const { block } = Astro.props
const showPerfs = block.showPerforations !== false
const format = block.format || 'super35'

type ComputedTile = {
  url: string
  alt: string
  caption: string
  division: string
  href?: string
}

let computedTiles: ComputedTile[] = []

if (block.source === 'from-projects') {
  const { projects } = await fetchProjects()
  let filtered = projects || []
  if (block.projectFilter && block.projectFilter !== 'all') {
    filtered = filtered.filter(p => p.division === block.projectFilter)
  }
  for (const proj of filtered) {
    if (proj.heroImage && typeof proj.heroImage === 'object' && 'url' in proj.heroImage) {
      const media = proj.heroImage as any
      const url = resolveMediaUrl(media)
      if (url) {
        computedTiles.push({
          url,
          alt: media.alt || proj.title,
          caption: proj.title,
          division: proj.division || 'none',
          href: `/work/${proj.slug}`
        })
      }
    }
  }
} else {
  const rawTiles = block.tiles || []
  for (const tile of rawTiles) {
    if (tile.media) {
      const url = resolveMediaUrl(tile.media)
      if (url) {
        computedTiles.push({
          url,
          alt: tile.media.alt || tile.caption || '',
          caption: tile.caption || '',
          division: tile.division || 'none',
          href: undefined
        })
      }
    }
  }
}

const perfsPerFrame = format === 'imax' ? 15 : (format.startsWith('v2-') ? 24 : 4)

function getDivisionClass(div: string) {
  if (div === '212') return 'text-212'
  if (div === '310') return 'text-310'
  if (div === 'nrc') return 'text-nrc'
  return ''
}

const numLeaders = 8; // 8 blank frames of leader at start and end
---

<section 
  class="filmstrip-block" 
  data-format={format}
  aria-label={format.startsWith('v2-') ? "Filmstrip rail" : "Filmstrip gallery"}
  role={format.startsWith('v2-') ? "presentation" : "region"}
  aria-roledescription={format.startsWith('v2-') ? undefined : "carousel"}
>
  <div class="scroll-window" tabindex="0" role="group" aria-label="Slides">
    <div class="filmstrip-physical">
      
      {/* Top Edge Layer */}
      {showPerfs && !format.startsWith('v2-') && (
        <div class="edge-layer edge-top" aria-hidden="true">
          <div class="edge-gradient"></div>
        </div>
      )}

      {/* Unified Film Track */}
      <div class="film-track">
        
        {/* Head Leader */}
        {!format.startsWith('v2-') && Array.from({ length: numLeaders }).map((_, lIdx) => (
          <div class="film-segment leader-segment">
            {showPerfs && (
              <div class="perf-row top">
                {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
              </div>
            )}
            <div class="tile-frame leader-frame">
              {lIdx < 8 && <div class="countdown-text">{8 - lIdx}</div>}
            </div>
            {showPerfs && (
              <div class="perf-row bottom">
                {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
              </div>
            )}
          </div>
        ))}

        {/* Frames */}
        {computedTiles.map((tile, i) => {
          const Element = tile.href ? 'a' : 'div'
          return (
            <Element
              class={`film-segment filmstrip-tile ${format.startsWith('v2-') ? 'v2-segment' : ''}`}
              href={tile.href}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${computedTiles.length}`}
            >
              {/* Top Perfs & Edge Codes */}
              {showPerfs && (
                <div class="perf-row top">
                  {/* Top Edge Codes injected here to sync perfectly with the frame */}
                  {!format.startsWith('v2-') && (
                    <div class="edge-code-container top">
                      {format === 'super35' && i % 2 === 0 && (
                        <>
                          <span class="code code-yellow">KODAK 500T 5219 {83210 + i}</span>
                          <div class="edge-stripe edge-stripe-orange"></div>
                          <div class="edge-stripe edge-stripe-white"></div>
                        </>
                      )}
                      {format === 'imax' && i % 2 === 0 && (
                        <span class="code code-cyan">EASTMAN 5243 039 02401 {191 + i} 110</span>
                      )}
                    </div>
                  )}
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
              )}

              {/* The Frame */}
              {!format.startsWith('v2-') && (
                <div class="tile-frame">
                  <img src={tile.url} alt={tile.alt} loading="lazy" />
                  <div class="wireframe-cross"></div>
                </div>
              )}

              {/* Bottom Perfs & Edge Codes */}
              {showPerfs && (
                <div class="perf-row bottom">
                  {!format.startsWith('v2-') && (
                    <div class="edge-code-container bottom">
                      {format === 'academy' && i % 2 === 0 && (
                        <span class="code code-grey">SAFETY FILM A {1000 + i}</span>
                      )}
                      {format === 'widescreen200' && i % 2 === 0 && (
                        <span class="code code-maroon">ANSCO COLOR 848 {10 + i}</span>
                      )}
                      {format === 'imax' && i % 2 === 0 && (
                        <span class="code code-cyan">EV 93 4554 {4690 + i}+40• <span class="barcode">{i % 3 === 0 ? '||| || ||| ||' : '||| | ||| |||'}</span></span>
                      )}
                    </div>
                  )}
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
              )}
            </Element>
          )
        })}

        {/* Tail Leader */}
        {!format.startsWith('v2-') && Array.from({ length: numLeaders }).map((_, lIdx) => (
          <div class="film-segment leader-segment">
            {showPerfs && (
              <div class="perf-row top">
                {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
              </div>
            )}
            <div class="tile-frame leader-frame">
              {lIdx === 0 && <div class="countdown-text" style="font-size: 1rem;">PICTURE START</div>}
            </div>
            {showPerfs && (
              <div class="perf-row bottom">
                {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
              </div>
            )}
          </div>
        ))}

      </div>

      {/* Meta Track (Titles beneath the film strip) */}
      {!format.startsWith('v2-') && (
        <div class="meta-track">
          {/* Pad the meta track to align with the first actual frame */}
          <div class="meta-segment" style={`width: calc((${numLeaders} * (var(--frame-w) + var(--frame-gap))) - var(--frame-gap))`}></div>
          {computedTiles.map((tile) => (
            <div class="meta-segment">
              <div class="tile-meta">
                {tile.caption && <span class="tile-caption">{tile.caption}</span>}
                {tile.division !== 'none' && (
                  <span class={`tile-division ${getDivisionClass(tile.division)}`}>{tile.division.toUpperCase()}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Bottom Edge Layer */}
      {showPerfs && !format.startsWith('v2-') && (
        <div class="edge-layer edge-bottom" aria-hidden="true">
          <div class="edge-gradient"></div>
        </div>
      )}

    </div>
  </div>
</section>

<style>
  .filmstrip-block {
    width: 100%;
    overflow: hidden;
    padding: var(--s-7) 0;
    
    /* Default variables (35mm: Academy, Super35, Widescreen) */
    --perfs: 4;
    --hole-w: clamp(8px, 1.2vw, 14px);
    --hole-h: clamp(16px, 2.5vw, 24px);
    --hole-gap: clamp(16px, 2vw, 32px);
    --perf-pitch: calc(var(--hole-w) + var(--hole-gap));
    --segment-w: calc(var(--perf-pitch) * var(--perfs));
    --frame-gap: 4px; /* Frame lines thickness */
    --band-h: 32px;
    --hole-radius: var(--r-hole);
    --border-color: var(--rule);
  }

  /* Format Overrides */
  .filmstrip-block[data-format="academy"] {
    --frame-gap: 6px;
  }

  .filmstrip-block[data-format="widescreen200"] {
    --hole-h: clamp(14px, 2vw, 20px);
  }

  .filmstrip-block[data-format="imax"] {
    --perfs: 15;
    --hole-w: clamp(12px, 1.8vw, 18px);
    --hole-h: clamp(18px, 2.8vw, 28px);
    --hole-gap: clamp(24px, 3vw, 40px);
    --band-h: 40px;
    --hole-radius: 4px;
    --frame-gap: 8px;
  }

  .filmstrip-block[data-format="v2-header"],
  .filmstrip-block[data-format="v2-footer"] {
    --perfs: 24;
    --hole-w: 13px;
    --hole-h: 9px;
    --hole-gap: 16px;
    --band-h: 32px;
    --hole-radius: var(--r-hole);
    --border-color: #1e1e1e;
    padding: 0;
  }

  /* Scrolling Layout */
  .scroll-window {
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    padding: 0 var(--pad-x);
  }

  .scroll-window:focus-visible {
    outline: 2px solid var(--apr-imax);
    outline-offset: 2px;
  }

  .scroll-window::-webkit-scrollbar {
    display: none;
  }

  .filmstrip-block[data-format="v2-header"] .scroll-window,
  .filmstrip-block[data-format="v2-footer"] .scroll-window {
    -webkit-mask-image: none;
    mask-image: none;
    padding: 0;
  }

  .filmstrip-physical {
    display: flex;
    flex-direction: column;
    width: max-content;
    background: rgba(10, 10, 10, 0.7); /* Translucent film base */
    backdrop-filter: blur(4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    border-radius: 2px;
  }

  .filmstrip-block[data-format="v2-header"] .filmstrip-physical,
  .filmstrip-block[data-format="v2-footer"] .filmstrip-physical {
    background: #050505;
    backdrop-filter: none;
    box-shadow: none;
    border-radius: 0;
    width: 100vw;
  }

  /* Edges */
  .edge-layer {
    position: relative;
    height: 16px;
    width: 100%;
    overflow: hidden;
  }

  .edge-gradient {
    position: absolute;
    inset: 0;
    opacity: 0.8;
  }

  /* Gradients per format */
  .filmstrip-block[data-format="academy"] .edge-gradient {
    background: linear-gradient(to bottom, rgba(200,210,200,0.4) 0%, transparent 100%);
  }
  .filmstrip-block[data-format="academy"] .edge-bottom .edge-gradient {
    background: linear-gradient(to top, rgba(200,210,200,0.4) 0%, transparent 100%);
  }

  .filmstrip-block[data-format="super35"] .edge-gradient {
    background: linear-gradient(to bottom, rgba(175,122,72,0.8) 0%, transparent 100%);
  }
  
  .filmstrip-block[data-format="widescreen200"] .edge-gradient {
    background: linear-gradient(to bottom, rgba(209,122,34,0.8) 0%, transparent 100%);
  }
  .filmstrip-block[data-format="widescreen200"] .edge-bottom .edge-gradient {
    background: linear-gradient(to top, rgba(209,122,34,0.8) 0%, transparent 100%);
  }

  .filmstrip-block[data-format="imax"] .edge-gradient {
    background: linear-gradient(to bottom, rgba(43,132,146,0.8) 0%, transparent 100%);
  }
  .filmstrip-block[data-format="imax"] .edge-bottom .edge-gradient {
    background: linear-gradient(to top, rgba(43,132,146,0.8) 0%, transparent 100%);
  }

  /* Edge Codes */
  .edge-code-container {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    display: flex;
    align-items: center;
    z-index: 2;
    white-space: nowrap;
    pointer-events: none;
  }
  
  .edge-code-container.top { top: -16px; bottom: auto; height: 16px; }
  .edge-code-container.bottom { bottom: -16px; top: auto; height: 16px; }

  .code {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--track-strip);
    opacity: 0.9;
    text-transform: uppercase;
    margin-left: 20%; /* Offset into the frame */
  }
  .code-yellow { color: #ffd54f; }
  .code-cyan { color: #00e5ff; }
  .code-maroon { color: #800000; font-weight: bold; letter-spacing: 0.2em; }
  .code-grey { color: #555; font-weight: bold; }

  .barcode {
    font-weight: bold;
    letter-spacing: 2px;
    margin-left: 8px;
  }

  .edge-stripe {
    position: absolute;
    top: 0;
    bottom: 0;
  }
  .edge-stripe-orange {
    left: 0px;
    width: 6px;
    background: #ff5722;
  }
  .edge-stripe-white {
    left: 8px;
    width: 2px;
    background: #fff;
    opacity: 0.9;
  }

  /* Film Track & Segments */
  .film-track {
    display: flex;
    background: #020202; /* The frame lines will be this color */
    padding: 0 5vw;
  }

  .filmstrip-block[data-format="v2-header"] .film-track,
  .filmstrip-block[data-format="v2-footer"] .film-track {
    padding: var(--s-3) var(--pad-x);
    background: transparent;
  }

  .film-segment {
    width: var(--segment-w);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    position: relative;
    scroll-snap-align: center;
    text-decoration: none;
    color: var(--fg-1);
    outline: none;
  }

  /* Perfs inside segment */
  .perf-row {
    display: flex;
    align-items: center;
    height: var(--band-h);
    gap: var(--hole-gap);
    width: var(--segment-w);
    position: relative;
    /* Since width is exact and flex items leave a remainder on the right equal to var(--hole-gap), it sequences perfectly! */
  }

  .perf-hole {
    width: var(--hole-w);
    height: var(--hole-h);
    background: var(--bg-0); /* Punches through to page background */
    border-radius: var(--hole-radius);
    flex-shrink: 0;
    box-shadow: 
      inset 0 1px 3px rgba(0,0,0,0.8), 
      inset 0 -1px 1px rgba(255,255,255,0.2);
  }

  .filmstrip-block[data-format="v2-header"] .perf-hole,
  .filmstrip-block[data-format="v2-footer"] .perf-hole {
    box-shadow: none;
    border: 1.5px solid var(--border-color);
  }

  /* Frames inside segment */
  .tile-frame {
    position: relative;
    width: calc(var(--segment-w) - var(--frame-gap));
    /* Deriving height from the fixed perfect width! */
    height: calc((var(--segment-w) - var(--frame-gap)) / var(--aspect)); 
    overflow: hidden;
    background: #111;
    border-radius: 2px;
    margin-right: var(--frame-gap); /* This right margin acts as the black frame line! */
  }

  /* Fallback for aspect since CSS calc with division by variable is tricky if aspect is not purely a number. 
     Wait, --aspect is e.g. "2.39 / 1" which doesn't work in calc(). 
     Let's use aspect-ratio instead! */
  .tile-frame {
    height: auto;
    aspect-ratio: var(--aspect);
  }

  .leader-frame {
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .countdown-text {
    font-family: var(--font-mono);
    font-size: 3rem;
    color: rgba(255, 255, 255, 0.2);
    font-weight: bold;
    letter-spacing: 2px;
  }

  .wireframe-cross {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.15;
    background-image: 
      linear-gradient(to bottom right, transparent calc(50% - 1px), #fff calc(50% - 1px), #fff calc(50% + 1px), transparent calc(50% + 1px)),
      linear-gradient(to top right, transparent calc(50% - 1px), #fff calc(50% - 1px), #fff calc(50% + 1px), transparent calc(50% + 1px));
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .tile-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
    transition: transform var(--dur-base) var(--ease-out), filter var(--dur-base) var(--ease-out);
  }

  .filmstrip-tile:hover .tile-frame img,
  .filmstrip-tile:focus-visible .tile-frame img {
    transform: scale(1.03);
    filter: saturate(1.15) contrast(1.1);
  }

  .filmstrip-tile:focus-visible .tile-frame {
    outline: 2px solid var(--apr-imax);
    outline-offset: 4px;
  }

  /* Meta Track */
  .meta-track {
    display: flex;
    padding: 0 5vw;
  }
  
  .meta-segment {
    width: var(--segment-w);
    flex-shrink: 0;
  }

  .tile-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--s-3);
    margin-right: var(--frame-gap);
    gap: var(--s-3);
  }

  .tile-caption {
    font-family: var(--font-body);
    font-size: var(--type-caption);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--fg-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
  }

  .tile-division {
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-strip);
    color: var(--muted);
    flex-shrink: 0;
  }
</style>
