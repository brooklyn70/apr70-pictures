---
import type { DispatchIssueDoc } from '../../lib/payload'

interface Props {
  items: DispatchIssueDoc['dispatches']
}

const DIVISION_META: Record<'212' | '310' | 'nrc', { label: string; color: string }> = {
  '212': { label: '(212) PICTURES', color: 'var(--apr-amber)' },
  '310': { label: '(310) PICTURES', color: 'var(--apr-teal)' },
  nrc: { label: 'NEW RENAISSANCE CINEMA', color: 'var(--apr-offwhite)' },
}

const { items } = Astro.props
const itemsList = items ?? []
---

<section class="dispatches" aria-label="Slate dispatches">
  {itemsList.map((d) => {
    const meta = DIVISION_META[d.division] ?? DIVISION_META['212']
    return (
      <article class="dispatch-card">
        <div class="accent-bar" style={`background: ${meta.color}`}></div>
        <div class="dispatch-card-head">
          <span class="dispatch-card-div" style={`color: ${meta.color}`}>{meta.label}</span>
          <span class="dispatch-card-date">{d.date}</span>
        </div>
        <h3 class="dispatch-card-title">{d.title}</h3>
        <p class="dispatch-card-body">{d.body}</p>
        <div class="dispatch-card-foot">
          <span class="dispatch-card-status">{d.status}</span>
          <span class="dispatch-card-link">{d.link} →</span>
        </div>
        <div class="dispatch-card-ghost" aria-hidden="true">{d.ghost}</div>
      </article>
    )
  })}
</section>
