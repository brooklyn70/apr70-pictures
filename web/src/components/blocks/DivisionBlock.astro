---
/**
 * DivisionBlock.astro — Division Showcase renderer.
 * Supports v0-baseline, v3-baseline-filmstrip, and v4-animated-filmstrip.
 */
import FilmstripBlock from './FilmstripBlock.astro'
import { resolveMediaUrl } from '../../lib/payload'

interface Division {
  name: string
  colorToken: string
  subtitle?: string
  description?: string
  media?: any
}

interface Props {
  block: {
    variant: string
    heading?: string
    subtext?: string
    divisions: Division[]
  }
}

const { block } = Astro.props
const variant = block.variant ?? 'v0-baseline'
const divisions = block.divisions ?? []

function tokenToVar(token: string): string {
  return `var(--color-${token})`
}

function getProjectFilter(name: string): 'all' | '212' | '310' | 'nrc' {
  const n = name.toLowerCase()
  if (n.includes('212')) return '212'
  if (n.includes('310')) return '310'
  if (n.includes('nrc')) return 'nrc'
  return 'all'
}

function getFormat(name: string): 'super35' | 'widescreen200' | 'academy' {
  const n = name.toLowerCase()
  if (n.includes('310')) return 'widescreen200'
  if (n.includes('nrc')) return 'academy'
  return 'super35'
}
---

{variant === 'v0-baseline' && (
  <section class="division-showcase v0-baseline">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="division-rows container">
      {divisions.map((div, i) => {
        const num = String(i + 1).padStart(2, '0')
        const color = tokenToVar(div.colorToken)
        return (
          <div class="division-row" style={`--div-color: ${color}`}>
            <span class="ghost-num" aria-hidden="true">{num}</span>
            <div class="division-content">
              <span class="eyebrow">{num}</span>
              <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
              {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
              {div.description && (
                <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
              )}
            </div>
          </div>
        )
      })}
    </div>
  </section>
)}

{variant === 'v3-baseline-filmstrip' && (
  <section class="division-showcase v3-baseline dark-mode-enforcer" data-theme="dark">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="division-rows">
      {divisions.map((div, i) => {
        const num = String(i + 1).padStart(2, '0')
        const color = tokenToVar(div.colorToken)
        const format = getFormat(div.name)
        const filter = getProjectFilter(div.name)
        return (
          <div class="division-row" style={`--div-color: ${color}`}>
            <div class="container position-relative">
              <span class="ghost-num" aria-hidden="true">{num}</span>
              <div class="division-content">
                <span class="eyebrow">{num}</span>
                <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
                {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
                {div.description && (
                  <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
                )}
              </div>
            </div>
            <div class="filmstrip-wrapper">
               <FilmstripBlock block={{ source: 'from-projects', projectFilter: filter, format: format, showPerforations: true }} />
            </div>
          </div>
        )
      })}
    </div>
  </section>
)}

{variant === 'v4-animated-filmstrip' && (
  <section class="division-showcase v4-animated dark-mode-enforcer" data-theme="dark">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="division-rows">
      {divisions.map((div, i) => {
        const num = String(i + 1).padStart(2, '0')
        const color = tokenToVar(div.colorToken)
        const format = getFormat(div.name)
        const filter = getProjectFilter(div.name)
        return (
          <div class="division-row" style={`--div-color: ${color}`}>
            <div class="container position-relative">
              <span class="ghost-num" aria-hidden="true">{num}</span>
              <div class="division-content">
                <span class="eyebrow">{num}</span>
                <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
                {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
                {div.description && (
                  <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
                )}
              </div>
            </div>
            <div class="filmstrip-wrapper animated-filmstrip-track">
               <FilmstripBlock block={{ source: 'from-projects', projectFilter: filter, format: format, showPerforations: true }} />
            </div>
          </div>
        )
      })}
    </div>
  </section>
)}

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const tracks = document.querySelectorAll('.animated-filmstrip-track .scroll-window');
    
    tracks.forEach((track) => {
      const segments = track.querySelectorAll('.film-segment');
      const firstTileIndex = Array.from(segments).findIndex(s => s.classList.contains('filmstrip-tile'));
      
      if (firstTileIndex > 0) {
        const targetElement = segments[firstTileIndex] as HTMLElement;
        
        ScrollTrigger.create({
          trigger: track,
          start: 'top 80%',
          once: true,
          onEnter: () => {
             const paddingLeft = parseInt(window.getComputedStyle(track).paddingLeft || '0');
             const targetScroll = targetElement.offsetLeft - paddingLeft;
             
             // Temporarily disable scroll snapping so GSAP doesn't fight the browser
             const originalSnap = (track as HTMLElement).style.scrollSnapType;
             (track as HTMLElement).style.scrollSnapType = 'none';

             gsap.to(track, {
               scrollLeft: targetScroll,
               duration: 2.5,
               ease: 'power2.inOut',
               onComplete: () => {
                 (track as HTMLElement).style.scrollSnapType = originalSnap;
               }
             });
          }
        });
      }
    });
  });
</script>

<style>
  /* Base styles */
  .division-showcase {
    padding: var(--s-9) 0;
  }
  .division-header {
    text-align: center;
    margin-bottom: var(--s-9);
  }
  .division-header .body-lg {
    max-width: 640px;
    margin: var(--s-5) auto 0;
    color: var(--fg-3);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-4);
    display: block;
    margin-bottom: var(--s-3);
  }
  .division-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: var(--track-tight);
    margin-bottom: var(--s-4);
    text-transform: uppercase;
  }
  .division-subtitle {
    display: block;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(0.8125rem, 1vw, 0.875rem);
    color: var(--fg-4);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    margin-bottom: var(--s-5);
  }
  .division-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--fg-2);
    line-height: 1.72;
    max-width: 620px;
    margin: 0;
  }

  /* Baseline layout */
  .division-rows {
    display: flex;
    flex-direction: column;
  }
  .division-row {
    position: relative;
    border-top: 1px solid var(--rule);
    padding: var(--s-9) 0;
    overflow: hidden;
  }
  .position-relative {
    position: relative;
  }
  .ghost-num {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 16vw, 14rem);
    color: var(--fg-6);
    line-height: 1;
    letter-spacing: var(--track-tight);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .division-content {
    position: relative;
    max-width: 780px;
    z-index: 1;
  }

  /* Dark mode enforcer (Filmstrips) */
  .dark-mode-enforcer {
    background: transparent;
    color: var(--fg-1);
  }

  .filmstrip-wrapper {
    margin-top: var(--s-7);
    width: 100%;
  }
</style>
