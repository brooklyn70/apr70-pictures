    {
      "id": "69fea32c668925d99913941f",
      "route": "/work",
      "quotes": [
        {
          "id": "69fea32c668925d999139418",
          "quote": "The whole point of making a film is to have your version of a story told.",
          "attribution": "Ridley Scott"
        },
        {
          "id": "69fea32c668925d999139419",
          "quote": "You've got to find the story you want to tell.",
          "attribution": "Anthony Minghella"
        },
        {
          "id": "69fea32c668925d99913941a",
          "quote": "Filmmaking is a chance to live many lifetimes.",
          "attribution": "Robert Altman"
        },
        {
          "id": "69fea32c668925d99913941b",
          "quote": "Movies are a complicated collision of literature, theatre, music, and all the visual arts.",
          "attribution": "Stanley Kubrick"
        },
        {
          "id": "69fea32c668925d99913941c",
          "quote": "The enemy of art is the absence of limitations.",
          "attribution": "Orson Welles"
        },
        {
          "id": "69fea32c668925d99913941d",
          "quote": "Every scene should be able to function as its own short film.",
          "attribution": "Paul Thomas Anderson"
        },
        {
          "id": "69fea32c668925d99913941e",
          "quote": "No art passes our conscience in the way film does, and goes directly to our feelings.",
          "attribution": "Ingmar Bergman"
        }
      ]
