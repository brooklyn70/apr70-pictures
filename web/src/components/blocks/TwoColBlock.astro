---
import type { Home } from 'payload-types'
import { richTextLexicalToHtml } from '../../lib/lexicalToHtml'

type TwoColBlockType = Extract<
  NonNullable<NonNullable<Home['layout']>[number]>,
  { blockType: 'twoCol' }
>

interface Props {
  block: TwoColBlockType
}

const { block } = Astro.props

const html = richTextLexicalToHtml(block.rightBody ?? undefined)

const ratioClass = `ratio-${block.ratio}`
const alignmentClass = `align-${block.alignment}`
---

<section class={`twocol-block ${ratioClass} ${alignmentClass}`} aria-label={block.leftHeading}>
  <div class="twocol-block__left">
    <h2 class="twocol-block__heading">{block.leftHeading}</h2>
  </div>
  <div class="twocol-block__right">
    {html ? <div class="payload-richtext" set:html={html} /> : null}
  </div>
</section>

<style>
  .twocol-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-3);
    box-sizing: border-box;
    width: 100%;
    max-width: var(--max-content);
    margin: 0 auto;
  }

  .twocol-block.align-top {
    align-items: start;
  }

  .twocol-block.align-center {
    align-items: center;
  }

  /* Ratios on larger screens */
  @media (min-width: 768px) {
    .twocol-block.ratio-1-3 {
      grid-template-columns: 1fr 3fr;
    }
    .twocol-block.ratio-1-1 {
      grid-template-columns: 1fr 1fr;
    }
    .twocol-block.ratio-1-2 {
      grid-template-columns: 1fr 2fr;
    }
    .twocol-block {
      gap: var(--s-8);
      padding: var(--s-8) var(--s-6);
    }
  }

  @media (min-width: 1024px) {
    .twocol-block {
      padding: var(--s-8) var(--s-9);
    }
  }

  .twocol-block__heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--type-h2);
    line-height: var(--leading-snug);
    letter-spacing: var(--track-tight);
    color: var(--fg-1);
    text-transform: uppercase;
  }

  .twocol-block__right {
    min-width: 0;
  }

  /* Scoped RichText styling */
  .twocol-block__right :global(.payload-richtext) {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-body);
    line-height: var(--leading-body);
    color: var(--fg-2);
  }
  
  .twocol-block__right :global(.payload-richtext p) {
    margin: 0 0 var(--s-5);
  }
  
  .twocol-block__right :global(.payload-richtext p:last-child) {
    margin-bottom: 0;
  }

  .twocol-block__right :global(.payload-richtext a) {
    color: var(--fg-1);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: opacity var(--dur-base) var(--ease-in);
  }
  
  .twocol-block__right :global(.payload-richtext a:hover) {
    opacity: 0.7;
  }
</style>
