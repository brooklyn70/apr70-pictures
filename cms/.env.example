# ── Database ──────────────────────────────────────────────────────────────────
# Local/NAS Docker default:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/apr70_cms
#
# Supabase — THE LAW (VMS lesson #1):
#   Runtime AND builds use the TRANSACTION pooler on :6543:
#     DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   The SESSION pooler (:5432) is ONLY for the one-shot dump/restore in
#   scripts/migrate-db-to-supabase.sh. It caps at ~15 clients; a build through
#   it exhausts the cap and silently serves fallback content that looks like
#   missing data. Never put a :5432 Supabase URI here.

PAYLOAD_SECRET=YOUR_SECRET_HERE

# ── Postgres pool (defaults shown; tiny on purpose for serverless) ────────────
# DB_POOL_MAX=4
# DB_POOL_MIN=0
# DB_POOL_IDLE_TIMEOUT_MS=10000
# DB_POOL_CONN_TIMEOUT_MS=5000

# ── Media storage — Cloudflare R2 via S3 adapter ─────────────────────────────
# Inert when S3_BUCKET is unset (NAS/local keep writing to ./media on disk).
# REQUIRED on Vercel: its filesystem is ephemeral, disk uploads vanish.
# S3_BUCKET=apr70-media
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
