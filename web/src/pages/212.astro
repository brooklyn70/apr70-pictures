---
/**
 * /212 - the (212) Pictures division page (v9 chrome, marquee design).
 * Rebuilt 2026-07-12 to the v10 Divisions panel ruling: full-size typographic
 * lockup, discipline line, investor paragraph, and the division's own slate.
 */
import V9Layout from '../layouts/V9Layout.astro'
import DivisionPage from '../components/v9/DivisionPage.astro'
import { fetchDivisionSlate, fetchV9SlateProjects } from '../lib/payload'
import { plainText } from '../lib/v9/inline'
import { NAP } from '../lib/v9/site'

const [{ slate }, { slate: whole }] = await Promise.all([
  fetchDivisionSlate('212'),
  fetchV9SlateProjects(),
])
// v15 (N-036): the NRC features this house co-produces, read from the one
// billing source, Project.metaLine ("... with (212) Pictures ..."). No new field.
const coProductions = whole.filter((p) =>
  plainText(p.metaLine).toLowerCase().includes('with (212) pictures'),
)

const lockup = '(212) Pictures'
const discipline = 'New York television at street level, built from the five boroughs.'
const paragraph =
  // v15: Neon's text (N-035), copied from the review / round 1 answers.
  'Crime, drama, and documentary set inside the five boroughs, from City Hall to Borough Park, Red Hook, Sea Gate, and Staten Island. When a New York story belongs on the big screen, New Renaissance Cinema leads and (212) Pictures co-produces.'
const title = `${lockup} · ${NAP.name}`
---

<V9Layout title={title} description={discipline} division="212">
  <DivisionPage
    division="212"
    lockup={lockup}
    discipline={discipline}
    paragraph={paragraph}
    slate={slate}
    coProductions={coProductions}
    slateCount={whole.length}
  />
</V9Layout>
