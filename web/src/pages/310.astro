---
/**
 * /310 - the (310) Pictures division page (v9 chrome, marquee design).
 * Rebuilt 2026-07-12 to the v10 Divisions panel ruling: full-size typographic
 * lockup, discipline line, investor paragraph, and the division's own slate.
 * Staging note (Selznick): the flagship L.A. Dolce Vita sits on top of the slate.
 */
import V9Layout from '../layouts/V9Layout.astro'
import DivisionPage from '../components/v9/DivisionPage.astro'
import { fetchDivisionSlate } from '../lib/payload'
import { NAP } from '../lib/v9/site'

const { slate } = await fetchDivisionSlate('310')

const lockup = '(310) Pictures'
const discipline = 'Television for audiences who travel, staged out of Los Angeles.'
const paragraph =
  '(310) Pictures makes television for audiences who travel. Political thrillers, science fiction, and hybrid formats that interrogate genre without talking down to the room, staged out of Los Angeles with reach into international markets. The flagship series L.A. Dolce Vita anchors the house. When a (310) story begins as a feature it carries the New Renaissance Cinema banner and (310) joins as co-production.'
const title = `${lockup} · ${NAP.name}`
---

<V9Layout title={title} description={discipline} division="310">
  <DivisionPage
    division="310"
    lockup={lockup}
    discipline={discipline}
    paragraph={paragraph}
    slate={slate}
  />
</V9Layout>
