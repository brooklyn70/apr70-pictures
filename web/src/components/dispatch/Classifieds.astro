---
import type { DispatchIssueDoc } from '../../lib/payload'

interface Props {
  items: DispatchIssueDoc['classifieds']
}

const { items } = Astro.props
const itemsList = items ?? []
---

<section class="classifieds" aria-label="Back of book -- open calls and notices">
  <div class="classifieds-grid">
    {itemsList.map((c) => (
      <div class="classified">
        <span class="classified-cat">{c.cat}</span>
        <span class="classified-title">{c.title}</span>
        <span class="classified-body">{c.body}</span>
        <span class="classified-meta">{c.meta}</span>
      </div>
    ))}
  </div>
</section>
