---
/**
 * DivisionBlock.astro — Division Showcase renderer.
 * Supports 6 visual variants for Phase 6.
 */
import DivisionAccordionIsland from '../islands/DivisionAccordionIsland'
import FilmstripBlock from './FilmstripBlock.astro'
import { resolveMediaUrl } from '../../lib/payload'

interface Division {
  name: string
  colorToken: string
  subtitle?: string
  description?: string
  media?: any
}

interface Props {
  block: {
    variant: string
    heading?: string
    subtext?: string
    divisions: Division[]
  }
}

const { block } = Astro.props
const variant = block.variant ?? 'v0-baseline'
const divisions = block.divisions ?? []

function tokenToVar(token: string): string {
  return `var(--color-${token})`
}

function getProjectFilter(name: string): 'all' | '212' | '310' | 'nrc' {
  const n = name.toLowerCase()
  if (n.includes('212')) return '212'
  if (n.includes('310')) return '310'
  if (n.includes('nrc')) return 'nrc'
  return 'all'
}

function getFormat(name: string): 'super35' | 'imax' | 'academy' {
  const n = name.toLowerCase()
  if (n.includes('310')) return 'imax'
  if (n.includes('nrc')) return 'academy'
  return 'super35'
}
---

{variant === 'v0-baseline' && (
  <section class="division-showcase v0-baseline">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="division-rows container">
      {divisions.map((div, i) => {
        const num = String(i + 1).padStart(2, '0')
        const color = tokenToVar(div.colorToken)
        return (
          <div class="division-row" style={`--div-color: ${color}`}>
            <span class="ghost-num" aria-hidden="true">{num}</span>
            <div class="division-content">
              <span class="eyebrow">{num}</span>
              <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
              {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
              {div.description && (
                <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
              )}
            </div>
          </div>
        )
      })}
    </div>
  </section>
)}

{variant === 'v1-accordion' && (
  <div class="v1-accordion-wrapper">
    <DivisionAccordionIsland client:visible block={block} />
  </div>
)}

{variant === 'v2-cards' && (
  <section class="division-showcase v2-cards">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="cards-scroll-container">
      <div class="cards-track">
        {divisions.map((div, i) => {
          const num = String(i + 1).padStart(2, '0')
          const color = tokenToVar(div.colorToken)
          const mediaSrc = resolveMediaUrl(div.media)
          return (
            <div class="division-card" style={`--div-color: ${color}; border-top: 4px solid ${color};`}>
              <div class="card-inner">
                <span class="eyebrow">{num}</span>
                <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
                {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
                {div.description && (
                  <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
                )}
                {mediaSrc && (
                   <img src={mediaSrc} alt={div.media?.alt || div.name} class="card-media" loading="lazy" />
                )}
              </div>
            </div>
          )
        })}
      </div>
    </div>
  </section>
)}

{variant === 'v3-baseline-filmstrip' && (
  <section class="division-showcase v3-baseline dark-mode-enforcer" data-theme="dark">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="division-rows">
      {divisions.map((div, i) => {
        const num = String(i + 1).padStart(2, '0')
        const color = tokenToVar(div.colorToken)
        const format = getFormat(div.name)
        const filter = getProjectFilter(div.name)
        return (
          <div class="division-row" style={`--div-color: ${color}`}>
            <div class="container position-relative">
              <span class="ghost-num" aria-hidden="true">{num}</span>
              <div class="division-content">
                <span class="eyebrow">{num}</span>
                <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
                {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
                {div.description && (
                  <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
                )}
              </div>
            </div>
            <div class="filmstrip-wrapper">
               <FilmstripBlock block={{ source: 'from-projects', projectFilter: filter, format: format, showPerforations: true }} />
            </div>
          </div>
        )
      })}
    </div>
  </section>
)}

{variant === 'v4-accordion-filmstrip' && (
  <section class="division-showcase v4-accordion dark-mode-enforcer" data-theme="dark">
    <div class="container">
      {block.heading && (
        <div class="division-header">
          <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
          {block.subtext && (
            <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
          )}
        </div>
      )}

      <div class="accordion-native-list">
        {divisions.map((div, i) => {
          const num = String(i + 1).padStart(2, '0')
          const color = tokenToVar(div.colorToken)
          const format = getFormat(div.name)
          const filter = getProjectFilter(div.name)
          return (
            <details class="accordion-native-item" name="division-accordion" open={i === 0}>
              <summary class="accordion-native-summary">
                <div class="summary-left">
                  <span class="eyebrow-mono">{num}</span>
                  <h3 class="division-name-small" style={`color: ${color}`}>{div.name}</h3>
                </div>
                <div class="summary-icon">
                  <span class="icon-h"></span>
                  <span class="icon-v"></span>
                </div>
              </summary>
              <div class="accordion-native-body">
                <div class="accordion-native-text">
                  {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
                  {div.description && (
                    <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
                  )}
                </div>
                <div class="filmstrip-wrapper">
                   <FilmstripBlock block={{ source: 'from-projects', projectFilter: filter, format: format }} />
                </div>
              </div>
            </details>
          )
        })}
      </div>
    </div>
  </section>
)}

{variant === 'v5-cards-filmstrip' && (
  <section class="division-showcase v5-cards dark-mode-enforcer" data-theme="dark">
    {block.heading && (
      <div class="division-header container">
        <h2 class="h2" set:html={block.heading.replace(/\n/g, '<br />')} />
        {block.subtext && (
          <p class="body-lg" set:html={block.subtext.replace(/\n/g, '<br />')} />
        )}
      </div>
    )}

    <div class="cards-scroll-container">
      <div class="cards-track">
        {divisions.map((div, i) => {
          const num = String(i + 1).padStart(2, '0')
          const color = tokenToVar(div.colorToken)
          const format = getFormat(div.name)
          const filter = getProjectFilter(div.name)
          return (
            <div class="division-card card-filmstrip-variant" style={`border-top: 4px solid ${color};`}>
              <div class="card-inner">
                <span class="eyebrow">{num}</span>
                <h3 class="division-name" style={`color: ${color}`}>{div.name}</h3>
                {div.subtitle && <span class="division-subtitle">{div.subtitle}</span>}
                {div.description && (
                  <p class="division-desc" set:html={div.description.replace(/\n/g, '<br />')} />
                )}
              </div>
              <div class="card-filmstrip-wrapper">
                 <FilmstripBlock block={{ source: 'from-projects', projectFilter: filter, format: format }} />
              </div>
            </div>
          )
        })}
      </div>
    </div>
  </section>
)}

<style>
  /* Base styles */
  .division-showcase {
    padding: var(--s-9) 0;
  }
  .division-header {
    text-align: center;
    margin-bottom: var(--s-9);
  }
  .division-header .body-lg {
    max-width: 640px;
    margin: var(--s-5) auto 0;
    color: var(--fg-3);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-4);
    display: block;
    margin-bottom: var(--s-3);
  }
  .eyebrow-mono {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-4);
  }
  .division-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: var(--track-tight);
    margin-bottom: var(--s-4);
    text-transform: uppercase;
  }
  .division-name-small {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    line-height: 1;
    text-transform: uppercase;
  }
  .division-subtitle {
    display: block;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(0.8125rem, 1vw, 0.875rem);
    color: var(--fg-4);
    letter-spacing: var(--track-wide);
    text-transform: uppercase;
    margin-bottom: var(--s-5);
  }
  .division-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--fg-2);
    line-height: 1.72;
    max-width: 620px;
    margin: 0;
  }

  /* v0 & v3 Baseline layout */
  .division-rows {
    display: flex;
    flex-direction: column;
  }
  .division-row {
    position: relative;
    border-top: 1px solid var(--rule);
    padding: var(--s-9) 0;
    overflow: hidden;
  }
  .position-relative {
    position: relative;
  }
  .ghost-num {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 16vw, 14rem);
    color: var(--fg-6);
    line-height: 1;
    letter-spacing: var(--track-tight);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .division-content {
    position: relative;
    max-width: 780px;
    z-index: 1;
  }

  /* v1 Accordion wrapper */
  .v1-accordion-wrapper {
    padding: var(--s-9) 0;
  }

  /* v2 & v5 Cards */
  .cards-scroll-container {
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0 var(--s-4) var(--s-6) var(--s-4);
  }
  .cards-scroll-container::-webkit-scrollbar {
    display: none;
  }
  .cards-track {
    display: flex;
    gap: var(--s-6);
    width: max-content;
    padding: 0 calc(50vw - 320px);
  }
  @media (max-width: 768px) {
    .cards-track {
      padding: 0 var(--s-4);
    }
  }
  .division-card {
    scroll-snap-align: center;
    background: var(--bg-2);
    width: 80vw;
    max-width: 480px;
    border-radius: 4px;
    padding: var(--s-7);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }
  .card-media {
    margin-top: var(--s-6);
    width: 100%;
    height: auto;
    border-radius: 2px;
    object-fit: cover;
    aspect-ratio: 16/9;
  }

  /* Dark mode enforcer (Filmstrips) */
  .dark-mode-enforcer {
    background: var(--bg-1);
    color: var(--fg-1);
  }
  /* Force dark backing plane inside the enforcer to ensure authentic filmstrip darkmode */
  .dark-mode-enforcer :global(.filmstrip-block) {
    --backing-plane: #000000;
  }

  .filmstrip-wrapper {
    margin-top: var(--s-7);
    width: 100%;
  }

  /* v4 Native Accordion overrides */
  .accordion-native-list {
    border-top: 1px solid var(--rule);
  }
  .accordion-native-item {
    border-bottom: 1px solid var(--rule);
  }
  .accordion-native-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--s-6) 0;
    cursor: pointer;
    list-style: none;
  }
  .accordion-native-summary::-webkit-details-marker {
    display: none;
  }
  .summary-left {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }
  .summary-icon {
    width: 24px;
    height: 24px;
    position: relative;
    transition: transform 0.4s var(--ease-out);
  }
  .icon-h, .icon-v {
    position: absolute;
    background: var(--fg-1);
  }
  .icon-h { top: 11px; left: 0; width: 24px; height: 2px; }
  .icon-v { top: 0; left: 11px; width: 2px; height: 24px; transition: transform 0.4s var(--ease-out); }
  
  .accordion-native-item[open] .summary-icon {
    transform: rotate(90deg);
  }
  .accordion-native-item[open] .icon-v {
    transform: scaleY(0);
  }
  .accordion-native-body {
    padding-left: calc(var(--s-5) + 20px);
    padding-bottom: var(--s-8);
  }
  .accordion-native-text {
    margin-bottom: var(--s-6);
  }

  /* v5 Cards Filmstrip overrides */
  .card-filmstrip-variant {
    max-width: 800px;
    width: 85vw;
    padding: var(--s-7) 0;
    background: transparent;
    border-radius: 0;
  }
  .card-filmstrip-variant .card-inner {
    padding: 0 var(--s-7);
  }
  .card-filmstrip-wrapper {
    width: 100%;
  }
</style>
