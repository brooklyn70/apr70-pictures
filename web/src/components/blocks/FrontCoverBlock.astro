---
/**
 * FrontCoverBlock.astro — the front-door cover story (Troupe teaser No. 1).
 *
 * Left column: orange eyebrow, the stacked display L.A. / DOLCE / VITA (third
 * line an outlined italic ghost), the deck, the CTA to /troupe. Right column:
 * a real public-domain cover plate (OWI radio rehearsal, 1942) with a quiet
 * period-caption credit, then the numbered coverlines (02 / 03).
 *
 * Motion (screening-room.ts): display lines wipe in like a film gate and drift
 * on scrub ([data-motion="cover-line"], trigger [data-motion="cover"]); the head
 * dissolves on exit ([data-motion="dissolve-head"]); deck + CTA reveal
 * ([data-motion="cover-reveal"]); the plate settles ([data-motion="cover-plate"]).
 * SSR default is fully visible.
 */
import type { FrontCoverData } from '../../content/v4'

interface Props {
  block: FrontCoverData
}

const { block } = Astro.props
---

<section class="front-cover" data-motion="cover" aria-label="Cover story">
  <div class="container front-cover__grid">
    <div class="front-cover__lede">
      <p class="front-cover__eyebrow leader-eyebrow">{block.eyebrow}</p>
      <h2 class="front-cover__display" data-motion="dissolve-head">
        {block.display.map((line) => (
          <span class:list={['front-cover__line', { ghost: line.ghost }]} data-motion="cover-line">
            {line.text}
          </span>
        ))}
      </h2>
      <p class="front-cover__deck" data-motion="cover-reveal">{block.deck}</p>
      <a class="front-cover__cta" href={block.cta.href} data-motion="cover-reveal">{block.cta.label}</a>
    </div>

    <figure class="front-cover__plate" data-motion="cover-plate">
      <img
        class="front-cover__img"
        src={block.plate.src}
        srcset={block.plate.srcset}
        sizes="(min-width: 900px) 40vw, 100vw"
        width={block.plate.width}
        height={block.plate.height}
        alt={block.plate.alt}
        loading="lazy"
        decoding="async"
      />
      <figcaption class="front-cover__credit">{block.plate.credit}</figcaption>

      <div class="front-cover__coverlines">
        {block.coverlines.map((cl) => (
          <div class="front-cover__coverline">
            <span class="front-cover__coverline-num">{cl.num}</span>
            <div>
              <h3 class="front-cover__coverline-title">{cl.title}</h3>
              <p class="front-cover__coverline-text">{cl.text}</p>
            </div>
          </div>
        ))}
      </div>
    </figure>
  </div>
</section>

<style>
  .front-cover {
    border-bottom: 1px solid var(--rule);
  }

  .front-cover__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    padding: clamp(3rem, 6vw, 5.5rem) 0;
    align-items: end;
  }
  @media (min-width: 900px) {
    .front-cover__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  /* ── Lede column ── */
  .front-cover__eyebrow {
    margin: 0 0 clamp(1.25rem, 3vw, 2rem);
  }

  .front-cover__display {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(2.75rem, 9vw, 8.5rem);
    line-height: 0.88;
    letter-spacing: -0.015em;
    color: var(--fg-1);
    margin: 0;
  }
  .front-cover__line {
    display: block;
    /* the gate-wipe (clip-path) animates from JS; visible by default */
  }
  .front-cover__display .ghost {
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--fg-1) 65%, transparent);
    font-style: italic;
    font-weight: 700;
  }

  .front-cover__deck {
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--type-body-lg);
    line-height: var(--leading-body);
    color: var(--fg-2);
    max-width: 46ch;
  }

  .front-cover__cta {
    display: inline-block;
    margin-top: clamp(1.5rem, 3vw, 2.2rem);
    font-family: var(--font-body);
    font-size: var(--type-caption);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--fg-2);
    border: 1px solid var(--rule-strong);
    padding: 14px 28px;
    transition:
      background var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .front-cover__cta:hover,
  .front-cover__cta:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }

  /* ── Plate column ── */
  .front-cover__plate {
    margin: 0;
    position: relative;
  }
  .front-cover__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    background: var(--bg-2);
  }
  .front-cover__credit {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fg-4);
  }

  .front-cover__coverlines {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    border-top: 1px solid var(--rule);
  }
  .front-cover__coverline {
    display: flex;
    gap: var(--s-5);
    padding: clamp(0.9rem, 2vw, 1.1rem) 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .front-cover__coverline-num {
    font-family: var(--font-mono);
    font-size: var(--type-caption);
    color: var(--accent);
  }
  .front-cover__coverline-title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: var(--fg-1);
    margin: 0;
  }
  .front-cover__coverline-text {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.85rem;
    line-height: var(--leading-body);
    color: var(--fg-3);
    margin: var(--s-1) 0 0;
    max-width: 44ch;
  }
</style>
