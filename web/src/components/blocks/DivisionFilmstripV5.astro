---
/**
 * DivisionFilmstripV5.astro — Logo-build park sequence for Division Showcase.
 */
interface Props {
  division: '212' | '310' | 'nrc';
  format: 'super35' | 'widescreen200' | 'academy';
  colorToken: string;
}

const { division, format, colorToken } = Astro.props;

const barcodeSvg = `
  <svg class="barcode-svg" viewBox="0 0 52 10" preserveAspectRatio="none">
    <rect x="0" y="0" width="3" height="10" fill="currentColor"/>
    <rect x="5" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="8" y="0" width="2" height="10" fill="currentColor"/>
    <rect x="12" y="0" width="3" height="10" fill="currentColor"/>
    <rect x="17" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="20" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="23" y="0" width="2" height="10" fill="currentColor"/>
    <rect x="27" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="30" y="0" width="3" height="10" fill="currentColor"/>
    <rect x="35" y="0" width="2" height="10" fill="currentColor"/>
    <rect x="39" y="0" width="1" height="10" fill="currentColor"/>
    <rect x="42" y="0" width="2" height="10" fill="currentColor"/>
    <rect x="46" y="0" width="3" height="10" fill="currentColor"/>
    <rect x="51" y="0" width="1" height="10" fill="currentColor"/>
  </svg>
`;

const opticalWaveVerticalTop = "M10,0 L5,0 Q8,2.5 3,5 T4,10 T7,15 T2,20 T8,25 T5,30 T9,35 T3,40 T6,45 T2,50 T8,55 T5,60 T9,65 T4,70 T7,75 T3,80 T8,85 T4,90 T7,95 T2,100 L10,100 Z";
const opticalWaveVerticalBottom = "M10,0 L15,0 Q12,2.5 17,5 T16,10 T13,15 T18,20 T12,25 T15,30 T11,35 T17,40 T14,45 T18,50 T12,55 T15,60 T11,65 T16,70 T13,75 T17,80 T12,85 T16,90 T13,95 T18,100 L10,100 Z";

function renderEdgeCodeTop(fmt: string, index: number) {
  if (fmt === 'super35' && index % 4 === 0) {
    return `<span class="code">K KI 03 ${1500 + Math.floor(index / 4)} 7040·<span class="barcode-wrapper">${barcodeSvg}</span></span>`;
  }
  if (fmt === 'imax' && index % 8 === 0) {
    return `<span class="code">E KI 03 ${4600 + Math.floor(index / 8)} 7040·<span class="barcode-wrapper">${barcodeSvg}</span></span>`;
  }
  if (fmt === 'imax' && index % 8 === 3) return `<span class="code code-small">+40</span>`;
  if (fmt === 'imax' && index % 8 === 5) return `<span class="code code-small">+80</span>`;
  return '';
}

function renderEdgeCodeBottom(fmt: string, index: number) {
  if (fmt === 'academy' && index % 4 === 0) {
    return `<span class="code">K KI 03 ${1000 + Math.floor(index / 4)} 7040·<span class="barcode-wrapper">${barcodeSvg}</span></span>`;
  }
  if (fmt === 'widescreen200' && index % 4 === 0) {
    return `<span class="code">ANSCO COLOR 848 ${10 + Math.floor(index / 4)}·</span>`;
  }
  if (fmt === 'imax' && index % 8 === 0) {
    return `<span class="code code-imax-secondary">EASTMAN 5243 025 ${("0" + (2400 + Math.floor(index / 8))).slice(-4)} ID</span>`;
  }
  return '';
}

const leaderSequence = [
  { type: 'start', label: 'PICTURE START' },
  { type: 'countdown', label: '8' },
  { type: 'countdown', label: '7' },
  { type: 'countdown', label: '6' },
  { type: 'countdown', label: '5' },
  { type: 'countdown', label: '4' },
  { type: 'countdown', label: '3' },
  { type: 'countdown', label: '2' },
];

let buildStepsCount = 0;
if (division === '212') buildStepsCount = 6;
if (division === '310') buildStepsCount = 5;
if (division === 'nrc') buildStepsCount = 4;

const perfsPerFrame = format === 'imax' ? 15 : 4;
---

<section 
  class="filmstrip-block v5-filmstrip" 
  data-format={format}
>
  <div class="backing-plane" aria-hidden="true"></div>

  <div class="scroll-window" tabindex="0" role="group" aria-label="Slides">
    <div class="film-base-shell">
      <div class="film-track">
        
        {leaderSequence.map((item, lIdx) => (
          <div class="film-segment leader-frame-segment">
            <div class="film-edge top">
              <div class="edge-code-lane top" set:html={renderEdgeCodeTop(format, lIdx)}></div>
              <div class="perf-row top">
                {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
              </div>
            </div>
            
            <div class={`leader-plate ${item.type === 'start' ? 'picture-start-plate' : ''}`}>
              {item.type === 'countdown' && (
                <div class="leader-target">
                  <div class="target-circle outer"></div>
                  <div class="target-circle middle"></div>
                  <div class="target-circle inner"></div>
                  <div class="crosshair-v"></div>
                  <div class="crosshair-h"></div>
                  <div class="clock-arm"></div>
                  <div class="leader-numeral">{item.label}</div>
                </div>
              )}
              {item.type === 'start' && (
                <div class="leader-target start-target">
                  <div class="leader-start-text">{item.label}</div>
                </div>
              )}
            </div>

            <div class="film-edge bottom">
              <div class="perf-row bottom">
                {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
              </div>
              <div class="edge-code-lane bottom" set:html={renderEdgeCodeBottom(format, lIdx)}></div>
            </div>
          </div>
        ))}

        {Array.from({ length: buildStepsCount }).map((_, stepIdx) => {
          const globalIdx = leaderSequence.length + stepIdx;
          const isPark = stepIdx === buildStepsCount - 1;
          
          return (
            <div 
              class={`film-segment logo-build-frame ${isPark ? 'logo-park-frame' : ''}`} 
              data-step={stepIdx} 
              data-parked="false"
            >
              <div class="film-edge top">
                <div class="edge-code-lane top" set:html={renderEdgeCodeTop(format, globalIdx)}></div>
                <div class="perf-row top">
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
              </div>

              <div class="frame-assembly">
                {format === 'academy' && (
                  <div class="soundtrack-reservation-area">
                    <svg class="optical-wave-vertical" viewBox="0 0 20 100" preserveAspectRatio="none">
                      <path d={opticalWaveVerticalTop} fill="rgba(0,0,0,0.3)" />
                      <path d={opticalWaveVerticalBottom} fill="rgba(0,0,0,0.3)" />
                    </svg>
                  </div>
                )}
                <div class="image-aperture logo-aperture">
                  <div class="svg-container">
                    {division === '212' && (
                      <svg viewBox="0 0 360 280" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                        <g font-family="'Futura Std', Futura, 'Arial Black', sans-serif" font-weight="900">
                          <g style={`opacity: ${stepIdx >= 1 ? 1 : 0}`}><text x="20" y="195" font-size="190" fill="#824B07">(</text></g>
                          <g style={`opacity: ${stepIdx >= 2 ? 1 : 0}`}><text x="85" y="195" font-size="170" letter-spacing="-8" fill="#824B07">2</text></g>
                          <g style={`opacity: ${stepIdx >= 3 ? 1 : 0}`}><text x="165" y="195" font-size="170" letter-spacing="-8" fill="#E85D04">1</text></g>
                          <g style={`opacity: ${stepIdx >= 4 ? 1 : 0}`}><text x="225" y="195" font-size="170" letter-spacing="-8" fill="#824B07">2</text></g>
                          <g style={`opacity: ${stepIdx >= 5 ? 1 : 0}`}><text x="290" y="195" font-size="190" fill="#824B07">)</text></g>
                        </g>
                        <g class="park-wordmark">
                          <text x="180" y="255" font-family="'Futura Std', Futura, Arial, sans-serif" font-weight="700" font-size="22" letter-spacing="16" text-anchor="middle" fill="#824B07">PICTURES</text>
                        </g>
                      </svg>
                    )}
                    {division === '310' && (
                      <svg viewBox="0 0 360 230" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                        <g style={`opacity: ${stepIdx >= 1 ? 1 : 0}`}>
                          <rect x="25" y="20" width="100" height="100" fill="#077082"/>
                          <rect x="130" y="20" width="100" height="100" fill="#0077B6"/>
                          <rect x="235" y="20" width="100" height="100" fill="#077082"/>
                        </g>
                        <g font-family="'Futura Std', Futura, 'Arial Black', sans-serif" font-weight="900" font-size="74" text-anchor="middle" fill="#FFFFFF" letter-spacing="-2">
                          <g style={`opacity: ${stepIdx >= 2 ? 1 : 0}`}><text x="75" y="95">3</text></g>
                          <g style={`opacity: ${stepIdx >= 3 ? 1 : 0}`}><text x="180" y="95">1</text></g>
                          <g style={`opacity: ${stepIdx >= 4 ? 1 : 0}`}><text x="285" y="95">0</text></g>
                        </g>
                        <g class="park-wordmark">
                          <line x1="50" y1="158" x2="310" y2="158" stroke="#FFFFFF" stroke-opacity="0.25" stroke-width="1"/>
                          <text x="180" y="190" font-family="'Futura Std', Futura, Arial, sans-serif" font-weight="700" font-size="20" letter-spacing="18" text-anchor="middle" fill="#077082">PICTURES</text>
                        </g>
                      </svg>
                    )}
                    {division === 'nrc' && (
                      <svg viewBox="0 0 580 460" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                        <g class="park-wordmark">
                          <text x="287" y="100" font-family="'Futura Std', Futura, Arial, sans-serif" font-weight="700" font-size="24" letter-spacing="12" text-anchor="middle" fill="#C8C8C8">NEW RENAISSANCE</text>
                        </g>
                        <g font-family="'Futura Std', Futura, 'Arial Black', sans-serif" font-weight="900">
                          <g style={`opacity: ${stepIdx >= 1 ? 1 : 0}`}><text x="50" y="310" font-size="260" letter-spacing="-10" fill="#C8C8C8">N</text></g>
                          <g style={`opacity: ${stepIdx >= 2 ? 1 : 0}`}><text x="215" y="310" font-size="260" letter-spacing="-10" fill="#001F3F">R</text></g>
                          <g style={`opacity: ${stepIdx >= 3 ? 1 : 0}`}><text x="360" y="310" font-size="260" letter-spacing="-10" fill="#C8C8C8">C</text></g>
                        </g>
                        <g class="park-wordmark">
                          <text x="287" y="405" font-family="'Futura Std', Futura, Arial, sans-serif" font-weight="700" font-size="30" letter-spacing="54" text-anchor="middle" fill="#C8C8C8">CINEMA</text>
                          <g transform="translate(163.5 216.5) rotate(54.6)">
                            <rect x="-107.5" y="-11" width="215" height="22" fill="#001F3F"/>
                            <text x="0" y="0.5" text-anchor="middle" dominant-baseline="middle" font-family="'Share Tech Mono', 'Courier New', monospace" font-size="11.5" letter-spacing="2" fill="#FFFFFF">EST · MMXXVI · NEW YORK</text>
                          </g>
                        </g>
                      </svg>
                    )}
                  </div>
                  <div class="wireframe-cross"></div>
                </div>
              </div>

              <div class="film-edge bottom">
                <div class="perf-row bottom">
                  {Array.from({ length: perfsPerFrame }).map(() => <div class="perf-hole" />)}
                </div>
                <div class="edge-code-lane bottom" set:html={renderEdgeCodeBottom(format, globalIdx)}></div>
              </div>
            </div>
          )
        })}

      </div>
    </div>
  </div>
</section>

<style>
  /* Import base styles from FilmstripBlock via global copying, but we can just redefine what we need or let the global block define it */
  .v5-filmstrip {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: var(--s-7) 0;
    
    --perfs: 4;
    --hole-w: clamp(8px, 1.2vw, 14px);
    --hole-h: clamp(16px, 2.5vw, 24px);
    --hole-gap: clamp(16px, 2vw, 32px);
    --perf-pitch: calc(var(--hole-w) + var(--hole-gap));
    --segment-w: calc(var(--perf-pitch) * var(--perfs));
    --frame-gap: 4px;
    --code-lane-h: 20px;
    --perf-band-h: clamp(24px, 3.5vw, 32px);
    --hole-radius: var(--r-hole);
    --backing-plane: #fbfbf9;
  }

  .v5-filmstrip[data-format="super35"] {
    --aspect: 2.39;
    --support-bg: rgba(200, 110, 30, 0.25);
    --edge-bg-top: linear-gradient(to bottom, rgba(175,122,72,0.8) 0%, transparent 100%);
    --edge-bg-bottom: linear-gradient(to top, rgba(175,122,72,0.8) 0%, transparent 100%);
    --edge-text: rgba(30, 10, 0, 0.9);
    --track-bg: transparent;
    --aperture-bg: rgba(20, 10, 0, 0.85);
  }

  .v5-filmstrip[data-format="academy"] {
    --frame-gap: 6px;
    --aspect: 1.37;
    --support-bg: rgba(200, 200, 195, 0.2);
    --edge-bg-top: linear-gradient(to bottom, rgba(200,210,200,0.4) 0%, transparent 100%);
    --edge-bg-bottom: linear-gradient(to top, rgba(200,210,200,0.4) 0%, transparent 100%);
    --edge-text: rgba(240, 240, 235, 0.85);
    --track-bg: rgba(10, 10, 10, 0.9);
    --aperture-bg: rgba(10, 10, 10, 0.95);
  }

  .v5-filmstrip[data-format="widescreen200"] {
    --hole-h: clamp(14px, 2vw, 20px);
    --aspect: 2.00;
    --support-bg: rgba(160, 40, 30, 0.25); 
    --edge-bg-top: linear-gradient(to bottom, rgba(209,122,34,0.8) 0%, transparent 100%);
    --edge-bg-bottom: linear-gradient(to top, rgba(209,122,34,0.8) 0%, transparent 100%);
    --edge-text: rgba(40, 0, 0, 0.9);
    --track-bg: transparent;
    --aperture-bg: rgba(30, 5, 5, 0.85);
  }

  .v5-filmstrip[data-format="imax"] {
    --perfs: 15;
    --hole-w: clamp(12px, 1.8vw, 18px);
    --hole-h: clamp(18px, 2.8vw, 28px);
    --hole-gap: clamp(24px, 3vw, 40px);
    --code-lane-h: 26px;
    --perf-band-h: clamp(28px, 4vw, 36px);
    --hole-radius: 4px;
    --frame-gap: 8px;
    --aspect: 1.43;
    --support-bg: rgba(40, 140, 150, 0.25);
    --edge-bg-top: linear-gradient(to bottom, rgba(43,132,146,0.8) 0%, transparent 100%);
    --edge-bg-bottom: linear-gradient(to top, rgba(43,132,146,0.8) 0%, transparent 100%);
    --edge-text: rgba(230, 245, 248, 0.95);
    --track-bg: transparent;
    --aperture-bg: rgba(5, 20, 25, 0.85);
  }

  .backing-plane { position: absolute; inset: 0; z-index: 0; }
  .scroll-window { width: 100%; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; position: relative; z-index: 1; padding: 0 var(--pad-x); }
  .scroll-window::-webkit-scrollbar { display: none; }
  .film-base-shell { display: flex; flex-direction: column; width: max-content; background: var(--support-bg); box-shadow: 0 20px 40px rgba(0,0,0,0.5), inset 0 0 15px rgba(255,255,255,0.2); border-radius: 2px; backdrop-filter: blur(4px); }
  .film-track { display: flex; background: var(--track-bg); padding: 0 5vw; }
  .film-segment { width: var(--segment-w); flex-shrink: 0; display: flex; flex-direction: column; position: relative; scroll-snap-align: center; }
  .film-edge { display: flex; flex-direction: column; width: var(--segment-w); }
  .film-edge.top { background: var(--edge-bg-top); }
  .film-edge.bottom { background: var(--edge-bg-bottom); }
  
  .perf-row { display: flex; align-items: center; height: var(--perf-band-h); gap: var(--hole-gap); width: 100%; position: relative; padding: 0 4px; }
  .perf-hole { width: var(--hole-w); height: var(--hole-h); background: var(--backing-plane); border-radius: var(--hole-radius); flex-shrink: 0; box-shadow: inset 0 1px 3px rgba(0,0,0,0.8), inset 0 -1px 1px rgba(255,255,255,0.2); }
  
  .edge-code-lane { display: flex; height: var(--code-lane-h); width: 100%; background: transparent; white-space: nowrap; overflow: visible; pointer-events: none; z-index: 2; }
  .edge-code-lane.top { align-items: flex-end; padding-bottom: 3px; }
  .edge-code-lane.bottom { align-items: flex-start; padding-top: 3px; }
  .code { display: flex; align-items: center; font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; color: var(--edge-text); text-transform: uppercase; margin-left: 24px; font-weight: 600; line-height: 1; }
  .v5-filmstrip[data-format="imax"] .code { font-size: 13px; letter-spacing: 1.5px; font-weight: 700; }
  .code-imax-secondary { transform: rotate(180deg); margin-right: 24px; margin-left: auto; }
  .code-small { font-size: 10px; margin-left: 24px; opacity: 0.8; }
  .barcode-wrapper { display: block; height: 8px; width: 40px; margin-left: 10px; color: var(--edge-text); }
  .barcode-svg { width: 100%; height: 100%; display: block; }

  /* V5 specific: Logo Aperture */
  .frame-assembly { display: flex; flex-direction: row; height: auto; width: calc(var(--segment-w) - var(--frame-gap)); margin-right: var(--frame-gap); }
  .soundtrack-reservation-area { width: clamp(10px, 2vw, 20px); background-color: var(--track-bg); border-right: 1px solid rgba(0,0,0,0.1); flex-shrink: 0; position: relative; overflow: hidden; }
  .optical-wave-vertical { width: 100%; height: 100%; display: block; }
  
  .logo-aperture { position: relative; flex-grow: 1; height: auto; aspect-ratio: var(--aspect); overflow: hidden; background: var(--aperture-bg); border: 1px solid rgba(0,0,0,0.25); border-radius: 4px; display: flex; align-items: center; justify-content: center; }
  .svg-container { width: 80%; height: 80%; display: flex; align-items: center; justify-content: center; }
  .svg-container svg { width: 100%; height: 100%; }
  .wireframe-cross { position: absolute; inset: 0; pointer-events: none; opacity: 0.15; background-image: linear-gradient(to bottom right, transparent calc(50% - 1px), #fff calc(50% - 1px), #fff calc(50% + 1px), transparent calc(50% + 1px)), linear-gradient(to top right, transparent calc(50% - 1px), #fff calc(50% - 1px), #fff calc(50% + 1px), transparent calc(50% + 1px)); border: 1px solid rgba(255, 255, 255, 0.2); }

  /* Park frame wordmark animation */
  .park-wordmark { opacity: 0; transition: opacity 0ms; }
  .logo-park-frame[data-parked="true"] .park-wordmark { opacity: 1; transition: opacity 400ms ease-out; }

  /* Leader plates */
  .leader-plate { position: relative; width: calc(var(--segment-w) - var(--frame-gap)); aspect-ratio: var(--aspect); margin-right: var(--frame-gap); display: flex; align-items: center; justify-content: center; overflow: hidden; container-type: size; }
  
  /* V5 Countdown/Leader Polish (Solid Black & White) */
  .leader-plate { background: #050505; }
  
  .picture-start-plate .leader-target { border: 2px solid #fff; width: 84%; height: 84%; display: flex; align-items: center; justify-content: center; }
  .picture-start-plate .leader-start-text { font-family: var(--font-mono); font-size: clamp(2rem, 4vw, 4rem); color: #fff; font-weight: bold; white-space: nowrap; }

  .leader-target { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .target-circle { position: absolute; border-radius: 50%; border: 3px solid #fff; }
  .target-circle.outer { height: 80%; aspect-ratio: 1/1; }
  .target-circle.middle { height: 70%; aspect-ratio: 1/1; }
  .target-circle.inner { height: 60%; aspect-ratio: 1/1; }
  
  .crosshair-v { position: absolute; width: 2px; height: 100%; background: #fff; }
  .crosshair-h { position: absolute; width: 100%; height: 2px; background: #fff; }
  
  .clock-arm { position: absolute; width: 2px; height: 50%; top: 0; left: calc(50% - 1px); background: #fff; transform-origin: bottom center; }
  .leader-frame-segment.is-active .clock-arm { animation: sweep 1s linear infinite; }
  @keyframes sweep { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  .leader-numeral { font-family: var(--font-mono); font-size: 50cqh; color: #fff; z-index: 2; background: #050505; padding: 0 1rem; font-weight: 700; letter-spacing: -3px; }

</style>
