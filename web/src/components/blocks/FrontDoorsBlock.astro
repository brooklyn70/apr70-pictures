---
/**
 * FrontDoorsBlock.astro — the three division doors (id="divisions").
 *
 * Three door panels, division hero logos at scale (>=96px), taglines + mandates
 * verbatim, a division-color sweep on hover, each linking to its division page.
 * The section carries id="divisions" for the numbered nav (/#divisions).
 *
 * Motion (screening-room.ts): panels stagger-rise, logos settle from 1.35 scale
 * ([data-motion="door"] / [data-motion="door-logo"], trigger [data-motion="doors"]);
 * the head dissolves on exit ([data-motion="dissolve-head"]). SSR default is static.
 */
import type { FrontDoorsData } from '../../content/v4'

interface Props {
  block: FrontDoorsData
}

const { block } = Astro.props
---

<section class="front-doors" id="divisions" aria-label="Divisions">
  <div class="container">
    <div class="front-doors__head">
      <h2 class="front-doors__heading" data-motion="dissolve-head">{block.heading}</h2>
      <span class="front-doors__keycode">{block.keycode}</span>
    </div>

    <div class="front-doors__grid" data-motion="doors">
      {block.doors.map((door) => (
        <a class:list={['front-door', `front-door--${door.tone}`]} href={door.href} data-motion="door">
          <span class="front-door__num">{door.num}</span>
          <span class="front-door__logo">
            <img src={door.logo} alt={door.logoAlt} data-motion="door-logo" loading="lazy" />
          </span>
          <h3 class="front-door__name">{door.name}</h3>
          <p class="front-door__tagline">{door.tagline}</p>
          <p class="front-door__mandate">{door.mandate}</p>
          <span class="front-door__foot">{door.foot}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .front-doors {
    padding: clamp(2.5rem, 5vw, 4rem) 0 0;
  }

  .front-doors__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    border-top: 1px solid var(--rule-strong);
    padding-top: var(--s-5);
  }
  .front-doors__heading {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: var(--type-h2);
    letter-spacing: -0.01em;
    color: var(--fg-1);
    margin: 0;
  }
  .front-doors__keycode {
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-strip);
    text-transform: uppercase;
    color: var(--fg-5);
  }

  .front-doors__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }
  @media (min-width: 900px) {
    .front-doors__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .front-door {
    position: relative;
    background: var(--bg-0);
    padding: clamp(1.75rem, 3vw, 3rem);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    /* Cancel the inherited `a { transition: opacity }` — it fights the GSAP
       entrance opacity tween on this anchor. The color sweep lives on ::before. */
    transition: none;
  }
  @media (min-width: 900px) {
    .front-door {
      min-height: 380px;
    }
  }

  /* Division-color sweep on hover (transform + opacity only). */
  .front-door::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--door-c);
    transform: translateY(101%);
    opacity: 0.14;
    transition: transform 0.5s var(--ease-out);
    pointer-events: none;
  }
  .front-door:hover::before,
  .front-door:focus-visible::before {
    transform: translateY(0);
  }
  .front-door:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .front-door__num {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-widest);
    color: var(--fg-5);
  }

  .front-door__logo {
    height: 96px;
    display: flex;
    align-items: center;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }
  .front-door__logo img {
    max-height: 100%;
    width: auto;
    max-width: 220px;
    display: block;
  }

  .front-door__name {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.5rem;
    letter-spacing: 0.01em;
    color: var(--fg-1);
    margin: 0;
  }

  .front-door__tagline {
    margin: var(--s-2) 0 0;
    font-family: var(--font-body);
    font-style: italic;
    color: var(--door-c-text, var(--fg-2));
    font-size: 1rem;
    line-height: var(--leading-snug);
  }

  .front-door__mandate {
    margin: clamp(0.9rem, 2vw, 1.1rem) 0 0;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 0.9rem;
    color: var(--fg-3);
    line-height: var(--leading-body);
    max-width: 38ch;
  }

  .front-door__foot {
    margin-top: auto;
    padding-top: clamp(1rem, 2.5vw, 1.5rem);
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-widest);
    text-transform: uppercase;
    color: var(--fg-4);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .front-door__foot::before {
    content: '';
    width: 26px;
    height: 2px;
    background: var(--door-c);
  }

  /* Division tones (from tokens). Light-mode text variants keep contrast. */
  .front-door--212 {
    --door-c: var(--apr-amber);
    --door-c-text: #c98a3f;
  }
  .front-door--310 {
    --door-c: var(--apr-imax);
    --door-c-text: #3aa8ba;
  }
  .front-door--nrc {
    --door-c: var(--apr-grey);
    --door-c-text: var(--apr-grey);
  }
  :global([data-theme='light']) .front-door--nrc {
    --door-c-text: #6a6a6a;
  }
</style>
