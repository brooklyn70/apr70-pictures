---
/**
 * /nrc - the New Renaissance Cinema division page (v9 chrome, marquee design).
 * Rebuilt 2026-07-12 to the v10 Divisions panel ruling: full-size typographic
 * lockup, discipline line, investor paragraph, and the division's own slate.
 * NRC holds the feature slate (the deep bench, six of ten properties), including
 * Sea Gate and Da Hook, both ruled NRC features 2026-07-12.
 */
import V9Layout from '../layouts/V9Layout.astro'
import DivisionPage from '../components/v9/DivisionPage.astro'
import { fetchDivisionSlate } from '../lib/payload'
import { NAP } from '../lib/v9/site'

const { slate } = await fetchDivisionSlate('nrc')

const lockup = 'New Renaissance Cinema'
const discipline = 'Feature films built for permanence.'
const paragraph =
  'New Renaissance Cinema makes feature films built for permanence. Auteur-driven and morally clear, developed for the long life of a picture. Film deserves its own conversation, and this is where APR 70 Pictures has it at feature length. Every APR 70 feature carries this banner. When a picture has a home territory, (212) or (310) joins as co-production, so a story can move rooms without changing hands. When it has none, it stands here alone.'
const title = `${lockup} · ${NAP.name}`
---

<V9Layout title={title} description={discipline}>
  <script is:inline>document.documentElement.setAttribute('data-accent', 'nrc-grey')</script>
  <DivisionPage
    division="nrc"
    lockup={lockup}
    discipline={discipline}
    paragraph={paragraph}
    slate={slate}
  />
</V9Layout>
