---
/**
 * FilmstripBlock.astro — Cinematic horizontal image track with perforation bands.
 * Uses native CSS scroll-snap for zero-jank mobile performance.
 */
import { fetchProjects, resolveMediaUrl } from '../../lib/payload'

interface Props {
  block: {
    source: 'custom-media' | 'from-projects'
    format?: 'academy' | 'super35' | 'widescreen200' | 'imax' | 'v2-header' | 'v2-footer'
    projectFilter?: 'all' | '212' | '310' | 'nrc'
    tiles?: Array<{
      media: any
      caption?: string
      division?: string
    }>
    showPerforations?: boolean
  }
}

const { block } = Astro.props
const showPerfs = block.showPerforations !== false
const format = block.format || 'super35'

type ComputedTile = {
  url: string
  alt: string
  caption: string
  division: string
  href?: string
}

let computedTiles: ComputedTile[] = []

if (block.source === 'from-projects') {
  const { projects } = await fetchProjects()
  let filtered = projects || []
  if (block.projectFilter && block.projectFilter !== 'all') {
    filtered = filtered.filter(p => p.division === block.projectFilter)
  }
  for (const proj of filtered) {
    if (proj.heroImage && typeof proj.heroImage === 'object' && 'url' in proj.heroImage) {
      const media = proj.heroImage as any
      const url = resolveMediaUrl(media)
      if (url) {
        computedTiles.push({
          url,
          alt: media.alt || proj.title,
          caption: proj.title,
          division: proj.division || 'none',
          href: `/work/${proj.slug}`
        })
      }
    }
  }
} else {
  const rawTiles = block.tiles || []
  for (const tile of rawTiles) {
    if (tile.media) {
      const url = resolveMediaUrl(tile.media)
      if (url) {
        computedTiles.push({
          url,
          alt: tile.media.alt || tile.caption || '',
          caption: tile.caption || '',
          division: tile.division || 'none',
          href: undefined
        })
      }
    }
  }
}

// 100 holes per band to ensure coverage on ultrawide monitors
const holes = Array.from({ length: 100 })

function getDivisionClass(div: string) {
  if (div === '212') return 'text-212'
  if (div === '310') return 'text-310'
  if (div === 'nrc') return 'text-nrc'
  return ''
}
---

<section 
  class="filmstrip-block" 
  data-format={format}
  aria-label={format.startsWith('v2-') ? "Filmstrip rail" : "Filmstrip gallery"}
  role={format.startsWith('v2-') ? "presentation" : "region"}
  aria-roledescription={format.startsWith('v2-') ? undefined : "carousel"}
>
  {showPerfs && (
    <div class="perf-band" aria-hidden="true">
      {holes.map(() => <div class="perf-hole" />)}
    </div>
  )}

  {!format.startsWith('v2-') && (
    <div class="optical-track-container" aria-hidden="true">
      <div class="optical-track"></div>
    </div>
  )}

  {!format.startsWith('v2-') && (
    <div 
      class="filmstrip-track" 
      tabindex="0"
      role="group"
      aria-label="Slides"
    >
      {computedTiles.map((tile, i) => {
        const Element = tile.href ? 'a' : 'div'
        return (
          <Element
            class="filmstrip-tile"
            href={tile.href}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${computedTiles.length}`}
          >
            <div class="tile-frame">
              <img
                src={tile.url}
                alt={tile.alt}
                loading="lazy"
              />
            </div>
            <div class="tile-meta">
              {tile.caption && <span class="tile-caption">{tile.caption}</span>}
              {tile.division !== 'none' && (
                <span class={`tile-division ${getDivisionClass(tile.division)}`}>
                  {tile.division.toUpperCase()}
                </span>
              )}
            </div>
          </Element>
        )
      })}
    </div>
  )}

  {showPerfs && format !== 'v2-header' && format !== 'v2-footer' && (
    <div class="perf-band perf-band--bottom" aria-hidden="true">
      <div class="edge-code edge-code--cyan" style="left: 10%;">KODAK 500T 5219</div>
      <div class="edge-code edge-code--yellow" style="left: 45%;">KU 12 3456 7890</div>
      <div class="edge-code edge-code--orange" style="left: 80%;">EASTMAN SAFETY FILM</div>
      {holes.map(() => <div class="perf-hole" />)}
    </div>
  )}
</section>

<style>
  .filmstrip-block {
    width: 100%;
    overflow: hidden;
    background: #020202; /* Deep rich black base for positives */
    padding: var(--s-7) 0;
    position: relative;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5); /* Lift it off the page to make it BOLD */
    
    /* Default variables (Super 35) */
    --aspect: 2.39 / 1;
    --hole-w: clamp(8px, 1.2vw, 14px);
    --hole-h: clamp(16px, 2.5vw, 24px);
    --hole-gap: clamp(16px, 2vw, 32px);
    --band-h: 48px;
    --hole-radius: var(--r-hole);
    --border-color: var(--rule);
    --frame-gap: 4px; /* Frame lines thickness */
  }

  /* Format Overrides */
  .filmstrip-block[data-format="academy"] {
    --aspect: 1.37 / 1;
    --frame-gap: 6px;
  }

  .filmstrip-block[data-format="widescreen200"] {
    --aspect: 2.00 / 1;
    --hole-h: clamp(14px, 2vw, 20px); /* Long-pitch style */
    --frame-gap: 4px;
  }

  .filmstrip-block[data-format="imax"] {
    --aspect: 1.43 / 1; /* Actually 1.43 but projected large */
    --hole-w: clamp(12px, 1.8vw, 18px); /* IMAX holes */
    --hole-h: clamp(18px, 2.8vw, 28px);
    --hole-gap: clamp(24px, 3vw, 40px);
    --band-h: 56px;
    --hole-radius: 4px;
    --frame-gap: 8px; /* Thicker frame lines for IMAX */
  }

  .filmstrip-block[data-format="v2-header"],
  .filmstrip-block[data-format="v2-footer"] {
    --aspect: 3 / 1; /* Not used since track is hidden */
    --hole-w: 13px;
    --hole-h: 9px;
    --hole-gap: 16px;
    --band-h: 32px;
    --hole-radius: var(--r-hole);
    --border-color: #1e1e1e;
    padding: 0;
    box-shadow: none;
    background: transparent;
  }

  .perf-band {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: var(--band-h);
    width: 200vw; /* Allow scrolling/panning */
    overflow: hidden;
    padding: 0 5vw;
    gap: var(--hole-gap);
    background: #020202; /* Film strip base */
    position: relative;
    border-top: 1px solid rgba(255,255,255,0.03);
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }

  /* Edge Codes */
  .edge-code {
    position: absolute;
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-strip);
    white-space: nowrap;
    opacity: 0.8;
    bottom: 4px; /* Default placement near the edge */
    z-index: 2;
    pointer-events: none;
  }
  .edge-code--cyan { color: #00e5ff; }
  .edge-code--yellow { color: #ffeb3b; }
  .edge-code--orange { color: #ff9100; }

  /* Optical sound track (squiggly lines between perfs and frame) */
  .optical-track-container {
    width: 100%;
    height: 12px;
    background: #020202;
    position: relative;
    overflow: hidden;
    margin-bottom: 2px;
  }
  .optical-track {
    width: 200vw;
    height: 100%;
    background-image: 
      repeating-linear-gradient(90deg, 
        transparent, transparent 2px, 
        rgba(0, 229, 255, 0.4) 2px, rgba(0, 229, 255, 0.4) 4px),
      repeating-linear-gradient(90deg, 
        rgba(0, 229, 255, 0.2), rgba(0, 229, 255, 0.2) 1px, 
        transparent 1px, transparent 3px);
    background-position: 0 0, 0 4px;
    background-size: 16px 12px, 24px 12px;
    background-repeat: repeat-x;
    opacity: 0.7;
  }
  
  .filmstrip-block[data-format="imax"] .optical-track-container {
    display: none; /* IMAX usually has separate sound or digital */
  }

  /* Specific V2 backplate colors */
  .filmstrip-block[data-format="v2-header"] .perf-band,
  .filmstrip-block[data-format="v2-footer"] .perf-band {
    background: #050505;
    border: none;
    border-bottom: 1px solid var(--bg-3);
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
    justify-content: space-between;
  }

  .perf-hole {
    width: var(--hole-w);
    height: var(--hole-h);
    background: var(--bg-0); /* Shows page background through the film strip */
    border-radius: var(--hole-radius);
    flex-shrink: 0;
    box-shadow: 
      inset 0 1px 3px rgba(0,0,0,0.8), 
      inset 0 -1px 1px rgba(255,255,255,0.1);
    position: relative;
    z-index: 1;
  }

  .filmstrip-block[data-format="v2-header"] .perf-hole,
  .filmstrip-block[data-format="v2-footer"] .perf-hole {
    box-shadow: none;
    border: 1.5px solid var(--border-color);
  }

  .filmstrip-track {
    display: flex;
    gap: var(--frame-gap); /* This gap acts as the black frame line! */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 5vw;
    background: #020202; /* The frame lines will be this color */
    
    /* Stronger fade at the edges to give a "projected" or "cut" feel */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    scrollbar-width: none; /* Firefox */
  }

  /* No fading masks or huge padding on v2 styling */
  .filmstrip-block[data-format="v2-header"] .filmstrip-track,
  .filmstrip-block[data-format="v2-footer"] .filmstrip-track {
    padding: var(--s-3) var(--pad-x);
    background: transparent;
  }

  .filmstrip-track::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .filmstrip-track:focus-visible {
    outline: 2px solid var(--apr-imax);
    outline-offset: -2px;
  }

  .filmstrip-tile {
    flex-shrink: 0;
    width: clamp(280px, 45vw, 600px);
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--fg-1);
    outline: none;
  }

  .tile-frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--aspect); 
    overflow: hidden;
    background: var(--bg-1);
    border-radius: 2px; /* Slight rounding for film frame corners */
  }

  .tile-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05); /* slightly graded */
    transition: transform var(--dur-base) var(--ease-out), filter var(--dur-base) var(--ease-out);
  }

  /* Interaction states */
  .filmstrip-tile:hover .tile-frame img,
  .filmstrip-tile:focus-visible .tile-frame img {
    transform: scale(1.03);
    filter: saturate(1.15) contrast(1.1);
  }

  .filmstrip-tile:focus-visible .tile-frame {
    outline: 2px solid var(--apr-imax);
    outline-offset: 4px;
  }

  .tile-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--s-3);
    gap: var(--s-3);
  }

  .tile-caption {
    font-family: var(--font-body);
    font-size: var(--type-caption);
    letter-spacing: var(--track-wider);
    text-transform: uppercase;
    color: var(--fg-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
  }

  .tile-division {
    font-family: var(--font-mono);
    font-size: var(--type-tiny);
    letter-spacing: var(--track-strip);
    color: var(--muted);
    flex-shrink: 0;
  }
</style>

