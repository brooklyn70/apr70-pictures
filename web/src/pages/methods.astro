---
/** /methods — how the work is made, and what is disclosed (Site v9 · Methods). */
import V9Layout from '../layouts/V9Layout.astro'
import SectionRenderer from '../components/v9/SectionRenderer.astro'
import { fetchV9Page } from '../lib/payload'
import { NAP, napFor } from '../lib/v9/site'

const locale = Astro.locals.locale
const { page } = await fetchV9Page('v9-methods', locale)
const title = page?.seoTitle ?? `Methods · ${NAP.name}`
const description = page?.seoDescription ?? napFor(locale).description
---

<V9Layout title={title} description={description}>
  <SectionRenderer sections={page?.sections} />
</V9Layout>
