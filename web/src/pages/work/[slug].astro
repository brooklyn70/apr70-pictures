---
/**
 * /work/[slug] — text-forward property page (v4 zine treatment).
 *
 * The synopsis is the hero: if the Payload project layout carries a
 * zineSynopsis block it renders as-is; otherwise the compiled-in V4 synopsis
 * for this slug (from the copy bundle) takes over — including /work/sea-gate,
 * which has no Payload row yet. Projects outside the 7 bundle synopses fall
 * back to their existing block layout.
 */
import Layout from '../../layouts/Layout.astro'
import BlockRenderer from '../../components/blocks/BlockRenderer.astro'
import { fetchProject } from '../../lib/payload'
import { V4_PROPERTY_BY_SLUG } from '../../content/v4'

const { slug } = Astro.params
if (!slug) return Astro.redirect('/work')

const { project, error } = await fetchProject(slug)
const fallback = V4_PROPERTY_BY_SLUG[slug]

if (!project && !fallback) {
  if (!error) return Astro.redirect('/work')
}

const dbBlocks = project?.layout ?? []
const hasZine = dbBlocks.some(
  (b) => (b as { blockType?: string }).blockType === 'zineSynopsis',
)

const blocks = hasZine
  ? dbBlocks
  : fallback
    ? [fallback.synopsis]
    : dbBlocks

const title = hasZine
  ? (project?.title ?? 'Project')
  : (fallback?.title ?? project?.title ?? 'Project')
---

<Layout title={title}>
  <main>
    {!blocks.length && (
      <div class="property-empty">
        <p>No blocks found for this project.</p>
      </div>
    )}
    <BlockRenderer blocks={blocks} />
  </main>
</Layout>

<style>
  .property-empty {
    padding: var(--s-9) 0;
    text-align: center;
    font-family: var(--font-body);
    color: var(--fg-3);
  }
</style>
