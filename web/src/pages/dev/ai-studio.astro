---
/**
 * /dev/ai-studio — the "AI assisting every step" surface.
 * Author mode drafts on-brand block copy; Theme mode generates a new
 * [data-design] skin you can paste into web/src/styles/designs.css.
 * Dev-only: gated to `astro dev` or PUBLIC_ENABLE_STUDIO=true.
 */
import Layout from '../../layouts/Layout.astro'

const enabled = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_STUDIO === 'true'
if (!enabled) return Astro.redirect('/404')
---

<Layout title="AI Studio" design="signature">
  <main class="ai">
    <p class="ai__eyebrow">AI STUDIO · DEV · claude-opus-4-8</p>
    <h1 class="ai__title">Build assistant</h1>

    <div class="ai__modes" id="modes">
      <button class="ai__mode is-on" data-mode="author">Author copy</button>
      <button class="ai__mode" data-mode="theme">Design a theme</button>
    </div>

    <p class="ai__help" id="help">Draft on-brand copy and propose which blocks to use. Grounded in the locked palette + block library.</p>

    <textarea id="prompt" class="ai__prompt" rows="4"
      placeholder="e.g. Write a hero + two-column intro for the (310) division landing — elevated genre, global scale."></textarea>

    <details class="ai__ctx">
      <summary>Add context (optional)</summary>
      <textarea id="context" class="ai__prompt" rows="3" placeholder="Paste existing block JSON or notes to ground the output."></textarea>
    </details>

    <button id="run" class="ai__run">Generate</button>

    <pre id="out" class="ai__out" hidden></pre>
  </main>
</Layout>

<style>
  .ai { max-width: 820px; margin: 0 auto; padding: clamp(2rem, 6vw, 5rem) var(--pad-x) 6rem; }
  .ai__eyebrow { font-family: var(--font-mono); font-size: 10px; letter-spacing: .3em; color: var(--fg-4); margin: 0; }
  .ai__title { margin: .4rem 0 1.5rem; }
  .ai__modes { display: flex; gap: 8px; margin-bottom: 12px; }
  .ai__mode { cursor: pointer; background: transparent; color: var(--fg-3); border: 1px solid var(--rule); padding: 8px 16px; font-family: var(--font-body); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; transition: color .2s, border-color .2s; }
  .ai__mode.is-on { color: #fff; border-color: #fff; }
  .ai__help { font-size: 13px; color: var(--fg-3); margin: 0 0 16px; }
  .ai__prompt { width: 100%; background: var(--bg-1); color: var(--fg-1); border: 1px solid var(--rule-strong); padding: 12px; font-family: var(--font-mono); font-size: 13px; line-height: 1.5; resize: vertical; }
  .ai__ctx { margin: 12px 0; }
  .ai__ctx summary { cursor: pointer; font-size: 12px; color: var(--fg-4); letter-spacing: .1em; text-transform: uppercase; }
  .ai__ctx textarea { margin-top: 8px; }
  .ai__run { margin-top: 16px; cursor: pointer; background: #fff; color: #000; border: 1px solid #fff; padding: 12px 28px; font-family: var(--font-body); font-weight: 600; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; transition: background .2s, color .2s; }
  .ai__run:hover { background: transparent; color: #fff; }
  .ai__run[disabled] { opacity: .5; cursor: wait; }
  .ai__out { margin-top: 24px; background: var(--bg-1); border: 1px solid var(--rule); padding: 16px; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; color: var(--fg-1); }
</style>

<script>
  let mode = 'author'
  const help = document.getElementById('help')!
  const modes = document.getElementById('modes')!
  const promptEl = document.getElementById('prompt') as HTMLTextAreaElement
  const contextEl = document.getElementById('context') as HTMLTextAreaElement
  const out = document.getElementById('out') as HTMLPreElement
  const run = document.getElementById('run') as HTMLButtonElement

  const HELP: Record<string, string> = {
    author: 'Draft on-brand copy and propose which blocks to use. Grounded in the locked palette + block library.',
    theme: 'Describe a look; get a [data-design] CSS block to paste into web/src/styles/designs.css and register in the manifest.',
  }

  modes.querySelectorAll<HTMLButtonElement>('.ai__mode').forEach((b) => {
    b.addEventListener('click', () => {
      mode = b.dataset.mode!
      modes.querySelectorAll('.ai__mode').forEach((x) => x.classList.toggle('is-on', x === b))
      help.textContent = HELP[mode]
    })
  })

  run.addEventListener('click', async () => {
    const prompt = promptEl.value.trim()
    if (!prompt) { promptEl.focus(); return }
    run.disabled = true
    out.hidden = false
    out.textContent = 'Thinking…'
    try {
      const res = await fetch('/api/ai/assist', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ mode, prompt, context: contextEl.value.trim() || undefined }),
      })
      const data = await res.json()
      out.textContent = data.ok ? data.text : `Error: ${data.error}`
    } catch (e: any) {
      out.textContent = `Request failed: ${e?.message ?? e}`
    } finally {
      run.disabled = false
    }
  })
</script>
