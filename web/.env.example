# Base URL of the Payload CMS (same host as Next app or localhost in dev).
# Used at build time for static pages that fetch globals.
# On Vercel: the cms project's public URL, e.g. https://cms.apr70.com or
# https://apr70-cms.vercel.app (never an internal Docker hostname).
PUBLIC_PAYLOAD_URL=http://localhost:3000

# Deploy adapter selection (astro.config.mjs):
#   unset / node → @astrojs/node standalone (NAS Docker + local dev, default)
#   vercel       → @astrojs/vercel serverless (set in the Vercel project env)
# DEPLOY_TARGET=vercel

# Optional: in-process REST cache (stale-while-revalidate) in the Node SSR server.
# Caching is off in dev unless PUBLIC_PAYLOAD_CACHE_IN_DEV=1.
# PUBLIC_PAYLOAD_CACHE_IN_DEV=1
# PUBLIC_PAYLOAD_CACHE_OFF=1
# PUBLIC_PAYLOAD_CACHE_FRESH_SEC=60
# PUBLIC_PAYLOAD_CACHE_STALE_SEC=300
