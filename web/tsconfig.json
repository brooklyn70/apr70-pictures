{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "payload-types": ["../cms/src/payload-types.ts"],
      "site-locales": ["../cms/src/locales.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}