---
import type { Home } from 'payload-types'

import { richTextLexicalToHtml } from '../../lib/lexicalToHtml'

type RichBlock = Extract<
  NonNullable<NonNullable<Home['layout']>[number]>,
  { blockType: 'richText' }
>

interface Props {
  block: RichBlock
}

const { block } = Astro.props

const html = richTextLexicalToHtml(block.content ?? undefined)
---

<section class="rich-text-block" aria-label="Rich text">
  {!html ? <p class="rich-text-block__empty">No content.</p> : null}
  {html ? <div class="rich-text-block__body payload-richtext" set:html={html} /> : null}
</section>

<style is:global>
  /* Mirrors v2 Payload RichText.tsx D-7 blocks; typography uses v3 tokens (no transition: all). */
  .rich-text-block__body.payload-richtext {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--apr-mid-dark);
    max-width: 42rem;
  }

  .rich-text-block__body.payload-richtext :where(p) {
    margin: 0 0 var(--space-3);
  }

  .rich-text-block__body.payload-richtext :where(a) {
    color: var(--apr-near-black);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .d7-structure-divider {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-block: var(--space-12);
    width: 100%;
    box-sizing: border-box;
  }

  .d7-structure-divider--plain .d7-structure-divider__rule {
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--apr-near-black) 12%, transparent);
  }

  .d7-structure-divider--labeled .d7-structure-divider__rule {
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--apr-near-black) 12%, transparent);
  }

  .d7-structure-divider__label {
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.6875rem;
    color: var(--apr-mid-dark);
  }

  .d7-button-wrap {
    margin-block: var(--space-4);
  }

  .d7-button {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    padding: 0.625rem var(--space-6);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    cursor: crosshair;
    transition:
      color 0.28s ease,
      border-color 0.28s ease,
      background-color 0.28s ease;
  }

  .d7-button--primary {
    color: var(--apr-near-black);
    border: 1px solid color-mix(in srgb, var(--apr-near-black) 40%, transparent);
    background-color: transparent;
  }

  .d7-button--primary:hover {
    color: white;
    background-color: var(--apr-near-black);
    border-color: var(--apr-near-black);
  }

  .d7-button--secondary {
    color: color-mix(in srgb, var(--apr-mid-dark) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--apr-mid-dark) 35%, transparent);
    background-color: transparent;
  }

  .d7-button--secondary:hover {
    color: var(--apr-near-black);
    border-color: color-mix(in srgb, var(--apr-near-black) 40%, transparent);
  }

  .d7-accent-text {
    margin-block: var(--space-8);
    padding-block: var(--space-2);
    padding-inline-start: var(--space-6);
    border-left-style: solid;
    border-left-width: 2px;
    white-space: pre-line;
    font-weight: 300;
    font-size: clamp(1.125rem, 1.5vw, 1.25rem);
    line-height: 1.85;
    color: var(--apr-near-black);
  }
</style>

<style>
  .rich-text-block {
    padding: 0 var(--space-3) var(--space-8);
    box-sizing: border-box;
  }

  .rich-text-block__empty {
    margin: 0;
    font-family: var(--font-body);
    color: var(--apr-mid-dark);
    font-style: italic;
  }
</style>
