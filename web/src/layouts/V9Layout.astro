---
/**
 * V9Layout — the v9 public front door chrome, wearing the v8 design
 * (Marco's reversal, 2026-07-11). ONE visual design; the mode is v8's
 * three-way switch on <html> data-theme:
 *   absent            = System (follows prefers-color-scheme)
 *   data-theme="dark" = Marquee Night (default look)
 *   data-theme="light"= House Lights
 * Persisted as localStorage apr70-theme (dark | light | system), stamped
 * pre-paint below so nothing flashes. Header nav and footer come from
 * site-settings.v9Chrome; page metadata + JSON-LD arrive as props.
 * Plain MPA (no ClientRouter): every v9 page stands alone.
 *
 * v10 catalog (2026-07-12): the visitor type-size dial (html[data-scale])
 * and logo-size dial (--logo-h) are RETIRED from the Display panel — the
 * pre-paint stamp below no longer reads/writes apr70:font-scale or
 * apr70:logo-size. --logo-h stays a live token (SiteNav still reads it);
 * only the visitor control that used to write it is gone.
 */
import '../styles/global.css'
import '../styles/v9.css'
import '../styles/themes/index.css'
import ModeToggleIsland from '../components/islands/ModeToggleIsland'
import ScrollTopIsland from '../components/islands/ScrollTopIsland'
import { fetchV9Chrome, fetchSiteSettings, fetchTroupeProgram, resolveMediaUrl } from '../lib/payload'
import { organizationJsonLd, webSiteJsonLd, canonical, V9_PAGES, NAP } from '../lib/v9/site'

interface Props {
  title: string
  description?: string
  /** Page-specific JSON-LD blocks (Organization + WebSite are always injected). */
  jsonLd?: Record<string, unknown>[]
  /** Division pages only. Swaps in that division's accent + tab icon from
   *  Site Settings → Division Brand. Was hardcoded in each page until v11. */
  division?: '212' | '310' | 'nrc'
}

const { title, description = NAP.description, jsonLd = [], division } = Astro.props

const { chrome } = await fetchV9Chrome()

/* ── Brand Kit (v10, F1) — Payload-driven brand controls ──────────────────
   Logo files, logo height, accent/rollover/highlight tokens, and the
   default mode all come from Site Settings → Brand Kit in the CMS. Marco
   edits brand presentation in Payload; the site reflects it on refresh
   (SSR + short SWR cache). Hard fallbacks keep the chrome alive if the
   CMS is unreachable. */
const { settings } = await fetchSiteSettings()
const kit = settings?.brandKit ?? {}

/* AI mark (v13): when enabled, the body carries the style + text and the
   frame renderers decide per-frame (caption carries "AI-generated") whether
   the stamp applies. CSS does the rest — see "AI mark" in v9.css. */
const aiMark = settings?.aiMark?.enabled ? settings.aiMark : null
const aiMarkStyle = aiMark ? (aiMark.style ?? 'corner') : undefined
const aiMarkText = aiMark
  ? `--ai-mark-text: "${(aiMark.text || 'APR 70 · AI GEN').replace(/["\\]/g, '')}"`
  : undefined
const logoH = Math.min(72, Math.max(24, kit.logoHeight ?? 64))
const modeDefault = kit.modeDefault ?? 'system'
const houseAccent = kit.accent ?? 'flame'
const linkHover = kit.linkHover ?? 'accent'
const highlight = kit.highlight ?? 'flame'

/* ── Division Brand (v11) ─────────────────────────────────────────────────
   A division page overrides the house accent with its own, and may carry its
   own tab icon. Both used to be unreachable: the accent was a hardcoded
   `data-accent` written by an inline script in each of 212/310/nrc.astro, and
   there was no division favicon at all. They are Site Settings → Division
   Brand now, and this is stamped SERVER-SIDE — no inline script, so the colour
   is right in the first paint instead of flashing the house accent first.
   The defaults below reproduce exactly what the pages used to hardcode. */
const DIVISION_FALLBACK = { '212': 'flame', '310': 'sicilian-blue', nrc: 'nrc-grey' } as const
const divisionAccent = division
  ? (division === '212'
      ? settings?.accent212
      : division === '310'
        ? settings?.accent310
        : settings?.accentNrc) ?? DIVISION_FALLBACK[division]
  : null
const accent = divisionAccent ?? houseAccent

const divisionFavicon = division
  ? resolveMediaUrl(
      (division === '212'
        ? settings?.favicon212
        : division === '310'
          ? settings?.favicon310
          : settings?.faviconNrc) as never,
    )
  : null

/* ── Favicons (v11) ───────────────────────────────────────────────────────
   The `favicon` upload has existed since v10 and the site IGNORED it — this
   file hardcoded /favicon.svg, so uploading one in Payload did nothing at all.
   Now: division icon → site icon → the static file. `faviconDark` is optional
   and only serves browsers whose UI chrome is dark. */
const siteFavicon = resolveMediaUrl(settings?.favicon as never)
const faviconDark = resolveMediaUrl(settings?.faviconDark as never)
const appleTouchIcon = resolveMediaUrl(settings?.appleTouchIcon as never)
const faviconHref = divisionFavicon || siteFavicon || '/favicon.svg'
/* Payload media law for the marks: data-mark-ink='light' is the LIGHT-colored
   mark (shown on dark paper) = the CMS "Nav Logo (Dark theme)" upload;
   data-mark-ink='dark' is the dark mark for House Lights = "Nav Logo (Light
   theme)". Static /logos files remain the fallback. */
/* Fallback pair = the same Punch files the live Site Settings carry (2026-09-02, Marco's
   ruling: the Punch kit is canonical; the Futura-named apr70_logo_* SVGs are archived). */
const markLight = resolveMediaUrl(settings?.navLogoDark) || '/logos/wordmark_white_punch-blue.svg'
const markDark = resolveMediaUrl(settings?.navLogoLight) || '/logos/wordmark_black_punch-orange.svg'
const baseNavLinks =
  chrome.navLinks && chrome.navLinks.length > 0
    ? chrome.navLinks
    : V9_PAGES.map((p) => ({ href: p.path, label: p.label }))

/* DISPATCH (v10) — the news page is Marco's switch, not a deploy. While
   Site Settings → DISPATCH → Publish is off, /dispatch 404s and this link
   never renders; tick it and the page joins the nav on the next refresh.
   Skipped if he has already hand-added /dispatch to the CMS nav array. */
const dispatchOn = settings?.dispatch?.enabled === true
const dispatchLabel = settings?.dispatch?.navLabel?.trim() || 'Dispatch'
const dispatchAlreadyInNav = baseNavLinks.some(
  (link) => (link.href ?? '').replace(/\/$/, '') === '/dispatch',
)
const withDispatch =
  dispatchOn && !dispatchAlreadyInNav
    ? [...baseNavLinks, { href: '/dispatch', label: dispatchLabel }]
    : baseNavLinks

/* TROUPE (v11) — the radio play. Same switch idea as DISPATCH, but the nav link
   must clear the SAME DOUBLE GATE the page does: the checkbox is not enough, the
   recording has to exist. Ticking Publish with no audio uploaded would otherwise
   hang a link in the nav that 404s — the one thing worse than no link at all.
   The programme is only fetched when the switch is on, so while TROUPE is off
   (its shipping state) this costs nothing; when it is on, the SWR cache means
   one fetch, not one per page. */
const troupeOn = settings?.troupe?.enabled === true
const { programme: troupeProgramme } = troupeOn
  ? await fetchTroupeProgram()
  : { programme: null }
const troupeLive = troupeOn && Boolean(resolveMediaUrl(troupeProgramme?.audio as never))
const troupeLabel = settings?.troupe?.navLabel?.trim() || 'Troupe'
const troupeAlreadyInNav = withDispatch.some(
  (link) => (link.href ?? '').replace(/\/$/, '') === '/troupe',
)
const navLinks =
  troupeLive && !troupeAlreadyInNav
    ? [...withDispatch, { href: '/troupe', label: troupeLabel }]
    : withDispatch

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const canonicalUrl = canonical(path)

const jsonLdAll = [organizationJsonLd(), webSiteJsonLd(), ...jsonLd]

/* The Display panel's three theme choices are v8's MODES. The CMS fields
   carry the labels (re-seeded 2026-07-11): themePremiere = "Marquee night"
   (dark), themeMatinee = "House lights" (light), themeLateshow = "System". */
const panelLabels = {
  displayLabel: chrome.displayLabel,
  panelTitle: chrome.panelTitle,
  themeLabel: chrome.themeLabel,
  themeNames: {
    dark: chrome.themePremiere,
    light: chrome.themeMatinee,
    system: chrome.themeLateshow,
  },
}
---

<!doctype html>
<html
  lang="en"
  data-theme={modeDefault !== 'system' ? modeDefault : undefined}
  data-accent={accent !== 'flame' ? accent : undefined}
  data-hover={linkHover !== 'accent' ? linkHover : undefined}
  data-highlight={highlight !== 'flame' ? highlight : undefined}
  style={`--logo-h: ${logoH}px`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* v8 pre-paint stamp — runs before first paint, no FOUC.
         apr70-theme: dark | light | system (anything else = system).
         v10 brand kit: the server renders the ADMIN default mode as a
         data-theme attribute; a stored visitor choice still wins. With no
         stored choice the server default stands (no removeAttribute). */
      ;(function () {
        var doc = document.documentElement
        doc.classList.add('js')
        function read(key) {
          try { return localStorage.getItem(key) } catch (e) { return null }
        }
        var theme = read('apr70-theme')
        if (theme === 'dark' || theme === 'light') doc.setAttribute('data-theme', theme)
        else if (theme === 'system') doc.removeAttribute('data-theme')
      })()
    </script>
    {/* Favicon: division icon → site icon (Payload) → the static file. The dark
        variant is only emitted if Marco actually uploaded one; browsers pick it
        via the media query and fall back to the first <link> otherwise. */}
    <link rel="icon" href={faviconHref} />
    {faviconDark && <link rel="icon" href={faviconDark} media="(prefers-color-scheme: dark)" />}
    {appleTouchIcon && <link rel="apple-touch-icon" href={appleTouchIcon} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site summary" />
    <link
      rel="preload"
      href="/fonts/Jost-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Fraunces-italic-300-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={NAP.name} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0604" />
    {/* v10: House Lights re-toned to the house hue (≈ oklch 94.5% 0.008 55) */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f1efec" />
    {jsonLdAll.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="v9" data-ai-mark={aiMarkStyle} style={aiMarkText}>
    <header class="v9-header">
      <div class="v9-col v9-header__row">
        <a class="v9-brand" href="/" aria-label={NAP.name}>
          <img
            class="v9-brand__mark"
            data-mark-ink="light"
            src={markLight}
            alt={NAP.name}
          />
          <img
            class="v9-brand__mark"
            data-mark-ink="dark"
            src={markDark}
            alt=""
            aria-hidden="true"
          />
        </a>
        <nav class="v9-nav" aria-label="Primary">
          {/* v13: the header nav wears the routeline look — mono super index,
              matching the 01–04 strip on the front page (Marco 2026-07-18).
              Home is not a header link (Marco 2026-07-27) — the brand mark is
              the way home; the footer nav keeps the full list. */}
          {navLinks.filter((link) => link.href !== '/').map((link, i) => (
            <a
              class="v9-nav__link"
              href={link.href}
              aria-current={path.startsWith(link.href) ? 'page' : undefined}
            >
              <span class="v9-nav__index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {link.label}
            </a>
          ))}
          {/* v11: the mode switch lives here now, as a 17px icon. The floating
              "Display" pill is gone (Marco 2026-07-13; Hughes and Disney both
              read it, independently, as a dev artifact left in production). */}
          <ModeToggleIsland
            client:load
            darkLabel={chrome.themePremiere}
            lightLabel={chrome.themeMatinee}
          />
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="v9-footer">
      <div class="v9-col">
        {/* Footer brand (Marco 2026-07-27): same admin-driven marks as the nav,
            theme-swapped by the shared [data-mark-ink] rules, house-scale. */}
        <a class="v9-footer__brand" href="/" aria-label={NAP.name}>
          <img class="v9-footer__mark" data-mark-ink="light" src={markLight} alt="" aria-hidden="true" />
          <img class="v9-footer__mark" data-mark-ink="dark" src={markDark} alt="" aria-hidden="true" />
        </a>
        <nav class="v9-footer__nav" aria-label="Footer">
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        {chrome.colophon && <p class="v9-footer__colophon">{chrome.colophon}</p>}
        <p class="v9-footer__copy">{chrome.copyright}</p>
      </div>
    </footer>

    <ScrollTopIsland client:load label={chrome.topLabel} />

    {/* ── The signature cursor, plugged back in (v11, Marco 2026-07-13) ──────
        This was never "missing". Both halves shipped in v10 and neither ran:
        the dot's CSS sat in tokens.css and its GSAP driver sat in
        lib/motion/cursor.ts, and NOTHING imported lib/motion, so the whole tree
        was tree-shaken out of the bundle. v9 booted it from Layout.astro:192;
        v10 kept only this layout, which never did.

        Booting initCursor directly rather than bootMotion(): bootMotion also
        fires the old splash (superseded by LogoRevealIsland) and the per-theme
        motion modules (whose themes were deleted in v10). We want the cursor and
        nothing else. initCursor bails itself on coarse pointers and on
        prefers-reduced-motion, so touch and reduced-motion never even bind the
        listener. */}
    <script>
      import { gsap } from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'
      import { SplitText } from 'gsap/SplitText'
      import { initCursor } from '../lib/motion/cursor'

      initCursor({ gsap, ScrollTrigger, SplitText })
    </script>

    <script is:inline>
      /* v8 reveal-once-on-scroll, applied to the v9 folds. Progressive
         enhancement: without JS nothing is ever hidden (the .reveal class is
         only added here, and the hiding CSS is gated on html.js). */
      ;(function () {
        var els = document.querySelectorAll('main .v9-section, main .v9-photofold, main .v9-prophead')
        els.forEach(function (el, i) {
          el.classList.add('reveal')
          el.style.setProperty('--i', String(i % 3))
        })
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in') })
          return
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in')
                io.unobserve(e.target)
              }
            })
          },
          { rootMargin: '0px 0px -8% 0px' },
        )
        els.forEach(function (el) { io.observe(el) })
      })()
    </script>
  </body>
</html>
