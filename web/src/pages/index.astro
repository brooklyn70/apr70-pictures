---
/**
 * / — the zine front door (v4).
 *
 * DISPATCH-masthead identity front door: nameplate + identity strip +
 * numbered-issue convention + text-forward teaser stack (Troupe radio play
 * leads, divisions, the slate). Rendered through Layout.astro so the global
 * visitor-selected theme system (pre-paint stamp + ThemeControlIsland) applies.
 *
 * Content truth is the Payload Home global. Until its layout carries the v4
 * zine blocks (see cms/scripts/apply-v4-content.ts), the complete front door
 * is compiled in from the V4 copy bundle (web/src/content/v4.ts).
 */
import Layout from '../layouts/Layout.astro'
import BlockRenderer from '../components/blocks/BlockRenderer.astro'
import { fetchHomeGlobal } from '../lib/payload'
import { V4_FRONT_DOOR_BLOCKS } from '../content/v4'

const { home } = await fetchHomeGlobal()
const dbBlocks = home?.layout ?? []
const isV4 = dbBlocks.some(
  (b) => (b as { blockType?: string }).blockType === 'zineMasthead',
)
const blocks = isV4 ? dbBlocks : V4_FRONT_DOOR_BLOCKS
---

<Layout>
  <main>
    <BlockRenderer blocks={blocks} />
  </main>
</Layout>
